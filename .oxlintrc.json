{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		".agents/",
		"tools/platform-qualification/",
		"tools/routing-eval/tasks/",
		"tools/routing-eval/grader/",
		"**/*.gen.*",
		"**/xplat-typecheck/**",
		"packages/**/types/generated/**",
		"**/vendor/**",
		"packages/platform/src/types/macos*/**",
		"packages/macos-appkit/types/**"
	],
	"jsPlugins": [
		"./packages/lint/src/oxlint-plugin.ts"
	],
	"rules": {
		"curly": "error",
		"xplat/no-dom-globals": [
			"error",
			{
				"exclude": [
					"tools/web-verification/",
					"apps/harness/web/",
					"apps/docs/",
					"tools/macos-verification/",
					"packages/cli/test/fixtures/",
					"scripts/"
				]
			}
		],
		"xplat/no-web-only-api": [
			"error",
			{
				"exclude": [
					"tools/web-verification/",
					"apps/harness/web/",
					"apps/docs/"
				]
			}
		],
		"xplat/element-vocabulary": [
			"error",
			{
				"exclude": [
					"tools/web-verification/",
					"apps/harness/web/",
					"apps/docs/",
					"apps/harness/",
					"tools/windows-host/",
					"packages/typegen-fixture/"
				]
			}
		],
		"xplat/no-nativescript-import": [
			"error",
			{
				"exclude": [
					"apps/harness/",
					"packages/nativescript-octane/",
					"packages/vite-octane/",
					"tools/windows-host/",
					"tools/macos-verification/webview-proof-host.ts",
					"tools/macos-verification/webview-packaged-proof-host.ts",
					"tools/macos-verification/webview-camera-proof-host.ts",
					"packages/cli/test/fixtures/"
				]
			}
		],
		"xplat/no-ns-deep-import": [
			"error",
			{
				"exclude": [
					"tools/probe/mobile-host.mobile.ts"
				]
			}
		],
		"xplat/platform-subpath-import": "error",
		"xplat/no-native-dead-style": [
			"error",
			{
				"exclude": [
					"tools/web-verification/",
					"apps/harness/web/",
					"apps/docs/"
				]
			}
		],
		"xplat/no-line-height-unitless": "error",
		"xplat/no-style-string": "error",
		"xplat/no-unknown-class": [
			"warn",
			{
				"exclude": [
					"scripts/"
				],
				"allow": [
					"vx-chatdict-bar",
					"vx-chattools-status",
					"vx-field--status-detached",
					"vx-fieldstatus-icon",
					"vx-lightbox-image",
					"vx-link--external",
					"vx-meter",
					"vx-select-option",
					"vx-select-option--on",
					"vx-step-content",
					"vx-step-node",
					"vx-switch-row",
					"vx-tree-label"
				]
			}
		],
		"xplat/signal-dollar-suffix": "error",
		"xplat/require-signals-runtime": "warn",
		"xplat/no-view-onpress": "error",
		"xplat/no-console-debug": "error",
		"xplat/hooks-in-plain-ts": "warn",
		"xplat/native-pragma-first-line": "error",
		"xplat/no-root-logical-render": "error",
		"xplat/no-removed-routing-api": "error",
		"xplat/no-route-augmentation": "error",
		"xplat/no-destination-cast": "error",
		"xplat/no-interpolated-route-path": "error",
		"xplat/require-default-tsrx": [
			"error",
			{
				"exclude": [
					"apps/tweaks-playground/src/main.web.tsrx",
					"packages/devtools/src/desktop/Shell.macos.tsrx",
					"packages/devtools/src/panel/main.web.tsrx"
				]
			}
		]
	},
	"overrides": [
		{
			"files": ["packages/macos-appkit/platforms/nativescript/**/*.js"],
			"rules": {
				"xplat/no-nativescript-import": "off",
				"xplat/no-ns-deep-import": "off"
			}
		},
		{
			"files": [
				"tools/tailwind-qualification/fixtures/app/**"
			],
			"rules": {
				"xplat/no-unknown-class": [
					"warn",
					{
						"allow": [
							"flex"
						]
					}
				]
			}
		}
	]
}
