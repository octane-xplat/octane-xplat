diff --git a/runtime/src/intl_test.rs b/runtime/src/intl_test.rs
new file mode 100644
index 0000000..2f3316e
--- /dev/null
+++ b/runtime/src/intl_test.rs
@@ -0,0 +1,33 @@
+use crate::Runtime;
+
+#[test]
+fn intl_currency_and_dates_have_icu_data() {
+    let mut runtime = Runtime::new(".");
+    runtime.run_script(
+        r#"
+        const locales = ['en-US', 'de-DE', 'ja-JP', 'ar-EG'];
+        if (Intl.DateTimeFormat.supportedLocalesOf(locales).length !== locales.length) throw new Error('Missing locale data');
+        if (!new Intl.DateTimeFormat('en-US').format(new Date('2024-01-02T03:04:05Z'))) throw new Error('Missing default-zone date');
+        for (const locale of locales) {
+            const number = new Intl.NumberFormat(locale, {style: 'currency', currency: 'USD'}).format(1234.5);
+            if (!number || !/[0-9\u0660-\u0669]/.test(number)) throw new Error('Missing currency: ' + locale);
+            for (const timeZone of ['UTC', 'America/New_York', 'Asia/Tokyo']) {
+                const formatter = new Intl.DateTimeFormat(locale, {timeZone, year: 'numeric', month: 'long', day: 'numeric'});
+                const formatted = formatter.format(new Date('2024-01-02T03:04:05Z'));
+                if (!formatted || formatter.resolvedOptions().timeZone !== timeZone) throw new Error('Missing date: ' + locale + '/' + timeZone);
+            }
+        }
+        for (const [timeZone, day, hour] of [['UTC', '2', '03'], ['America/New_York', '1', '22'], ['Asia/Tokyo', '2', '12']]) {
+            const parts = new Intl.DateTimeFormat('en-US', {timeZone, day: 'numeric', hour: '2-digit', hourCycle: 'h23'}).formatToParts(new Date('2024-01-02T03:04:05Z'));
+            const part = type => parts.find(p => p.type === type)?.value;
+            if (part('day') !== day || part('hour') !== hour) throw new Error('Wrong zoned date: ' + timeZone);
+        }
+        if (new Intl.NumberFormat('en-US', {style: 'currency', currency: 'USD'}).format(1234.5) !== '$1,234.50') throw new Error('Unexpected USD');
+        if (new Intl.DateTimeFormat('en-US', {timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric'}).format(new Date('2024-01-02T03:04:05Z')) !== 'January 2, 2024') throw new Error('Unexpected UTC date');
+        "#,
+        "intl_icu_test.js",
+    );
+    if let Some(error) = crate::get_last_js_error() {
+        panic!("Intl formatting failed: {}", error);
+    }
+}
