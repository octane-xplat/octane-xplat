From 8c9860873530c985711c4ba79402da60eec60382 Mon Sep 17 00:00:00 2001
From: Alec Larson <1925840+aleclarson@users.noreply.github.com>
Date: Fri, 23 Oct 2026 16:26:24 -0400
Subject: [PATCH] fix(windows): break import cycle between view and animation
 modules
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

view-common imports Animation from ui/animation, whose Windows index
imported _ensureNativeTransforms back from the platform view barrel.
When the bundler flattened both modules into one chunk it evaluated the
platform View class body — [originXProperty.setNative] and friends —
before view-common's property declarations ran, so the app crashed at
startup with 'Cannot read properties of undefined (reading setNative)'.

Move _ensureNativeTransforms into a leaf module (native-transforms)
imported by both files; it only touches WinRT types, so the edge from
animation back into the view module disappears. The public re-export
from ui/core/view is preserved.
---
 packages/core/ui/animation/index.windows.ts   |  2 +-
 packages/core/ui/core/view/index.windows.ts   | 22 ++-----------------
 .../ui/core/view/native-transforms.windows.ts | 19 ++++++++++++++++
 3 files changed, 22 insertions(+), 21 deletions(-)
 create mode 100644 packages/core/ui/core/view/native-transforms.windows.ts

diff --git a/packages/core/ui/animation/index.windows.ts b/packages/core/ui/animation/index.windows.ts
index 3fe113709..cc8572111 100644
--- a/packages/core/ui/animation/index.windows.ts
+++ b/packages/core/ui/animation/index.windows.ts
@@ -9,7 +9,7 @@ export function _resolveAnimationCurve(curve: any): any {
 import { AnimationBase, Properties } from './animation-common';
 import type { View } from '../core/view';
 //@ts-ignore
-import { _ensureNativeTransforms } from '../core/view/index';
+import { _ensureNativeTransforms } from '../core/view/native-transforms.windows';
 
 function _applyFinalValue(target: any, property: string, to: any): void {
 	try {
diff --git a/packages/core/ui/core/view/index.windows.ts b/packages/core/ui/core/view/index.windows.ts
index cec7f42f0..cdd915af3 100644
--- a/packages/core/ui/core/view/index.windows.ts
+++ b/packages/core/ui/core/view/index.windows.ts
@@ -1,6 +1,7 @@
 export * from './view-common';
 export * from './view-helper';
 export * from '../properties';
+export { _ensureNativeTransforms } from './native-transforms.windows';
 
 import { ViewCommon, originXProperty, originYProperty } from './view-common';
 import type { CoreTypes } from '../../../core-types';
@@ -18,6 +19,7 @@ import { getClientOriginOnScreen, getCurrentWindowBounds, getCurrentWindowConten
 import { ImageSource } from '../../../image-source';
 import { ClipPathFunction } from '../../styling/clip-path-function';
 import { nativeChildIndex, removeNativeChild } from './native-children.windows';
+import { _ensureNativeTransforms } from './native-transforms.windows';
 type WindowsColor = Color & { windows: Windows.UI.Color, windowsArgb: number };
 
 // Windows.UI.Color is a plain {A,R,G,B} struct. Bridge reads fields directly, no WinRT call needed.
@@ -91,26 +93,6 @@ function _resolveToWinColor(color: any): Windows.UI.Color | null {
 }
 
 
-export function _ensureNativeTransforms(native: any): { scale: any; rotate: any; translate: any } | null {
-	try {
-		if (native.__ns_transforms) return native.__ns_transforms;
-
-		const tg = new Microsoft.UI.Xaml.Media.TransformGroup();
-		const scale = new Microsoft.UI.Xaml.Media.ScaleTransform();
-		const rotate = new Microsoft.UI.Xaml.Media.RotateTransform();
-		const translate = new Microsoft.UI.Xaml.Media.TranslateTransform();
-		tg.Children.Append(scale);
-		tg.Children.Append(rotate);
-		tg.Children.Append(translate);
-		native.RenderTransform = tg;
-		const result = { scale, rotate, translate };
-		native.__ns_transforms = result;
-		return result;
-	} catch (_e) {
-		return null;
-	}
-}
-
 const hidden = Symbol('[[hidden]]');
 function setVisibility(nativeView: Microsoft.UI.Xaml.UIElement & { [hidden]?: boolean }, value: CoreTypes.VisibilityType) {
 	switch (value) {
diff --git a/packages/core/ui/core/view/native-transforms.windows.ts b/packages/core/ui/core/view/native-transforms.windows.ts
new file mode 100644
index 000000000..f1f68ee12
--- /dev/null
+++ b/packages/core/ui/core/view/native-transforms.windows.ts
@@ -0,0 +1,19 @@
+export function _ensureNativeTransforms(native: any): { scale: any; rotate: any; translate: any } | null {
+	try {
+		if (native.__ns_transforms) return native.__ns_transforms;
+
+		const tg = new Microsoft.UI.Xaml.Media.TransformGroup();
+		const scale = new Microsoft.UI.Xaml.Media.ScaleTransform();
+		const rotate = new Microsoft.UI.Xaml.Media.RotateTransform();
+		const translate = new Microsoft.UI.Xaml.Media.TranslateTransform();
+		tg.Children.Append(scale);
+		tg.Children.Append(rotate);
+		tg.Children.Append(translate);
+		native.RenderTransform = tg;
+		const result = { scale, rotate, translate };
+		native.__ns_transforms = result;
+		return result;
+	} catch (_e) {
+		return null;
+	}
+}
