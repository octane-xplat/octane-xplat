index 00000000..76cd963d
--- /dev/null
+++ b/packages/core/ui/core/properties/property-literal-values.spec.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from 'vitest';
+import { CoercibleProperty, CssProperty, InheritedProperty, Property, unsetValue } from '.';
+import { View } from '../view';
+import { Style } from '../../styling/style';
+
+describe('property literal values', () => {
+	for (const Type of [Property, CoercibleProperty, InheritedProperty]) {
+		it(`${Type.name} preserves CSS keyword strings`, () => {
+			class TestView extends View {}
+			const property = new Type({ name: 'literal', defaultValue: 'default', coerceValue: (_view, value) => value });
+			property.register(TestView);
+			const view = new TestView();
+			for (const value of ['initial', 'inherit', 'unset', 'revert']) {
+				property.set.call(view, value);
+				expect(property.get.call(view)).toBe(value);
+			}
+			property.set.call(view, unsetValue);
+			expect(property.get.call(view)).toBe('default');
+		});
+	}
+	it('CSS keywords continue to reset style values', () => {
+		class TestStyle extends Style {}
+		const property = new CssProperty({ name: 'literalStyle', cssName: 'literal-style', defaultValue: 'default' });
+		property.register(TestStyle);
+		const style = new TestStyle(new View());
+		for (const value of ['initial', 'inherit', 'unset', 'revert']) {
+			style['literalStyle'] = 'local';
+			style['literalStyle'] = value;
+			expect(style['literalStyle']).toBe('default');
+		}
+	});
+});
