+const asymmetricPaddingActivity = (heightAttribute: string, child: string) =>
+	getViews(`<StackLayout><FlexboxLayout id="flexbox" iosOverflowSafeArea="false" width="200" ${heightAttribute}
+		flexDirection="column" paddingLeft="17" paddingTop="7" paddingRight="13" paddingBottom="11">
+		${child}
+	</FlexboxLayout></StackLayout>`);
+
+export const test_asymmetricPadding_fixedContentBox = test(
+	() => asymmetricPaddingActivity('height="60"', '<Label id="text1" text="child" height="10" />'),
+	noop,
+	({ flexbox, text1 }) => {
+		closeEnough(width(text1), dipToDp(170));
+		closeEnough(left(text1) - left(flexbox), dipToDp(17));
+		closeEnough(top(text1) - top(flexbox), dipToDp(7));
+	},
+);
+
+export const test_asymmetricPadding_autoHeight = test(
+	() => asymmetricPaddingActivity('', '<Label id="text1" text="child" height="10" />'),
+	noop,
+	({ flexbox }) => closeEnough(height(flexbox), dipToDp(28)),
+);
+
+export const test_asymmetricPadding_emptyAutoHeight = test(
+	() => asymmetricPaddingActivity('', ''),
+	noop,
+	({ flexbox }) => closeEnough(height(flexbox), dipToDp(18)),
+);
