{
	"name": "@xplat/macos",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"xplat": "xplat",
		"dev": "xplat dev macos",
		"build": "vite build",
		"test:text-controls": "node test/verify-text-controls.mjs",
		"test:fonts": "node test/verify-fonts.mjs",
		"test:overlays": "node test/verify-overlays.mjs",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.json",
		"parity": "node ./scripts/parity.ts",
		"bench:virtual-list": "node ./scripts/bench-virtual-list.ts",
		"bench:virtual-list-scroll": "node ./scripts/bench-virtual-list-scroll.ts",
		"package": "xplat build --targets macos",
		"webview:proof": "node ./scripts/webview-proof.ts --verify",
		"webview:dev": "node ./scripts/webview-dev.ts",
		"test:announce": "node test/verify-announce.mjs",
		"smoke": "node scripts/smoke.ts",
		"verify-hmr": "node scripts/verify-hmr.ts",
		"test:animation": "node test/verify-animation.mjs",
		"test:layout-channels": "node test/verify-layout-channels.mjs",
		"test:layout-placement": "node test/verify-layout-placement.mjs",
		"test:camera-webview": "node ./scripts/camera-webview-proof.ts --verify",
		"test:routing": "node test/verify-routing.mjs",
		"test:shortcuts-runtime": "node test/verify-shortcuts.mjs"
	},
	"dependencies": {
		"@nativescript/macos-node-api": "catalog:",
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/camera": "workspace:*",
		"@octane-xplat/desktop-webview": "workspace:*",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octane-xplat/web-browser": "workspace:*",
		"@xplat/app": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"xplat": {
		"targets": {
			"macos": {
				"runtime": "appkit-node-api",
				"dev": {
					"viteConfig": "vite.dev.config.mjs",
					"bundleFile": "dist/dev/app.cjs",
					"shellViteConfig": "vite.dev-shell.config.mjs",
					"shellBundleFile": "dist/dev/shell.cjs",
					"webViteConfig": "vite.webview-app.config.mjs",
					"hostViteConfig": "vite.webview-app-host.config.mjs",
					"hostBundleFile": "dist/webview-app-host/host.cjs"
				},
				"package": {
					"productName": "Octane macOS spike",
					"bundleIdentifier": "org.octane.xplat.macos-spike",
					"executableName": "Octane",
					"version": "0.1.0",
					"minimumSystemVersion": "13.5",
					"viteConfig": "vite.package.config.mjs",
					"bundleFile": "dist/package-build/main.cjs",
					"webViteConfig": "vite.webview-app.config.mjs",
					"hostViteConfig": "vite.webview-app-host.config.mjs",
					"hostBundleFile": "dist/webview-app-host/host.cjs",
					"webOutDir": "dist/webview-app",
					"entitlements": "entitlements.plist",
					"infoPlist": {
						"NSCameraUsageDescription": "This app records video with the camera.",
						"NSMicrophoneUsageDescription": "This app records audio with your video."
					}
				}
			}
		}
	}
}
