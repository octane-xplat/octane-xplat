{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"outputs": []
		},
		"webview:proof": {
			"dependsOn": ["^typegen", "^build"],
			"cache": false
		},
		"test:shortcuts-runtime": {
			"dependsOn": ["@octane-xplat/shortcuts#build"],
			"cache": false,
			"env": ["SHORTCUTS_MACOS_HOST"]
		},
		"test:text-controls": {
			"dependsOn": ["^typegen", "^build", "@xplat/app#gen"],
			"cache": false
		},
		"test:camera-webview": {
			"dependsOn": ["^typegen", "^build"],
			"cache": false
		},
		"smoke": {
			"dependsOn": ["^typegen", "^build", "@xplat/app#gen"],
			"passThroughEnv": [
				"XPLAT_MACOS_SMOKE_TIMEOUT_MS",
				"XPLAT_MACOS_SDK",
				"XPLAT_MACOS_SWIFTC"
			],
			"cache": false
		},
		"verify-hmr": {
			"dependsOn": [
				"^typegen",
				"^build",
				"@octane-xplat/lexical#build:assets",
				"@octane-xplat/richtext#build:assets",
				"@octane-xplat/tiptap#build:assets",
				"@xplat/app#gen"
			],
			"cache": false
		},
		"package": {
			"dependsOn": ["build", "@octane-xplat/cli#build"],
			"cache": false
		},
		"build": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../tsrx-typegen/src/**",
				"../../scripts/check-native-dist.mjs",
				"../../scripts/sync-ui-barrels.ts"
			],
			"outputs": ["dist/**", "types/**"]
		}
	}
}
