{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "octane",
		"moduleSuffixes": [".web", ""],
		"customConditions": ["web"],
		"types": ["vite/client"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"@octane-xplat/ui": ["../../packages/ui/src/index.web.ts"],
			"@octane-xplat/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "**/*.test.*"]
}
