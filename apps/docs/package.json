{
	"name": "@xplat/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run turbo run api --filter=@xplat/docs && bun run gen && vite",
		"build": "bun run gen && vite build && vite build --config vite.demo.config.ts && node scripts/build-llms.ts",
		"typecheck": "bun run gen && tsrx-tsc --noEmit",
		"test": "node --test *.test.mjs",
		"deploy": "wrangler pages deploy dist --project-name octane-xplat-docs --branch=main",
		"smoke": "bun run build && node smoke.mjs",
		"smoke:keys": "NODE_ENV=development bun run smoke",
		"test:demos": "node demos.browser.mjs",
		"test:responsive": "node responsive.browser.mjs",
		"gen": "xplat routes",
		"api": "node scripts/build-api.mjs"
	},
	"dependencies": {
		"@octane-xplat/intersection-observer": "workspace:*",
		"@octane-xplat/motion": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "catalog:",
		"shiki": "4.5.0"
	},
	"devDependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"exports-md": "0.2.20",
		"jsdom": "catalog:",
		"playwright": "1.63.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "^4.0.0"
	}
}
