<Project>
  <PropertyGroup>
    <AppDisplayName>Octane xplat</AppDisplayName>
    <AppDescription>Built with NativeScript on Windows.</AppDescription>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == '' and Exists('$(MSBuildThisFileDirectory)app.manifest')">$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- alpha.144 copies these files after Build or only during Publish, too
       late for the MSIX payload. Declare them before package output discovery. -->
  <ItemGroup>
    <Content Include="$(NSWindowsRoot)\dotnet-bridge\publish\**\*"
             Exclude="$(NSWindowsRoot)\dotnet-bridge\publish\.*"
             Condition="Exists('$(NSWindowsRoot)\dotnet-bridge\publish')">
      <Link>dotnet-bridge\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)\plugins\@octane-xplat\nativescript-masonkit\$(NSLibPlatform)\NativeScript.Mason.dll;$(MSBuildProjectDirectory)\plugins\@octane-xplat\nativescript-masonkit\$(NSLibPlatform)\NativeScript.Mason.winmd">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!-- App-local x64 repair: stage the verified pair before MSIX discovery and
       restore it after the core plugin's post-Build copy. Other architectures
       retain their upstream artifacts and remain unqualified. -->
  <ItemGroup>
    <Content Remove="App_Resources\Windows\Widgets\**\*" />
    <Content Include="$(MSBuildThisFileDirectory)Widgets\LICENSE">
      <Link>NativeScript.Widgets.LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)Widgets\x64\NativeScript.Widgets.dll;$(MSBuildThisFileDirectory)Widgets\x64\NativeScript.Widgets.winmd"
             Condition="'$(NSLibPlatform)' == 'x64'">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)\plugins\@nativescript\core\$(NSLibPlatform)\NativeScript.Widgets.dll;$(MSBuildProjectDirectory)\plugins\@nativescript\core\$(NSLibPlatform)\NativeScript.Widgets.winmd"
             Condition="'$(NSLibPlatform)' != 'x64'">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="XplatVerifyPaddedWidgets" BeforeTargets="BeforeBuild"
          Condition="'$(NSLibPlatform)' == 'x64'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Widgets\verify.ps1&quot; -UpstreamDirectory &quot;$(MSBuildProjectDirectory)\plugins\@nativescript\core\x64&quot;" />
  </Target>
  <Target Name="XplatCopyPaddedWidgets" AfterTargets="CopyNativeScriptWidgets"
          DependsOnTargets="XplatVerifyPaddedWidgets" Condition="'$(NSLibPlatform)' == 'x64'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Widgets\x64\NativeScript.Widgets.dll;$(MSBuildThisFileDirectory)Widgets\x64\NativeScript.Widgets.winmd"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Plugins update Package.appxmanifest after the generated manifest was
       read. Carry their registrations into the manifest actually packaged. -->
  <Target Name="XplatPackageNativeRegistrations" AfterTargets="_GenerateAppxManifest"
          DependsOnTargets="NSRegisterWidgetsActivatableClasses;NSRegisterMasonActivatableClasses;NSRegisterFontManagerActivatableClasses">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\App_Resources\Windows\merge-native-registrations.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\Package.appxmanifest&quot; -Destination &quot;@(FinalAppxManifest)&quot;" />
  </Target>
</Project>
