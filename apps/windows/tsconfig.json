{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@nativescript-community/octane",
		"moduleSuffixes": [".windows", ""],
		"customConditions": ["native"],
		"lib": ["ESNext"],
		"paths": {
			"@nativescript/core": ["./node_modules/@nativescript/core"],
			"@nativescript/core/*": ["./node_modules/@nativescript/core/*"],
			"@xplat/app": ["../../packages/app/src/index.ts"],
			"@xplat/app/*": ["../../packages/app/src/*"],
			"@xplat/demos": ["../../packages/demos/src/index.ts"],
			"@xplat/demos/*": ["../../packages/demos/src/*"],
			"@octane-xplat/audio": ["../../packages/audio/src/index.ts"],
			"@octane-xplat/audio/*": ["../../packages/audio/src/*"],
			"@octane-xplat/haptics": ["../../packages/haptics/src/index.ts"],
			"@octane-xplat/haptics/*": ["../../packages/haptics/src/*"],
			"@octane-xplat/sounds": ["../../packages/sounds/src/index.ts"],
			"@octane-xplat/sounds/*": ["../../packages/sounds/src/*"],
			"@octane-xplat/platform": ["../../packages/platform/src/index.ts"],
			"@octane-xplat/platform/*": ["../../packages/platform/src/*"],
			"@octane-xplat/camera": ["../../packages/camera/src/index.ts"],
			"@octane-xplat/camera/*": ["../../packages/camera/src/*"],
			"@octane-xplat/canvas": ["../../packages/canvas/src/index.ts"],
			"@octane-xplat/canvas/*": ["../../packages/canvas/src/*"],
			"@octane-xplat/effects": ["../../packages/effects/src"],
			"@octane-xplat/effects/*": ["../../packages/effects/src/*"],
			"@octane-xplat/gif": ["../../packages/gif/src/index.ts"],
			"@octane-xplat/gif/*": ["../../packages/gif/src/*"],
			"@octane-xplat/pager": ["../../packages/pager/src/index.ts"],
			"@octane-xplat/pager/*": ["../../packages/pager/src/*"],
			"@octane-xplat/video": ["../../packages/video/src/index.ts"],
			"@octane-xplat/video/*": ["../../packages/video/src/*"],
			"@octane-xplat/ui": ["../../packages/ui/src/index.ts"],
			"@octane-xplat/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src/**/*", "../../packages/**/*"],
	"files": ["./references.d.ts", "./types/globals.d.ts"],
	"exclude": [
		"node_modules",
		"platforms",
		"**/*.web.*",
		"../../packages/**/*.web.*",
		"../../packages/ui/src/web/**/*",
		"**/*.ios.*",
		"../../packages/**/*.ios.*",
		"**/*.android.*",
		"../../packages/**/*.android.*",
		"**/*.mobile.*",
		"../../packages/**/*.mobile.*",
		"../../packages/ui/src/ios/**/*",
		"../../packages/ui/src/android/**/*",
		"**/*.macos.*",
		"../../packages/**/*.macos.*",
		"**/*.linux.*",
		"../../packages/**/*.linux.*",
		"**/*.test.*",
		"../../packages/**/*.test.*",
		"../../packages/*/src/vendor",
		"../../packages/create/template",
		"../../packages/lingui/tests",
		"../../packages/macos-renderer"
	]
}
