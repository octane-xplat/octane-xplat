{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"test:filesystem": {
			"dependsOn": [],
			"env": ["WINDOWS_CORE_ARTIFACT"],
			"cache": false
		},
		"test:keyboard": {
			"dependsOn": [],
			"env": ["WINDOWS_CORE_ARTIFACT"],
			"cache": false
		},
		"build:windows": {
			"dependsOn": ["^typegen", "@octane-xplat/cli#build", "@xplat/app#gen"],
			// NativeScript's startup checks read the Windows shared-program paths.
			// PROCESSOR_ARCHITECTURE selects the Microsoft.Windows.SDK.BuildTools
			// arch folder — without it the x86 MrmSupport.dll is loaded into an
			// x64 MSBuild process and packaging fails (error 193).
			"passThroughEnv": [
				"CommonProgramFiles",
				"CommonProgramFiles(x86)",
				"ProgramFiles",
				"ProgramFiles(x86)",
				"LOCALAPPDATA",
				"NODE_OPTIONS",
				"PROCESSOR_ARCHITECTURE"
			],
			"cache": false
		},
		// Same whole-repo `include` as the mobile program — hash all package
		// sources, not just declared dependencies.
		"typecheck": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"passThroughEnv": ["NODE_OPTIONS"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../packages/**/*.ts",
				"../../packages/**/*.tsx",
				"../../packages/**/*.tsrx",
				"../../packages/**/*.mts",
				"../../packages/**/*.cts",
				"../../packages/*/package.json",
				"../../packages/*/tsconfig*.json",
				"../../packages/*/tsrx-typegen.json",
				"!../../packages/**/node_modules/**",
				"!../../packages/**/.turbo/**"
			],
			"outputs": []
		}
	}
}
