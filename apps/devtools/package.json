{
	"name": "@octane-xplat/devtools-desktop",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"xplat": "xplat",
		"dev": "xplat dev macos",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json",
		"build:release": "node build-release.mjs"
	},
	"dependencies": {
		"@nativescript/macos-node-api": "catalog:",
		"@octane-xplat/devtools": "workspace:*",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/tweaks": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/macos-build": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"xplat": {
		"targets": {
			"macos": {
				"runtime": "appkit-node-api",
				"dev": {
					"viteConfig": "vite.dev.config.mjs",
					"bundleFile": "dist/dev/app.cjs"
				},
				"package": {
					"productName": "Octane Xplat DevTools",
					"bundleIdentifier": "org.octane-xplat.devtools",
					"executableName": "XplatDevTools",
					"version": "1.0.0",
					"minimumSystemVersion": "13.5",
					"viteConfig": "vite.release.config.mjs",
					"bundleFile": "dist/package-build/main.cjs"
				}
			}
		}
	}
}
