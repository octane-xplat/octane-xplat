// You can add custom settings here
// for example you can uncomment the following line to force distribution code signing
// CODE_SIGN_IDENTITY = iPhone Distribution 
// To build for device with XCode you need to specify your development team.
// DEVELOPMENT_TEAM = YOUR_TEAM_ID;
// NativeScript's bundled clang-17 metadata generator can't satisfy
// `requires found_incompatible_headers__check_search_paths` in
// iPhoneSimulator27.0.sdk's DarwinFoundation1.modulemap — it exits 0 while
// dropping Foundation/UIKit/WebKit entirely. Claiming the module feature
// lets those modules build; the -D define closes the rsize_t dead-end in
// _DarwinFoundation2 (Annex K decls drop from metadata — nothing needs
// them). Evidence: docs/notes/evidence/ios-editor-backing/results.md.
OTHER_CFLAGS = $(inherited) -Xclang -fmodule-feature -Xclang found_incompatible_headers__check_search_paths -D__STDC_WANT_LIB_EXT1__=0
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;
IPHONEOS_DEPLOYMENT_TARGET = 17.0;
MTL_COMPILER_FLAGS = -std=ios-metal2.4;
MTLLINKER_FLAGS = -std=ios-metal2.4;
