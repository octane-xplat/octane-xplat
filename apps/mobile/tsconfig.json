{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "octane",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"paths": {
			"styled-system/*": [
				"../../packages/app/src/styled-system/*"
			],
			"@xplat/app": [
				"../../packages/app/src/index.ts"
			],
			"@xplat/app/*": [
				"../../packages/app/src/*"
			],
			"@xplat/demos": [
				"../../packages/demos/src/index.ts"
			],
			"@xplat/demos/*": [
				"../../packages/demos/src/*"
			],
			"@octane-xplat/audio": [
				"../../packages/audio/src/index.ts"
			],
			"@octane-xplat/audio/*": [
				"../../packages/audio/src/*"
			],
			"@octane-xplat/haptics": [
				"../../packages/haptics/src/index.ts"
			],
			"@octane-xplat/haptics/*": [
				"../../packages/haptics/src/*"
			],
			"@octane-xplat/sounds": [
				"../../packages/sounds/src/index.ts"
			],
			"@octane-xplat/sounds/*": [
				"../../packages/sounds/src/*"
			],
			"@octane-xplat/platform": [
				"../../packages/platform/src/index.ts"
			],
			"@octane-xplat/platform/*": [
				"../../packages/platform/src/*"
			],
			"@octane-xplat/canvas": [
				"../../packages/canvas/src/index.ts"
			],
			"@octane-xplat/canvas/*": [
				"../../packages/canvas/src/*"
			],
			"@octane-xplat/effects": [
				"../../packages/effects/src"
			],
			"@octane-xplat/effects/*": [
				"../../packages/effects/src/*"
			],
			"@octane-xplat/gif": [
				"../../packages/gif/src/index.ts"
			],
			"@octane-xplat/gif/*": [
				"../../packages/gif/src/*"
			],
			"@octane-xplat/image": [
				"../../packages/image/src/index.ts"
			],
			"@octane-xplat/image/*": [
				"../../packages/image/src/*"
			],
			"@octane-xplat/ui": [
				"../../packages/ui/src/index.ts"
			],
			"@octane-xplat/ui/*": [
				"../../packages/ui/src/*"
			]
		}
	},
	"include": [
		"src/**/*",
		"../../packages/**/*"
	],
	"files": [
		"../../packages/macos-renderer/src/appkit.d.ts",
		"./references.d.ts",
		"./types/globals.d.ts"
	],
	"exclude": [
		"node_modules",
		"platforms",
		"**/*.test.*",
		"../../packages/**/*.test.*",
		"../../packages/*/src/vendor",
		"../../packages/create/template",
		"../../packages/lingui/tests",
		"../../packages/*/test",
		"../../packages/*/tests",
		"../../packages/*/vitest.*.config.*",
		"../../packages/*/dist",
		"../../packages/*/types",
		"../../packages/*/src/build"
	]
}
