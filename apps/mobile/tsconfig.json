	"include": [
		"src/**/*",
		"../../packages/*/src/**/*.d.ts",
		"../../packages/ui/type-support/**/*.d.ts"
	],
	"files": [
		"../../packages/macos-appkit/src/host-globals.d.ts",
		"../../packages/linux-gtk-renderer/src/gi.d.ts",
		"./references.d.ts",
		"./types/globals.d.ts"
	],
	"exclude": [
		"node_modules",
		"platforms",
		"src/navigation-*.ts",
		"src/navigation-*.tsrx",
		"**/*.test.*",
		"../../packages/**/*.test.*",
		"../../packages/*/src/vendor",
		"../../packages/create/template",
		"../../packages/create/library-template",
		"../../packages/lingui/tests",
		"../../packages/*/test",
		"../../packages/*/tests",
		"../../packages/*/e2e/*.mts",
		"../../packages/*/vitest.*.config.*",
		"../../packages/*/dist",
		"../../packages/*/types",
		"../../packages/*/src/build",
		"../../packages/icons/src/mapper",
		"../../packages/mcp",
		"../../packages/cli",
		"../../packages/fingerprint",
		"../../packages/lint",
		"../../packages/create",
		"../../packages/tsrx-typegen",
		"../../packages/*/scripts",
		"../../packages/richtext/build-browser.ts"
	]
