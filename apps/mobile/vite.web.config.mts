import { defineConfig } from 'vite'
import { octane } from '@octanejs/vite-plugin'
import { css, boundary, devBridge, nodeEnvDefine } from '@octane-xplat/cli/vite'
import { bamboo } from '@octane-xplat/bamboo/vite'
import { fileURLToPath } from 'node:url'

const bambooRoot = fileURLToPath(new URL('../../packages/app/', import.meta.url))

export default defineConfig(({ mode }) => ({
  // Vite 8's oxc transform resolves each file's governing tsconfig.json and
  // follows its project references — the app composes package sources whose
  // references point at env programs generated by `xplat typecheck`. Pin the
  // transform to this app's committed tsconfig so a fresh checkout builds.
  tsconfig: new URL('./tsconfig.web.json', import.meta.url).pathname,
  root: fileURLToPath(new URL('./web/', import.meta.url)),
  build: { outDir: fileURLToPath(new URL('./dist/', import.meta.url)), emptyOutDir: true },
  plugins: [
    css('web'),
    ...octane(),
    bamboo({ cwd: bambooRoot, configPath: `${bambooRoot}bamboo.config.ts` }),
    boundary('web'),
    // Vite serves web/ while the selected app owns the development session.
    devBridge({ appRoot: fileURLToPath(new URL('./', import.meta.url)) }),
  ],
  define: nodeEnvDefine(mode),
  // The native dev server prefers 5173 and auto-bumps on collision; the
  // device discovers the actual port from synced app metadata, so only the
  // web port needs pinning to keep the topology deterministic.
  server: { port: 5200 },
  resolve: {
    // The pinned tsconfig suppresses rolldown's tsconfigFilename discovery,
    // so opt back into paths resolution for the styled-system mapping.
    tsconfigPaths: true,
    conditions: ['web'],
    // Suffix chain (first match wins): .web → shared → fallback.
    extensions: [
      '.web.tsrx',
      '.tsrx',
      '.web.tsx',
      '.tsx',
      '.web.ts',
      '.mjs',
      '.mts',
      '.ts',
      '.jsx',
      '.js',
      '.json',
    ],
  },
}))
