{
	"name": "@xplat/mobile",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"scripts": {
		"ios": "pnpm -w gen:app && xplat dev ios",
		"android": "pnpm -w gen:app && xplat dev android",
		"debug:ios": "pnpm -w gen:app && ns debug ios",
		"build:ios": "pnpm -w gen:app && ns build ios",
		"bench:vlist:ios": "pnpm -w gen:app && node scripts/bench-virtual-list.ts ios",
		"bench:vlist:android": "pnpm -w gen:app && node scripts/bench-virtual-list.ts android",
		"test:ios": "ns test ios",
		"test:android": "ns test android",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.json",
		"demos:ios": "XPLAT_DOCS_DEMOS=1 ns run ios --no-hmr",
		"demos:android": "XPLAT_DOCS_DEMOS=1 ns run android --no-hmr",
		"demos:build:ios": "XPLAT_DOCS_DEMOS=1 ns build ios"
	},
