{
	"name": "@xplat/mobile",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"scripts": {
		"ios": "node ../../scripts/watch-types.mjs -- pnpm ios:app",
		"android": "node ../../scripts/watch-types.mjs -- pnpm android:app",
		"debug:ios": "node ../../scripts/watch-types.mjs -- pnpm debug:ios:app",
		"build:ios": "pnpm --filter @xplat/app gen && ns build ios",
		"bench:vlist:ios": "pnpm --filter @xplat/app gen && node scripts/bench-virtual-list.mjs ios",
		"bench:vlist:android": "pnpm --filter @xplat/app gen && node scripts/bench-virtual-list.mjs android",
		"ios:app": "pnpm --filter @xplat/app gen && ns run ios",
		"android:app": "pnpm --filter @xplat/app gen && ns run android",
		"debug:ios:app": "pnpm --filter @xplat/app gen && ns debug ios",
		"test:ios": "ns test ios",
		"test:android": "ns test android",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.json",
		"demos:ios": "XPLAT_DOCS_DEMOS=1 ns run ios --no-hmr",
		"demos:android": "XPLAT_DOCS_DEMOS=1 ns run android --no-hmr",
		"demos:build:ios": "XPLAT_DOCS_DEMOS=1 ns build ios"
	},
	"dependencies": {
		"@nativescript-community/gesturehandler": "2.0.45",
		"@nativescript-community/observable": "2.0.11",
		"@nativescript-community/octane": "0.2.4",
		"@nativescript-community/perms": "3.0.11",
		"@nativescript-community/ui-drawer": "0.1.32",
		"@nativescript/canvas": "3.0.0-alpha.15",
		"@nativescript/core": "9.1.3",
		"@nativescript/font-manager": "1.0.18",
		"@octane-xplat/auth": "workspace:*",
		"@octane-xplat/biometrics": "workspace:*",
		"@octane-xplat/camera": "workspace:*",
		"@octane-xplat/canvas": "workspace:*",
		"@octane-xplat/context-menu": "workspace:*",
		"@octane-xplat/date-picker": "workspace:*",
		"@octane-xplat/effects": "workspace:*",
		"@octane-xplat/files": "workspace:*",
		"@octane-xplat/geolocation": "workspace:*",
		"@octane-xplat/gif": "workspace:*",
		"@octane-xplat/image": "workspace:*",
		"@octane-xplat/lottie": "workspace:*",
		"@octane-xplat/media": "workspace:*",
		"@octane-xplat/notifications": "workspace:*",
		"@octane-xplat/pager": "workspace:*",
		"@octane-xplat/picker": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/push": "workspace:*",
		"@octane-xplat/richtext": "workspace:*",
		"@octane-xplat/secure-storage": "workspace:*",
		"@octane-xplat/share": "workspace:*",
		"@octane-xplat/sheet": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octane-xplat/video": "workspace:*",
		"@valor/nativescript-websockets": "2.0.3",
		"@xplat/app": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "0.11.0"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/plugin-transform-unicode-property-regex": "7.29.7",
		"@nativescript-community/vite-octane": "0.2.1",
		"@nativescript/android": "9.1.1",
		"@nativescript/ios": "9.1.0",
		"@nativescript/types": "9.1.4",
		"@nativescript/unit-test-runner": "5.0.0",
		"@nativescript/vite": "8.0.17",
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"nativescript": "9.1.1",
		"storybook": "10.6.1",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "4.1.11"
	}
}
