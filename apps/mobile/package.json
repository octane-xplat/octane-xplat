{
	"name": "@octane-xplat/mobile",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"scripts": {
		"web": "bun run --cwd ../.. turbo run gen --filter=@octane-xplat/app && xplat dev web",
		"build:web": "vite build",
		"ios": "bun run --cwd ../.. turbo run gen --filter=@octane-xplat/app && xplat dev ios",
		"android": "bun run --cwd ../.. turbo run gen --filter=@octane-xplat/app && xplat dev android",
		"windows": "bun run --cwd ../.. turbo run gen --filter=@octane-xplat/app && xplat dev windows --app .",
		"build:windows": "xplat build --targets windows",
		"debug:ios": "bun run --cwd ../.. turbo run gen --filter=@octane-xplat/app && ns debug ios",
		"build:ios": "ns build ios",
		"build:android": "ns build android",
		"bench:animation:ios": "node scripts/build-animation-quality.mjs",
		"bench:vlist:ios": "node scripts/bench-virtual-list.ts ios",
		"bench:vlist:android": "node scripts/bench-virtual-list.ts android",
		"test:ios": "ns test ios",
		"test:visibility": "XPLAT_TEXT_VISIBILITY_TESTS=1 vitest run src/tests/collapsed-text.spec.tsrx src/tests/text-visibility.spec.tsrx --maxWorkers=1 --no-file-parallelism",
		"test:ios:fonts": "NS_PLATFORM=ios vitest run src/tests/variable-font src/tests/font-family-inherit",
		"test:android": "ns test android",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json",
		"demos:ios": "XPLAT_DOCS_DEMOS=1 ns run ios --no-hmr",
		"demos:android": "XPLAT_DOCS_DEMOS=1 ns run android --no-hmr",
		"demos:build:ios": "XPLAT_DOCS_DEMOS=1 ns build ios",
		"macos": "bun run --cwd ../.. turbo run gen --filter=@octane-xplat/app && bun run --cwd ../.. turbo run build --filter=@octane-xplat/macos-build && xplat dev macos",
		"build:macos": "xplat build --targets macos",
		"build:macos:bundle": "vite build --config macos/vite.package.config.mjs",
		"typecheck:macos": "tsc --runExternalCode --noEmit -p ../../tools/macos-verification/tsconfig.json",
		"build:macos:dev": "vite build --config macos/vite.dev.config.mjs --mode development && vite build --config macos/vite.dev-shell.config.mjs --mode development"
	},
	"dependencies": {
		"@nativescript-community/gesturehandler": "2.1.0",
		"@nativescript-community/observable": "2.0.11",
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript-community/perms": "3.0.12",
		"@nativescript/canvas": "3.0.1",
		"@nativescript/core": "catalog:",
		"@nativescript/font-manager": "1.0.20",
		"@nativescript/macos-node-api": "catalog:",
		"@octane-xplat/auth": "workspace:*",
		"@octane-xplat/biometrics": "workspace:*",
		"@octane-xplat/camera": "workspace:*",
		"@octane-xplat/canvas": "workspace:*",
		"@octane-xplat/context-menu": "workspace:*",
		"@octane-xplat/date-picker": "workspace:*",
		"@octane-xplat/effects": "workspace:*",
		"@octane-xplat/files": "workspace:*",
		"@octane-xplat/geolocation": "workspace:*",
		"@octane-xplat/gif": "workspace:*",
		"@octane-xplat/haptics": "workspace:*",
		"@octane-xplat/image": "workspace:*",
		"@octane-xplat/lottie": "workspace:*",
		"@octane-xplat/media": "workspace:*",
		"@octane-xplat/nativescript-mason-core": "1.0.0-beta.13",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/notifications": "workspace:*",
		"@octane-xplat/pager": "workspace:*",
		"@octane-xplat/picker": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/push": "workspace:*",
		"@octane-xplat/richtext": "workspace:*",
		"@octane-xplat/secure-storage": "workspace:*",
		"@octane-xplat/share": "workspace:*",
		"@octane-xplat/sheet": "workspace:*",
		"@octane-xplat/smooth-corners": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octane-xplat/video": "workspace:*",
		"@octane-xplat/web-browser": "workspace:*",
		"@valor/nativescript-websockets": "2.0.3",
		"@octane-xplat/app": "workspace:*",
		"@octane-xplat/demos": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/vite-octane": "workspace:*",
		"@nativescript/android": "9.1.1",
		"@nativescript/ios": "9.1.0",
		"@nativescript/types": "catalog:",
		"@nativescript/unit-test-runner": "catalog:",
		"@nativescript/vite": "8.0.20",
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/macos-build": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"@tsrx/oxc": "catalog:",
		"nativescript": "9.1.1",
		"storybook": "10.6.6",
		"typescript": "catalog:",
		"typescript-classic": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"xplat": {
		"targets": {
			"windows": {
				"toolchain": "../../tools/windows-host"
			},
			"macos": {
				"runtime": "appkit-node-api",
				"dev": {
					"viteConfig": "macos/vite.dev.config.mjs",
					"bundleFile": "dist/macos-dev/app.cjs",
					"shellViteConfig": "macos/vite.dev-shell.config.mjs",
					"shellBundleFile": "dist/macos-dev/shell.cjs"
				},
				"package": {
					"productName": "Octane macOS spike",
					"bundleIdentifier": "org.octane.xplat.macos-spike",
					"executableName": "Octane",
					"version": "0.1.0",
					"minimumSystemVersion": "13.5",
					"viteConfig": "macos/vite.package.config.mjs",
					"bundleFile": "dist/macos-package/main.cjs",
					"entitlements": "macos/entitlements.plist",
					"infoPlist": {
						"NSCameraUsageDescription": "This app records video with the camera.",
						"NSMicrophoneUsageDescription": "This app records audio with your video."
					}
				}
			}
		}
	}
}
