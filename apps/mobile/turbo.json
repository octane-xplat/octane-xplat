{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		// The mobile program's tsconfig `include` covers ../../packages/**/* —
		// every package's sources are real inputs, including packages that are
		// not declared dependencies, so hash them explicitly. Explicit input
		// globs are filesystem walks (not git-aware), so node_modules and
		// per-package .turbo logs must be negated or the hash never stabilizes.
		"typecheck": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../packages/**/*.ts",
				"../../packages/**/*.tsx",
				"../../packages/**/*.tsrx",
				"../../packages/**/*.mts",
				"../../packages/**/*.cts",
				"../../packages/*/package.json",
				"../../packages/*/tsconfig*.json",
				"../../packages/*/tsrx-typegen.json",
				"!../../packages/**/node_modules/**",
				"!../../packages/**/.turbo/**"
			],
			"outputs": []
		}
	}
}
