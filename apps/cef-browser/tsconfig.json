{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@octane-xplat/macos-renderer",
		"customConditions": ["macos"],
		"moduleSuffixes": [".macos", ""],
		"lib": ["ESNext"],
		"allowJs": true,
		"checkJs": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "cef-dist", "cef-runtime"]
}
