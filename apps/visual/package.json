{
	"name": "@xplat/visual",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"test:mock": "vitest run mock.test",
		"update:mock": "vitest run mock.test --update",
		"verify:mock": "node scripts/verify-mock.mjs",
		"test:web": "vitest run web.test",
		"update:web": "vitest run web.test --update",
		"verify:web": "node scripts/verify-web.mjs",
		"capture:ios": "node scripts/capture-ios.mjs",
		"test:parity": "node scripts/parity.mjs",
		"test:comparator": "node --test scripts/parity.test.mjs scripts/geometry.test.mjs",
		"test:ios-regression": "VIS_ROOT=vis/ios vitest run ios-regression.test",
		"update:ios": "VIS_ROOT=vis/ios vitest run ios-regression.test --update",
		"promote:common": "node scripts/parity.mjs --promote-common",
		"promote:common:retained": "node scripts/parity.mjs --promote-common --retained"
	},
	"dependencies": {
		"@octane-xplat/ui": "workspace:*",
		"octane": "0.11.0"
	},
	"devDependencies": {
		"@octanejs/vite-plugin": "0.1.61",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"playwright": "1.63.0",
		"pngjs": "7.0.0",
		"storybook": "10.6.1",
		"vite": "8.3.0",
		"vitest": "4.1.11",
		"vitest-plugin-vis": "5.1.7"
	}
}
