{
	"name": "@xplat/linux",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm -w gen:app && node scripts/dev.ts",
		"build": "pnpm -w gen:app && xplat build --targets linux",
		"smoke": "node scripts/smoke.ts",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@octane-xplat/ui": "workspace:*",
		"@xplat/app": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"xplat": {
		"targets": {
			"linux": {
				"runtime": "webkitgtk",
				"host": {
					"scheme": "xplat"
				},
				"package": {
					"applicationId": "org.octane.xplat",
					"productName": "Octane xplat",
					"executableName": "octane-xplat",
					"version": "0.0.0",
					"viteConfig": "vite.linux.config.ts"
				}
			}
		}
	}
}
