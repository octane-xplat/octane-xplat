{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsxImportSource": "@nativescript-community/octane",
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "customConditions": ["native"],
    "lib": ["ESNext"],
    "paths": {
      "@xplat/app": ["../../packages/app/src/index.ts"],
      "@xplat/ui": ["../../packages/ui/src/index.native.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/**/*"],
  "files": ["./references.d.ts", "./types/globals.d.ts"],
  "exclude": ["node_modules", "platforms", "**/*.web.*", "../../packages/**/*.web.*"]
}
