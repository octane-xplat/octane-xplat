{
	"name": "@xplat/astryx-sandbox",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./examples/*": "./src/examples/*",
		"./icons": "./src/icons.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json",
		"coverage": "node scripts/generate-coverage.mjs",
		"verify:web": "node scripts/verify-web.mjs",
		"verify:authored": "node scripts/verify-authored.mjs",
		"verify:pages": "node scripts/verify-pages.mjs",
		"sameframe": "sameframe compare --config sameframe.yaml --json"
	},
	"dependencies": {
		"@octane-xplat/files": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"playwright": "1.63.0",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
