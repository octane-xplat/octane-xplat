{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": [
		"//"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^typegen",
				"@octane-xplat/cli#build"
			]
		},
		"verify:web": {
			"dependsOn": [
				"build"
			],
			"cache": false
		},
		"preview": {
			"dependsOn": [
				"build"
			],
			"cache": false,
			"persistent": true
		},
		"verify:authored": {
			"dependsOn": [
				"build",
				"@octane-xplat/cli#build"
			],
			"cache": false
		},
		"verify:pages": {
			"dependsOn": [
				"build",
				"@octane-xplat/cli#build"
			],
			"cache": false
		}
	}
}
