{
	"name": "@xplat/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --cwd ../.. turbo run gen --filter=@xplat/app && xplat dev web",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:query-cache-runtime": "node scripts/query-cache-runtime.ts",
		"smoke:routing": "node scripts/routing-contract.mts",
		"smoke:routing-auth": "node scripts/routing-auth.mts",
		"smoke:routing-watch": "node scripts/routing-watch.mts",
		"smoke:routing-pane-packed": "node scripts/routing-pane-packed.mts",
		"smoke:lexical-editor": "node scripts/lexical-editor-smoke.ts",
		"bench:vlist": "vite build && node scripts/bench-virtual-list.ts",
		"smoke": "vite build && node scripts/smoke.ts",
		"sqlite:readiness": "node scripts/sqlite-readiness.ts",
		"input:readiness": "node scripts/input-readiness.ts",
		"parity": "vite build && node scripts/parity.ts",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json",
		"test:platform-css": "node scripts/platform-css.mts",
		"test:id": "node scripts/test-id.ts",
		"sheet:readiness": "node scripts/sheet-readiness.ts"
	},
	"dependencies": {
		"@octane-xplat/ui": "workspace:*",
		"@xplat/app": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/sqlite": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"playwright": "1.63.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"typescript-classic": "catalog:"
	}
}
