{
	"name": "@xplat/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @xplat/app gen && xplat dev web",
		"build": "pnpm --filter @xplat/app gen && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"smoke:lexical-editor": "node scripts/lexical-editor-smoke.mjs",
		"bench:vlist": "pnpm --filter @xplat/app gen && vite build && node scripts/bench-virtual-list.mjs",
		"smoke": "pnpm --filter @xplat/app gen && vite build && node scripts/smoke.mjs",
		"sqlite:readiness": "node scripts/sqlite-readiness.mjs",
		"parity": "vite build && node scripts/parity.mjs",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@octane-xplat/ui": "workspace:*",
		"@xplat/app": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/sqlite": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"playwright": "1.63.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
