{
	"name": "@xplat/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node ../../scripts/watch-types.mjs -- pnpm dev:app",
		"build": "pnpm --filter @xplat/app gen && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"bench:vlist": "pnpm --filter @xplat/app gen && vite build && node scripts/bench-virtual-list.mjs",
		"smoke": "pnpm --filter @xplat/app gen && vite build && node scripts/smoke.mjs",
		"sqlite:readiness": "node scripts/sqlite-readiness.mjs",
		"parity": "vite build && node scripts/parity.mjs",
		"dev:app": "pnpm --filter @xplat/app gen && vite"
	},
	"dependencies": {
		"@octane-xplat/ui": "workspace:*",
		"@xplat/app": "workspace:*",
		"@xplat/demos": "workspace:*",
		"octane": "0.6.3"
	},
	"devDependencies": {
		"@octane-xplat/sqlite": "workspace:*",
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"playwright": "1.63.0",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
