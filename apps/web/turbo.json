{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"parity": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"cache": false
		},
		"test:query-cache-runtime": {
			"dependsOn": ["@octane-xplat/ui#typegen", "@octane-xplat/cli#build"],
			"cache": false
		},
		"input:readiness": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"env": ["XPLAT_WEB_BROWSER"],
			"cache": false
		},
		"sqlite:readiness": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"env": ["XPLAT_WEB_BROWSER"],
			"cache": false
		},
		// styled-system/* resolves into packages/app's generated sources — the
		// files must exist before these tasks run.
		"typecheck": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../tsrx-typegen/src/**",
				"../../scripts/check-native-dist.mjs",
				"../../packages/ui/scripts/sync-ui-barrels.ts"
			],
			"outputs": ["dist/**", "types/**"]
		},
		// vitest.config imports @octane-xplat/cli/vite — resolve its dist first.
		"test": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"outputs": []
		},
		"smoke": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["XPLAT_WEB_BROWSER"]
		},
		"smoke:navigation": { "dependsOn": ["build"], "cache": false },
		"smoke:harness": { "dependsOn": ["build"], "cache": false, "env": ["XPLAT_WEB_BROWSER", "XPLAT_HARNESS_URL", "XPLAT_HARNESS_REPORT"] },
		"smoke:showcase": { "dependsOn": ["build"], "cache": false, "env": ["XPLAT_WEB_BROWSER", "XPLAT_SHOWCASE_EVIDENCE", "XPLAT_SHOWCASE_URL"] },
		"bench:vlist": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"cache": false,
			"env": ["XPLAT_WEB_BROWSER"]
		},
		"test:id": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"cache": false,
			"env": ["XPLAT_WEB_BROWSER"]
		},
		"sheet:readiness": {
			"dependsOn": ["^typegen", "@xplat/app#gen", "@octane-xplat/cli#build"],
			"cache": false,
			"env": ["XPLAT_WEB_BROWSER"]
		}
	}
}
