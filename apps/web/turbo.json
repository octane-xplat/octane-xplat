{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"input:readiness": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"env": ["XPLAT_WEB_BROWSER"],
			"cache": false
		},
		"sqlite:readiness": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"env": ["XPLAT_WEB_BROWSER"],
			"cache": false
		},
		// styled-system/* resolves into packages/app's generated sources — the
		// files must exist before these tasks run.
		"typecheck": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../tsrx-typegen/src/**",
				"../../scripts/check-native-dist.mjs",
				"../../scripts/sync-ui-barrels.ts"
			],
			"outputs": ["dist/**", "types/**"]
		},
		"test": {
			"dependsOn": ["^typegen", "@xplat/app#gen"],
			"outputs": []
		}
	}
}
