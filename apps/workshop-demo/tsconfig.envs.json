{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true
	},
	"environments": {
		"web": {
			"include": ["src/**/*", "workshop.config.ts"],
			"exclude": ["**/*.{ios,android,mobile,native,macos,windows,linux}.*"]
		},
		"native": {
			"include": ["src/**/*"],
			"exclude": ["**/*.{web,macos,windows,linux}.*"],
			"compilerOptions": {
				"types": ["@nativescript/types"]
			}
		},
		"macos": {
			"include": ["src/**/*.macos.*"],
			"compilerOptions": {
				"types": ["@nativescript/types"]
			}
		}
	}
}
