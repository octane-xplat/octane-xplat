{
	"name": "octane-xplat",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"probe": "node scripts/probe.ts",
		"test:query-cache-runtime": "node scripts/query-cache-runtime.ts",
		"dev:web": "bun run --filter @xplat/web dev",
		"build:web": "turbo run build --filter=@xplat/web",
		"dev:ios": "bun run --filter @xplat/mobile ios",
		"typecheck:web": "turbo run typecheck --filter=@xplat/web",
		"typecheck:mobile": "turbo run typecheck --filter=@xplat/mobile",
		"typecheck:macos": "turbo run typecheck --filter=@xplat/macos",
		"lint": "node packages/lint/bin/lint.mjs",
		"lint:fix": "node packages/lint/bin/lint.mjs --fix",
		"format": "node packages/cli/src/cli.ts fmt",
		"check:recipes": "node scripts/check-recipes.ts",
		"check:changelog": "node scripts/release-notes.ts check",
		"sync:patches": "node scripts/sync-patches.ts",
		"sync:ui-barrels": "node scripts/sync-ui-barrels.ts",
		"check:ui-barrels": "node scripts/sync-ui-barrels.ts --check",
		"check:patches": "node scripts/sync-patches.ts --check",
		"check:decisions": "node scripts/check-decisions.ts",
		"check:suffix-resolution": "node scripts/check-suffix-resolution.ts",
		"check:vendored": "node scripts/check-vendored.ts",
		"submodules": "node scripts/ensure-submodules.ts",
		"check:css": "node scripts/check-css.ts",
		"check:metallib": "node scripts/check-metallib.ts",
		"gen:css-registry": "node scripts/gen-css-registry.ts",
		"parity:coverage": "node scripts/parity-coverage.ts",
		"parity": "node scripts/parity-coverage.ts && node scripts/parity-check.ts",
		"parity:macos": "bun run parity:coverage && bun run --filter @xplat/web parity && bun run --filter @xplat/macos parity && node scripts/parity-check.ts --targets=web,macos",
		"test": "turbo run test test:native && bun run test:create && node --test examples/auth/server-verification.test.mjs && bun run test:scripts",
		"typegen": "turbo run typegen",
		"typegen:watch": "turbo watch typegen --continue always",
		"gen:app": "turbo run gen --filter=@xplat/app",
		"postinstall": "bun run typegen && bun run gen:app",
		"test:cli": "turbo run test --filter=@octane-xplat/cli",
		"test:create": "node --test packages/create/test/*.test.mjs",
		"check:consumer": "node scripts/verify-consumer.ts",
		"dev:android": "bun run --filter @xplat/mobile android",
		"dev:masonkit": "node links/masonkit.ts",
		"dev:macos": "bun run --filter @xplat/macos dev",
		"dev:linux": "bun run --filter @xplat/linux dev",
		"dev:windows": "bun run --filter @xplat/windows windows",
		"dev:docs": "bun run --filter @xplat/docs dev",
		"build:packages": "turbo run typegen build build:assets --filter=./packages/*",
		"build:ios": "bun run --filter @xplat/mobile build:ios",
		"build:macos": "bun run --filter @xplat/macos package",
		"build:linux": "bun run --filter @xplat/linux build",
		"build:windows": "bun run --filter @xplat/windows build:windows",
		"build:docs": "turbo run build --filter=@xplat/docs",
		"typecheck:linux": "turbo run typecheck --filter=@xplat/linux",
		"typecheck:windows": "turbo run typecheck --filter=@xplat/windows",
		"typecheck:docs": "turbo run typecheck --filter=@xplat/docs",
		"typecheck": "turbo run typegen && turbo run typecheck",
		"typecheck:apps": "turbo run typegen && turbo run typecheck --filter='./apps/*'",
		"check": "bun run check:workspace && bun run lint && bun run check:css && bun run check:docs && bun run check:doc-examples && bun run check:recipes && bun run check:changelog && bun run check:compatibility && bun run check:patches && bun run check:ui-barrels && bun run check:decisions && bun run check:suffix-resolution && bun run check:metallib && bun run check:vendored",
		"validate": "bun run check && bun run typecheck && bun run test",
		"smoke:web": "bun run --filter @xplat/web smoke",
		"smoke:docs": "bun run --filter @xplat/docs smoke",
		"test:packed": "turbo run test:packed --filter='./packages/*' --concurrency=2",
		"test:e2e": "node scripts/test-e2e.ts",
		"test:scripts": "node --test --test-concurrency=2 scripts/*.test.mjs",
		"test:release": "node --test scripts/release-*.test.mjs scripts/verify-release-evidence.test.mjs",
		"test:typegen": "turbo run test --filter=tsrx-typegen",
		"check:optional-services": "node scripts/check-optional-services.ts",
		"check:pack": "turbo run pack:check --filter='./packages/*' --concurrency=2",
		"smoke:macos": "bun run --filter @xplat/macos smoke && bun run --filter @xplat/macos test:animation && bun run --filter @xplat/macos test:layout-placement && bun run probe run examples/probes/signals.ts --target macos && bun run probe run examples/probes/counter.tsrx --target macos && bun run probe run examples/probes/lottie.macos.tsrx --target macos --deps @octane-xplat/lottie",
		"test:maestro": "node scripts/maestro.ts",
		"typecheck:scripts": "tsc -p scripts/tsconfig.json",
		"bench:routing-types": "node scripts/bench-routing-types.ts",
		"eval:routing": "node scripts/eval-routing.ts",
		"sync:compatibility": "node scripts/sync-compatibility.ts",
		"check:compatibility": "node scripts/sync-compatibility.ts --check",
		"check:native-readiness": "node tools/native-readiness/run.mjs",
		"check:docs": "node scripts/check-docs.ts",
		"check:doc-examples": "node scripts/check-doc-examples.ts",
		"test:docs": "node --test scripts/check-docs.test.mjs",
		"sync:workspace": "node scripts/sync-workspace.ts",
		"check:workspace": "node scripts/sync-workspace.ts --check"
	},
	"devDependencies": {
		"@tsrx/core": "0.2.4",
		"@tsrx/oxc": "0.20.0",
		"@tsrx/typescript-plugin": "catalog:",
		"@types/node": "24.10.1",
		"oxfmt": "0.70.0",
		"oxlint": "1.74.0",
		"turbo": "2.11.4",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"yaml": "2.9.1",
		"tslib": "2.8.1"
	},
	"packageManager": "bun@1.4.4",
	"workspaces": {
		"packages": [
			"apps/*",
			"tools/*",
			"packages/*"
		],
		"catalog": {
			"octane": "0.16.3",
			"@nativescript-community/octane": "0.2.5",
			"@nativescript-community/vite-octane": "0.2.1",
			"@nativescript/core": "9.1.3",
			"@nativescript/types": "9.1.4",
			"@nativescript/types-android": "9.1.1",
			"@nativescript/types-ios": "9.1.3",
			"@nativescript/macos-node-api": "0.4.4-next.2026-08-09-31292056208",
			"@nativescript/unit-test-runner": "5.0.0",
			"typescript": "5.9.3",
			"vite": "8.3.0",
			"@octanejs/vite-plugin": "0.5.0",
			"@tsrx/typescript-plugin": "0.4.11",
			"vitest": "4.1.11",
			"jsdom": "30.1.1"
		}
	},
	"overrides": {
		"regenerate": "1.5.0",
		"oxlint-tsgolint": "7.0.2005",
		"chokidar": "^3.6.0",
