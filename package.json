				"@nativescript/hook": "3.0.5"
			}
		}
	},
	"patchedDependencies": {
		"octane@0.16.3": "packages/cli/patches/octane@0.16.3.patch",
		"@nativescript/core@9.1.3": "packages/cli/patches/@nativescript__core@9.1.3.patch",
		"css@3.0.0": "packages/cli/patches/css@3.0.0.patch",
		"@nativescript/vite@8.0.20": "packages/cli/patches/@nativescript__vite@8.0.20.patch",
		"@nativescript-community/octane@0.2.5": "packages/cli/patches/@nativescript-community__octane@0.2.5.patch",
		"@nativescript-community/vite-octane@0.2.1": "packages/cli/patches/@nativescript-community__vite-octane@0.2.1.patch",
		"@nativescript/vite@8.0.21": "packages/cli/patches/@nativescript__vite@8.0.21.patch",
