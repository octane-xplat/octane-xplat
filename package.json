		"@tsrx/typescript-plugin@0.4.11": "packages/cli/patches/@tsrx__typescript-plugin@0.4.11.patch",
		"@octanejs/tiptap@0.0.61": "packages/cli/patches/@octanejs__tiptap@0.0.61.patch",
		"@nativescript/doctor@2.0.18": "packages/cli/patches/@nativescript__doctor@2.0.18.patch"
	},
