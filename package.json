{
	"name": "octane-xplat",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @xplat/web dev",
		"build:web": "pnpm --filter @xplat/web build",
		"dev:ios": "ns debug ios --path apps/native",
		"typecheck:web": "tsrx-tsc --noEmit -p apps/web/tsconfig.json",
		"typecheck:native": "tsrx-tsc --noEmit -p apps/native/tsconfig.json",
		"lint": "node scripts/lint.mjs",
		"lint:fix": "node scripts/lint.mjs --fix",
		"format": "oxlint --fix && oxfmt",
		"check:no-dom": "node scripts/check-no-dom.mjs",
		"test": "pnpm --filter @xplat/web test && pnpm --filter @octane-xplat/ui test:native"
	},
	"devDependencies": {
		"@tsrx/core": "0.2.4",
		"@tsrx/typescript-plugin": "0.4.11",
		"oxfmt": "0.70.0",
		"oxlint": "1.74.0",
		"typescript": "5.9.3",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@11.24.0"
}
