{
	"name": "octane-xplat",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"probe": "node scripts/probe.mjs",
		"dev:web": "pnpm --filter @xplat/web dev",
		"build:web": "turbo run build --filter=@xplat/web",
		"dev:ios": "node scripts/watch-types.mjs -- ns debug ios --path apps/mobile",
		"typecheck:web": "turbo run typecheck --filter=@xplat/web",
		"typecheck:mobile": "turbo run typecheck --filter=@xplat/mobile",
		"typecheck:macos": "turbo run typecheck --filter=@xplat/macos",
		"lint": "node scripts/lint.mjs",
		"lint:fix": "node scripts/lint.mjs --fix",
		"format": "oxlint --fix && oxfmt",
		"check:recipes": "node scripts/check-recipes.mjs",
		"sync:patches": "node scripts/sync-patches.mjs",
		"sync:ui-barrels": "node scripts/sync-ui-barrels.mjs",
		"check:ui-barrels": "node scripts/sync-ui-barrels.mjs --check",
		"check:patches": "node scripts/sync-patches.mjs --check",
		"check:decisions": "node scripts/check-decisions.mjs",
		"check:no-dom": "node scripts/check-no-dom.mjs",
		"check:suffix-resolution": "node scripts/check-suffix-resolution.mjs",
		"check:css": "node scripts/check-css.mjs",
		"gen:css-registry": "node scripts/gen-css-registry.mjs",
		"parity:coverage": "node scripts/parity-coverage.mjs",
		"parity": "node scripts/parity-coverage.mjs && node scripts/parity-check.mjs",
		"parity:macos": "pnpm parity:coverage && pnpm --filter @xplat/web parity && pnpm --filter @xplat/macos parity && node scripts/parity-check.mjs --targets=web,macos",
		"test": "turbo run test test:native && pnpm test:cli && pnpm test:create && node --test examples/auth/server-verification.test.mjs && pnpm test:scripts",
		"typegen": "turbo run typegen",
		"typegen:watch": "node scripts/watch-types.mjs",
		"postinstall": "pnpm typegen && pnpm --filter @xplat/app exec bamboo codegen",
		"test:cli": "node --test packages/cli/test/*.test.mjs",
		"test:create": "node --test packages/create/test/*.test.mjs",
		"check:consumer": "node scripts/verify-consumer.mjs",
		"dev:android": "pnpm --filter @xplat/mobile android",
		"dev:macos": "pnpm --filter @xplat/macos dev",
		"dev:linux": "pnpm --filter @xplat/linux dev",
		"dev:windows": "pnpm --filter @xplat/windows windows",
		"dev:docs": "pnpm --filter @xplat/docs dev",
		"build:packages": "turbo run build --filter=./packages/*",
		"build:ios": "pnpm --filter @xplat/mobile build:ios",
		"build:macos": "pnpm --filter @xplat/macos package",
		"build:linux": "pnpm --filter @xplat/linux build",
		"build:windows": "pnpm --filter @xplat/windows build:windows",
		"build:docs": "pnpm --filter @xplat/docs build",
		"typecheck:linux": "turbo run typecheck --filter=@xplat/linux",
		"typecheck:windows": "turbo run typecheck --filter=@xplat/windows",
		"typecheck:docs": "turbo run typecheck --filter=@xplat/docs",
		"typecheck": "turbo run typegen && turbo run typecheck --filter='./apps/*'",
		"check": "pnpm lint && pnpm check:patches && pnpm check:decisions && pnpm check:suffix-resolution",
		"validate": "pnpm check && pnpm typecheck && pnpm test",
		"smoke:web": "pnpm --filter @xplat/web smoke",
		"smoke:docs": "pnpm --filter @xplat/docs smoke",
		"test:packed": "pnpm -r --filter './packages/**' --if-present run test:packed",
		"test:scripts": "node --test scripts/*.test.mjs",
		"test:typegen": "pnpm --filter tsrx-typegen test",
		"check:optional-services": "node scripts/check-optional-services.mjs",
		"check:pack": "pnpm -r --filter './packages/**' --if-present run pack:check",
		"smoke:macos": "pnpm --filter @xplat/macos smoke && pnpm --filter @xplat/macos test:animation && pnpm probe run examples/probes/signals.ts --target macos && pnpm probe run examples/probes/counter.tsrx --target macos && pnpm probe run examples/probes/lottie.macos.tsrx --target macos --deps @octane-xplat/lottie",
		"test:maestro": "node scripts/maestro.mjs"
	},
	"devDependencies": {
		"@tsrx/core": "0.2.4",
		"@tsrx/typescript-plugin": "0.4.11",
		"oxfmt": "0.70.0",
		"oxlint": "1.74.0",
		"turbo": "2.11.4",
		"typescript": "5.9.3",
		"vitest": "5.0.1",
		"yaml": "2.9.1"
	},
	"packageManager": "pnpm@11.24.0"
}
