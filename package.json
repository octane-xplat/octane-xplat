{
	"name": "octane-xplat",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @xplat/web dev",
		"build:web": "pnpm --filter @xplat/web build",
		"dev:ios": "ns debug ios --path apps/mobile",
		"typecheck:web": "tsrx-tsc --noEmit -p apps/web/tsconfig.json",
		"typecheck:mobile": "tsrx-tsc --noEmit -p apps/mobile/tsconfig.json",
		"typecheck:macos": "pnpm --filter @xplat/macos typecheck",
		"lint": "node scripts/lint.mjs",
		"lint:fix": "node scripts/lint.mjs --fix",
		"format": "oxlint --fix && oxfmt",
		"check:recipes": "node scripts/check-recipes.mjs",
		"sync:patches": "node scripts/sync-patches.mjs",
		"check:patches": "node scripts/sync-patches.mjs --check",
		"check:decisions": "node scripts/check-decisions.mjs",
		"check:no-dom": "node scripts/check-no-dom.mjs",
		"check:suffix-resolution": "node scripts/check-suffix-resolution.mjs",
		"check:css": "node scripts/check-css.mjs",
		"gen:css-registry": "node scripts/gen-css-registry.mjs",
		"parity:coverage": "node scripts/parity-coverage.mjs",
		"parity": "node scripts/parity-coverage.mjs && node scripts/parity-check.mjs",
		"parity:macos": "pnpm parity:coverage && pnpm --filter @xplat/web parity && pnpm --filter @xplat/macos parity && node scripts/parity-check.mjs --targets=web,macos",
		"test": "pnpm --filter @xplat/web test && pnpm --filter @octane-xplat/motion test && pnpm --filter @octane-xplat/ui test:native"
	},
	"devDependencies": {
		"@tsrx/core": "0.2.4",
		"@tsrx/typescript-plugin": "0.4.11",
		"oxfmt": "0.70.0",
		"oxlint": "1.74.0",
		"typescript": "5.9.3",
		"vitest": "5.0.1",
		"yaml": "2.9.1"
	},
	"packageManager": "pnpm@11.24.0"
}
