{
  "name": "octane-xplat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:web": "pnpm --filter @xplat/web dev",
    "build:web": "pnpm --filter @xplat/web build",
    "dev:ios": "ns debug ios --path apps/native",
    "typecheck:web": "tsrx-tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:native": "tsrx-tsc --noEmit -p apps/native/tsconfig.json"
  },
  "devDependencies": {
    "@tsrx/typescript-plugin": "0.4.7"
  }
}
