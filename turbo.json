		"test:go-android-reports-real": { "cache": false, "dependsOn": ["@xplat/cli-go-probe#prepare:go-android-reports"], "passThroughEnv": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME", "XPLAT_GO_ANDROID_PORT"] },
