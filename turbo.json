{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["tsconfig.base.json", "packages/cli/patches/**"],
	"tasks": {
		"//#check:native-readiness": {
			"cache": false,
			"passThroughEnv": [
				"ANDROID_HOME",
				"ANDROID_SDK_ROOT",
				"JAVA_HOME",
				"GRADLE_USER_HOME",
				"VERIFY_IOS_DEVICE",
				"VERIFY_ANDROID_DEVICE",
				"XPLAT_IOS_DEVELOPMENT_TEAM"
			]
		},
		"test:intl": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/intl-test-utils.mjs"],
			"dependsOn": ["typegen", "^typegen", "^build"],
			"outputs": []
		},
		// Declarations consumed by dependents' typecheck (exports.types →
		// types/generated). ^typegen ordering guarantees dep d.ts exist; the edge
		// also folds each dep package's file hash in — even for script-less deps,
		// whose typegen node is a no-op that still hashes their files.
		// tsrx-typegen is a workspace-linked bin (src/, no build step) — its
		// sources are real inputs to every package's typegen.
		"typegen": {
			"dependsOn": ["^typegen", "//#submodules"],
			"inputs": ["$TURBO_DEFAULT$", "../tsrx-typegen/src/**"],
			"outputs": ["types/**"]
		},
		// @xplat/app only: xplat routes → tracked src/routes.gen.*, bamboo codegen
		// → gitignored src/styled-system/. Consumers resolve styled-system via
		// tsconfig paths, so app-consuming apps order it via @xplat/app#gen.
		// bamboo codegen loads bamboo.config.ts, whose @octane-xplat/bamboo import
		// resolves through package exports to dist/ — built on demand here.
		"gen": {
			"dependsOn": ["^typegen", "@octane-xplat/bamboo#build"],
			"outputs": ["src/routes.gen*", "src/styled-system/**"]
		},
		// Apps build their bundles; package builds are limited to Node tooling.
		"build": {
			"dependsOn": ["^typegen"],
			"inputs": ["$TURBO_DEFAULT$", "../tsrx-typegen/src/**"],
			"outputs": ["dist/**", "types/**"]
		},
		"build:assets": {
			"dependsOn": ["^typegen"],
			"inputs": ["$TURBO_DEFAULT$", "../richtext/build-browser.ts"],
			"outputs": ["dist/macos/browser.js", "dist/macos/browser.d.ts"]
		},
		"typecheck": {
			"dependsOn": ["^typegen"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../scripts/typecheck.ts",
				"../../packages/cli/src/tsconfig-envs.ts"
			],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^typegen", "^build"],
			"outputs": []
		},
		"test:native": {
			"dependsOn": ["^typegen", "^build"],
			"outputs": []
		},
		// Browser input/geometry checks run locally, outside the PR checks job.
		"@octane-xplat/lightbox#test:e2e": {
			"dependsOn": ["^typegen", "^build"],
			"env": ["XPLAT_WEB_BROWSER"],
			"passThroughEnv": ["DEBUG_E2E"],
			"cache": false
		},
		"test:macos": {
			"dependsOn": ["^typegen"],
			"outputs": []
		},
		// Boots a real macOS harness process — observable side effects, keep uncached.
		"test:macos-runtime": {
			"dependsOn": ["^typegen"],
			"cache": false
		},
		// Packs the package and installs the tarball in a temp consumer — side
		// effects outside outputs/, keep uncached.
		"test:packed": {
			"dependsOn": ["typegen", "build", "build:assets"],
			"cache": false
		},
		"pack:check": {
			"dependsOn": ["typegen", "build", "build:assets"],
			"inputs": ["$TURBO_DEFAULT$", "../tsrx-typegen/src/**"],
			"outputs": []
		},
		"typegen:check": {
			"dependsOn": ["typegen"],
			"inputs": ["$TURBO_DEFAULT$", "../tsrx-typegen/src/**"],
			"outputs": []
		},
		"typecheck:consumer": {
			"dependsOn": ["typegen"],
			"outputs": []
		},
		"test:comparator": {
			"outputs": []
		},
		"//#test:query-cache-runtime": {
			"dependsOn": ["@octane-xplat/ui#typegen", "@octane-xplat/cli#build"],
			"cache": false
		},
		"//#test:scripts": {
			"dependsOn": ["@octane-xplat/cli#build"],
			"cache": false
		},
		"//#test:release": {
			"cache": false
		},
		"//#check:optional-services": {
			"cache": false
		},
		"//#typecheck:scripts": {
			"cache": false
		},
		// lint is a single repo-wide pass (oxlint + tsrx rules sweep), not a
		// per-package boundary — exposed for `turbo run lint` but never cached:
		// its real input set is the whole repo, which package hashing can't
		// express for a root script.
		"//#lint": {
			"cache": false
		},
		// Vendor submodule init on demand — worktrees/clones start with them
		// uninitialized, and the missing sources only fail deep inside typegen.
		// Uncached: git checkout state is not a file input turbo can hash.
		"//#submodules": {
			"cache": false
		}
	}
}
