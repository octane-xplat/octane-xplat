{
	"contentMappers": [
		{
			"package": "@tsrx/content-mapper",
			"extensions": [
				".tsrx"
			]
		}
	],
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"types": [
			"node"
		],
		"lib": [
			"ESNext"
		],
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"noEmit": true
	},
	"include": [
		"*.ts"
	],
	"exclude": [
		"*.test.ts"
	]
}
