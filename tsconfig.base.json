{
	"compilerOptions": {
		"module": "esnext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".gtk",
			".windows"
		],
		"strict": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"noEmit": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmitHelpers": true
	}
}
