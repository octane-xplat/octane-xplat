{
	"compilerOptions": {
		"module": "esnext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmitHelpers": true
	}
}
