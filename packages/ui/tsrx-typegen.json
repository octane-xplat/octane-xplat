{
	"targets": {
		"ui": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.mobile.ts",
					"runtime": [
						"./src/index.macos.ts",
						"./src/index.linux.ts",
						"./src/index.web.ts",
						"./src/index.mobile.ts",
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.macos.d.ts",
						"./types/generated/index.web.d.ts",
						"./types/generated/index.mobile.d.ts",
						"./types/generated/index.d.ts"
					]
				},
				"./routing": {
					"source": "src/routing/index.ts",
					"runtime": [
						"./src/routing/index.macos.ts",
						"./src/routing/index.web.ts",
						"./src/routing/index.ts"
					],
					"types": [
						"./types/generated/routing/index.d.ts",
						"./types/generated/routing/index.web.d.ts",
						"./types/generated/routing/index.macos.d.ts"
					]
				},
				"./data": {
					"source": "src/data/index.ts",
					"runtime": [
						"./src/data/index.macos.ts",
						"./src/data/index.web.ts",
						"./src/data/index.ts"
					],
					"types": [
						"./types/generated/data/index.d.ts",
						"./types/generated/data/index.web.d.ts",
						"./types/generated/data/index.macos.d.ts"
					]
				},
				"./markdown": {
					"source": "src/markdown/index.ts",
					"runtime": [
						"./src/markdown/index.web.ts",
						"./src/markdown/index.macos.ts",
						"./src/markdown/index.ts"
					],
					"types": "./types/generated/markdown/index.d.ts"
				},
				"./chat": {
					"source": "src/chat/index.ts",
					"runtime": ["./src/chat/index.ts", "./src/chat/index.web.ts"],
					"types": ["./types/generated/chat/index.d.ts", "./types/generated/chat/index.web.d.ts"]
				},
				"./ios": {
					"source": "src/ios/index.ts",
					"runtime": ["./src/ios/index.ts"],
					"types": "./types/generated/ios/index.d.ts"
				},
				"./android": {
					"source": "src/android/index.ts",
					"runtime": ["./src/android/index.ts"],
					"types": "./types/generated/android/index.d.ts"
				},
				"./nativescript": {
					"source": "src/nativescript/index.ts",
					"runtime": ["./src/nativescript/index.ts"],
					"types": "./types/generated/nativescript/index.d.ts"
				},
				"./web": {
					"source": "src/web/index.ts",
					"runtime": ["./src/web/index.ts"],
					"types": "./types/generated/web/index.d.ts"
				},
				"./macos": {
					"source": "src/macos/index.ts",
					"runtime": ["./src/macos/index.ts"],
					"types": "./types/generated/macos/index.d.ts"
				},
				"./linux": {
					"source": "src/linux/index.ts",
					"runtime": ["./src/linux/index.ts"],
					"types": "./types/generated/linux/index.d.ts"
				},
				"./parity": {
					"source": "src/parity/index.ts",
					"runtime": ["./src/parity/index.ts"],
					"types": "./types/generated/parity/index.d.ts"
				},
				"./parity/check-helpers": {
					"source": "src/parity/check-helpers.ts",
					"runtime": ["./src/parity/check-helpers.ts"],
					"types": "./types/generated/parity/check-helpers.d.ts"
				}
			}
		}
	},
	"sourceExtensions": {
		".ts": ".js",
		".tsx": ".js",
		".tsrx": ".js"
	},
	"overrides": {}
}
