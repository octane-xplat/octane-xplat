{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"test:layout:web": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"cache": false,
			"passThroughEnv": ["GODDARD_*"]
		},
		"test:layout:ios": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"cache": false,
			"passThroughEnv": ["GODDARD_*", "XPLAT_IOS_DEVELOPMENT_TEAM"]
		},
		"test:layout:android": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"cache": false,
			"passThroughEnv": ["GODDARD_*", "ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME", "ADB_SERVER_SOCKET", "ANDROID_ADB_SERVER_PORT"]
		},
		"test:layout:macos": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"cache": false,
			"passThroughEnv": ["GODDARD_*"]
		},
		"test:windows": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"outputs": []
		},
		"test:macos-exports": {
			"dependsOn": ["typegen", "^typegen"],
			"outputs": []
		},
		"test:macos": {
			"dependsOn": ["typegen", "^typegen"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["typegen", "^typegen", "^build"]
		},
		"test:liquid-glass:ios": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"cache": false,
			"passThroughEnv": ["GODDARD_*", "XPLAT_IOS_DEVELOPMENT_TEAM"]
		},
		"test:liquid-glass": {
			"dependsOn": ["^typegen", "^build"],
			"outputs": []
		},
		"test:native": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"env": ["XPLAT_UI_TEST_TARGET"]
		},
		"bench:render": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"cache": false,
			"passThroughEnv": ["XPLAT_UI_BENCH_*"]
		},
		"typecheck": {
			"dependsOn": ["^typegen", "typecheck:scripts"],
			"inputs": ["$TURBO_DEFAULT$", "../../scripts/typecheck.ts", "../../packages/cli/src/tsconfig-envs.ts", "../../examples/accessibility/AccessibleTripForm.tsx", "../../examples/auth/AccountScreen.tsx", "../../examples/auth/session.ts", "../../examples/payments/PurchaseScreen.tsx", "../../examples/payments/purchases.ts", "../../examples/storage/**", "../../examples/motion/imperative.tsrx", "../../examples/clipboard/copy-text.tsrx", "../../examples/keyboard/hardware.web.tsrx", "../../examples/keyboard/keyboard-space.tsrx"],
			"outputs": []
		},
		"typecheck:scripts": {
			"dependsOn": [],
			"outputs": []
		},
		"check:ui-barrels": {
			"dependsOn": [],
			"cache": false
		},
		"bench:routing-types": {
			"dependsOn": ["typegen", "@octane-xplat/cli#build"],
			"cache": false
		},
		"test:gestures:native": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"env": ["XPLAT_UI_TEST_TARGET"]
		}
	}
}
