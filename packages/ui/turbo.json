{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"test:windows": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"outputs": []
		},
		"test:macos-exports": {
			"dependsOn": ["typegen", "^typegen"],
			"outputs": []
		},
		"test:macos": {
			"dependsOn": ["typegen", "^typegen"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["typegen", "^typegen", "^build"]
		},
		"test:native": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"env": ["XPLAT_UI_TEST_TARGET"]
		},
		"typecheck": {
			"dependsOn": ["^typegen", "typecheck:scripts"],
			"outputs": []
		},
		"typecheck:scripts": {
			"dependsOn": [],
			"outputs": []
		},
		"check:ui-barrels": {
			"dependsOn": [],
			"cache": false
		},
		"bench:routing-types": {
			"dependsOn": ["typegen", "@octane-xplat/cli#build"],
			"cache": false
		},
		"test:gestures:native": {
			"dependsOn": ["typegen", "^typegen", "^build"],
			"env": ["XPLAT_UI_TEST_TARGET"]
		}
	}
}
