{
	"name": "@octane-xplat/ui",
	"version": "0.9.0",
	"description": "Cross-platform UI for Octane xplat — shared primitives, stacks, routes and theming across web (DOM), iOS and Android (NativeScript)",
	"keywords": [
		"android",
		"cross-platform",
		"design-system",
		"ios",
		"nativescript",
		"octane",
		"primitives",
		"ui",
		"ui-components",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/ui",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"types",
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"linux": {
				"types": "./types/generated/index.linux.d.ts",
				"default": "./src/index.linux.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.mobile.d.ts",
				"default": "./src/index.mobile.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./ios": {
			"types": "./types/generated/ios/index.d.ts",
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"types": "./types/generated/android/index.d.ts",
			"native": "./src/android/index.ts"
		},
		"./native": {
			"types": "./types/generated/native/index.d.ts",
			"native": "./src/native/index.ts"
		},
		"./web": {
			"types": "./types/generated/web/index.d.ts",
			"web": "./src/web/index.ts"
		},
		"./theme/*": "./src/theme/*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.macos.d.ts",
					"default": "./src/index.macos.ts"
				},
				"web": {
					"types": "./types/generated/index.web.d.ts",
					"default": "./dist/web/ui.js"
				},
				"native": {
					"types": "./types/generated/index.mobile.d.ts",
					"default": "./dist/native/ui.js"
				},
				"types": "./types/generated/index.d.ts",
				"default": "./dist/native/shared.js"
			},
			"./ios": {
				"types": "./types/generated/ios/index.d.ts",
				"native": "./dist/native/ios/index.js"
			},
			"./android": {
				"types": "./types/generated/android/index.d.ts",
				"native": "./dist/native/android/index.js"
			},
			"./native": {
				"types": "./types/generated/native/index.d.ts",
				"native": "./dist/native/native/index.js"
			},
			"./web": {
				"types": "./types/generated/web/index.d.ts",
				"web": "./dist/web/web/index.js"
			},
			"./theme/tokens.css": "./src/theme/tokens.css",
			"./theme/chrome.css": "./src/theme/chrome.css"
		}
	},
	"scripts": {
		"build": "node ../../scripts/sync-ui-barrels.mjs --check && vite build && vite build --mode native && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"test:native": "node --test tests/animated-value.test.mjs tests/tap-to-blur.ios.test.mjs && vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target ui",
		"pack:check": "tsrx-typegen --pack-check",
		"test:macos": "node tests/macos-barrel.mjs && node tests/packed-consumer.mjs --macos-only"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript-community/ui-drawer": "0.1.32",
		"@nativescript/core": "9.1.2",
		"@nativescript/types": "9.0.0",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"jsdom": "30.1.1",
		"octane": "0.6.3",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	}
}
