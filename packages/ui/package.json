	"scripts": {
		"build": "node ../../scripts/sync-ui-barrels.mjs --check && vite build && vite build --mode native && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"test:native": "node --test tests/keyboard-inset.test.mjs tests/liquid-glass.ios.test.mjs tests/animated-value.test.mjs tests/tap-to-blur.ios.test.mjs tests/bottom-sheet-service.macos.test.mjs tests/color-scheme.macos.test.mjs tests/query-storage.macos.test.mjs && vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target ui",
		"pack:check": "tsrx-typegen --pack-check",
		"test:scroll:macos": "node ../../scripts/probe.mjs run tests/fixtures/scrollable-area.macos.tsrx --target macos",
		"test:layer:web": "node --test tests/layer-position.web.mjs",
		"test:macos": "node --test tests/query-storage.macos.test.mjs && node tests/macos-barrel.mjs && node tests/packed-consumer.mjs --macos-only"
	},
