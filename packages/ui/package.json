{
  "name": "@octane-xplat/ui",
  "version": "0.2.1",
  "type": "module",
  "files": [
    "dist",
    "types",
    "src/theme/tokens.css"
  ],
  "exports": {
    ".": {
      "web": "./src/index.web.ts",
      "native": "./src/index.native.ts",
