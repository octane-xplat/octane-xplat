{
	"name": "@octane-xplat/ui",
	"version": "0.18.0",
	"description": "Cross-platform UI for Octane xplat — shared primitives, stacks, routes and theming across web (DOM), iOS and Android (NativeScript)",
	"keywords": [
		"android",
		"cross-platform",
		"design-system",
		"ios",
		"nativescript",
		"octane",
		"primitives",
		"ui",
		"ui-components",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/ui",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/ui"
	},
	"files": [
		"dist/parity",
		"types",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"windows": {
				"types": "./types/generated/index.windows.d.ts",
				"default": "./src/index.windows.ts"
			},
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"linux": {
				"types": "./types/generated/index.linux.d.ts",
				"default": "./src/index.linux.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"gtk": {
				"types": "./types/generated/index.gtk.d.ts",
				"default": "./src/index.gtk.ts"
			},
			"native": {
				"types": "./types/generated/index.mobile.d.ts",
				"default": "./src/index.mobile.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./routing": {
			"macos": {
				"types": "./types/generated/routing/index.macos.d.ts",
				"default": "./src/routing/index.macos.ts"
			},
			"linux": {
				"types": "./types/generated/routing/index.web.d.ts",
				"default": "./src/routing/index.web.ts"
			},
			"web": {
				"types": "./types/generated/routing/index.web.d.ts",
				"default": "./src/routing/index.web.ts"
			},
			"native": {
				"types": "./types/generated/routing/index.d.ts",
				"default": "./src/routing/index.ts"
			},
			"types": "./types/generated/routing/index.d.ts",
			"default": "./src/routing/index.ts"
		},
		"./data": {
			"macos": {
				"types": "./types/generated/data/index.macos.d.ts",
				"default": "./src/data/index.macos.ts"
			},
			"linux": {
				"types": "./types/generated/data/index.web.d.ts",
				"default": "./src/data/index.web.ts"
			},
			"web": {
				"types": "./types/generated/data/index.web.d.ts",
				"default": "./src/data/index.web.ts"
			},
			"native": {
				"types": "./types/generated/data/index.d.ts",
				"default": "./src/data/index.ts"
			},
			"types": "./types/generated/data/index.d.ts",
			"default": "./src/data/index.ts"
		},
		"./data/dev": {
			"types": "./types/generated/data/dev.d.ts",
			"default": "./src/data/dev.ts"
		},
		"./routing/dev": {
			"macos": {
				"types": "./types/generated/routing/dev.macos.d.ts",
				"default": "./src/routing/dev.macos.ts"
			},
			"linux": {
				"types": "./types/generated/routing/dev.web.d.ts",
				"default": "./src/routing/dev.web.ts"
			},
			"web": {
				"types": "./types/generated/routing/dev.web.d.ts",
				"default": "./src/routing/dev.web.ts"
			},
			"native": {
				"types": "./types/generated/routing/dev.d.ts",
				"default": "./src/routing/dev.ts"
			},
			"types": "./types/generated/routing/dev.d.ts",
			"default": "./src/routing/dev.ts"
		},
		"./markdown": {
			"web": {
				"types": "./types/generated/markdown/index.d.ts",
				"default": "./src/markdown/index.web.ts"
			},
			"macos": {
				"types": "./types/generated/markdown/index.d.ts",
				"default": "./src/markdown/index.macos.ts"
			},
			"linux": {
				"types": "./types/generated/markdown/index.d.ts",
				"default": "./src/markdown/index.web.ts"
			},
			"types": "./types/generated/markdown/index.d.ts",
			"default": "./src/markdown/index.ts"
		},
		"./chat": {
			"macos": {
				"types": "./types/generated/chat/index.d.ts",
				"default": "./src/chat/index.ts"
			},
			"linux": {
				"types": "./types/generated/chat/index.web.d.ts",
				"default": "./src/chat/index.web.ts"
			},
			"web": {
				"types": "./types/generated/chat/index.web.d.ts",
				"default": "./src/chat/index.web.ts"
			},
			"native": {
				"types": "./types/generated/chat/index.d.ts",
				"default": "./src/chat/index.ts"
			},
			"types": "./types/generated/chat/index.d.ts",
			"default": "./src/chat/index.ts"
		},
		"./ios": {
			"types": "./types/generated/ios/index.d.ts",
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"types": "./types/generated/android/index.d.ts",
			"native": "./src/android/index.ts"
		},
		"./nativescript": {
			"types": "./types/generated/nativescript/index.d.ts",
			"native": "./src/nativescript/index.ts"
		},
		"./web": {
			"types": "./types/generated/web/index.d.ts",
			"web": "./src/web/index.ts"
		},
		"./macos": {
			"types": "./types/generated/macos/index.d.ts",
			"macos": "./src/macos/index.ts"
		},
		"./linux": {
			"types": "./types/generated/linux/index.d.ts",
			"linux": "./src/linux/index.ts"
		},
		"./theme/tokens.css": "./src/theme/tokens.css",
		"./theme/chrome.css": "./src/theme/chrome.css",
		"./parity": {
			"types": "./types/generated/parity/index.d.ts",
			"default": "./dist/parity/index.js"
		},
		"./parity/check-helpers": {
			"types": "./types/generated/parity/check-helpers.d.ts",
			"default": "./dist/parity/check-helpers.js"
		},
		"./routing/core": {
			"types": "./types/generated/routing/core.d.ts",
			"default": "./src/routing/core.ts"
		},
		"./nativescript/keyboard": {
			"types": "./types/generated/nativescript/keyboard.d.ts",
			"native": "./src/nativescript/keyboard.ts"
		},
		"./routing/web-host": {
			"types": "./types/generated/routing/web-host.web.d.ts",
			"default": "./src/routing/web-host.web.ts"
		}
	},
	"scripts": {
		"prepack": "node ../../scripts/sync-ui-barrels.ts --check && pnpm build && pnpm typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"test": "vitest run --config vitest.config.mts",
		"test:native": "node --test tests/windows-segmented.test.mjs tests/windows-radio.test.mjs tests/windows-radio-control.test.mjs tests/windows-slider.test.mjs tests/windows-slider-control.test.mjs tests/windows-use-measure.test.mjs tests/windows-checkbox-list.test.mjs tests/windows-checkbox.test.mjs tests/windows-switch.test.mjs tests/windows-scrollable-area.test.mjs tests/windows-layer-focus.test.mjs tests/windows-modal-overlay.test.mjs tests/windows-text-write.test.mjs tests/windows-media-query.test.mjs tests/windows-gradient.test.mjs tests/keyboard-types.test.mjs tests/svg-source.android.test.mjs tests/keyboard-inset.test.mjs tests/liquid-glass.ios.test.mjs tests/svg-measure.ios.test.mjs tests/svg-measure.android.test.mjs tests/animated-value.test.mjs tests/tap-to-blur.ios.test.mjs tests/list-viewability-observer.ios.test.mjs tests/bottom-sheet-service.macos.test.mjs tests/color-scheme.macos.test.mjs tests/query-storage.macos.test.mjs && vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target ui",
		"pack:check": "tsrx-typegen --pack-check",
		"test:scroll:macos": "node ../../scripts/probe.ts run tests/fixtures/scrollable-area.macos.tsrx --target macos",
		"test:layer:web": "node --test tests/layer-position.web.mjs",
		"test:macos-exports": "node --test tests/macos-value-exports.test.mjs",
		"test:macos": "node --test tests/macos-value-exports.test.mjs tests/query-storage.macos.test.mjs tests/table-universal.test.mjs && node tests/thumbhash.macos.test.mjs && node tests/macos-barrel.mjs && node tests/packed-consumer.mjs --macos-only",
		"test:chat:web": "node ../../scripts/probe.ts run tests/fixtures/chat.web.tsrx --target web",
		"test:color:web": "node ../../scripts/probe.ts run tests/fixtures/color-picker.web.tsrx --target web",
		"test:color:ios": "node ../../scripts/probe.ts run tests/fixtures/color-picker.ios.tsrx --target ios",
		"test:color:android": "node ../../scripts/probe.ts run tests/fixtures/color-picker.android.tsrx --target android",
		"test:color:macos": "node ../../scripts/probe.ts run tests/fixtures/color-picker.macos.tsrx --target macos",
		"test:chat:ios": "node ../../scripts/probe.ts run tests/fixtures/chat.ios.tsrx --target ios",
		"test:chat:android": "node ../../scripts/probe.ts run tests/fixtures/chat.android.tsrx --target android",
		"test:chat:macos": "node ../../scripts/probe.ts run tests/fixtures/chat.macos.tsrx --target macos",
		"test:chat:short:web": "node ../../scripts/probe.ts run tests/fixtures/chat-short.web.tsrx --target web",
		"test:chat:external:web": "node ../../scripts/probe.ts run tests/fixtures/chat-external.web.tsrx --target web",
		"test:overlay-keyboard:web": "node ../../scripts/probe.ts run tests/fixtures/overlay-keyboard.web.tsrx --target web",
		"test:overlay-keyboard:ios": "node ../../scripts/probe.ts run tests/fixtures/overlay-keyboard.ios.tsrx --target ios",
		"test:overlay-keyboard:android": "node ../../scripts/probe.ts run tests/fixtures/overlay-keyboard.android.tsrx --target android",
		"test:overlay-keyboard:macos": "node ../../scripts/probe.ts run tests/fixtures/overlay-keyboard.macos.tsrx --deps @octane-xplat/sheet --target macos",
		"build": "tsc -p tsconfig.node.json",
		"test:intl": "node --test tests/intl-bundle.test.mjs",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.types.json"
	},
	"dependencies": {
		"@octane-xplat/camera": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"jsdom": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	}
}
