{
	// Package source is consumed as raw .ts (exports map → ./src/*), so
	// consumer dev transforms resolve THIS directory's nearest tsconfig.json.
	// Vendored plugin files use decorators (@CSSType/@NativeClass) — without
	// experimentalDecorators the transform emits TC39 `export @dec class`,
	// which the device V8 cannot parse — SyntaxError at boot.
	// This file ships with the source. Keep transform options self-contained:
	// installed consumers do not have this repository's tsconfig.base.json.
	"compilerOptions": {
		"target": "ES2020",
		"jsx": "preserve",
		"verbatimModuleSyntax": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmitHelpers": true
	}
}
