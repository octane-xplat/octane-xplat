{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleSuffixes": [".ios", ".android", ".mobile", ""],
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated"
	},
	"include": [
		"src/references.d.ts",
		"src/vendor/ui-svg/src/index.ts",
		"src/*.ts",
		"src/*.tsrx",
		"src/*/index.ts"
	],
	"exclude": ["src/*.macos.*", "src/*.linux.*", "src/*.windows.*", "**/*.test.*"],
	"files": ["src/index.linux.ts"]
}
