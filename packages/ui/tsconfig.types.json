{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/references.d.ts",
		"src/vendor/ui-svg/src/index.ts",
		"src/*.ts",
		"src/*.tsrx",
		"src/*/index.ts"
	],
	"exclude": [
		"**/*.test.*"
	]
}
