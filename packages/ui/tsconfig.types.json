{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/references.d.ts",
		"type-support/*.d.ts",
		"src/vendor/ui-svg/src/index.ts",
		"src/*.ts",
		"src/*.tsrx",
		"src/components/**/*.ts",
		"src/components/**/*.tsrx",
		"src/internal/**/*.ts",
		"src/internal/**/*.tsrx",
		"src/chat/**/*.ts",
		"src/chat/**/*.tsrx",
		"src/data/**/*.ts",
		"src/data/**/*.tsrx",
		"src/markdown/**/*.ts",
		"src/markdown/**/*.tsrx",
		"src/routing/**/*.ts",
		"src/routing/**/*.tsrx",
		"src/table/**/*.ts",
		"src/table/**/*.tsrx",
		"src/theme/**/*.ts",
		"src/theme/**/*.tsrx",
		"src/*/index.ts",
		"src/parity/*.ts",
		"src/nativescript/keyboard.ts",
		"src/*/index.*.ts",
		"src/routing/core.ts",
		"src/data/dev.ts",
		"src/routing/dev.ts",
		"src/routing/dev.web.ts",
		"src/routing/dev.macos.ts",
		"src/routing/dev-shared.ts",
		"src/routing/web-host.web.ts"
	],
	"exclude": [
		"**/*.test.*"
	]
}
