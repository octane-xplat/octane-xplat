{
	"name": "@octane-xplat/smooth-corners",
	"version": "0.12.0",
	"description": "Exact-match smooth corners for Octane xplat — one generated curve (Rosenfeld continuous, Figma squircle, superellipse, clothoid) clipped natively on web, iOS, Android, and macOS",
	"keywords": [
		"clip-path",
		"corner-smoothing",
		"cross-platform",
		"nativescript",
		"octane",
		"smooth-corners",
		"squircle",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/smooth-corners",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/smooth-corners"
	},
	"files": [
		"dist",
		"types",
		"src"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./types/index.d.ts",
				"macos": "./src/index.macos.ts",
				"web": "./dist/web/index.js",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test tests/*.test.mjs",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.check.json && tsrx-tsc --noEmit -p tsconfig.check.web.json && tsrx-tsc --noEmit -p tsconfig.check.macos.json"
	},
	"dependencies": {
		"@lisse/core": "0.7.2"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"octane": "0.11.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
