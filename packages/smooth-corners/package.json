{
	"name": "@octane-xplat/smooth-corners",
	"version": "0.20.0",
	"description": "Shared smooth-corner geometry with native surface painting and optional child clipping for web, iOS, Android and AppKit macOS",
	"keywords": [
		"clip-path",
		"corner-smoothing",
		"cross-platform",
		"nativescript",
		"octane",
		"smooth-corners",
		"squircle",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/smooth-corners",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/smooth-corners"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"types": "./types/generated/index.d.ts",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target smooth-corners",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test tests/*.test.mts",
		"test:e2e": "node e2e/overflow.web.mts",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test:android": "node tests/run-native.mts android",
		"test:ios": "node tests/run-native.mts ios",
		"test:macos-runtime": "node tests/run-native.mts macos",
		"test:packed:web": "node tests/packed.web.mts",
		"test:android-input": "node tests/android-input.mts"
	},
	"dependencies": {
		"@lisse/core": "0.7.3",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@nativescript/core": "catalog:",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/css-engine": "workspace:*",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@octane-xplat/nativescript-mason-core": "1.0.0-beta.12",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"octane": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@octane-xplat/nativescript-mason-core": ">=1.0.0-beta.12 <2",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@octane-xplat/nativescript-mason-core": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
