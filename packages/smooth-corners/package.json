{
	"name": "@octane-xplat/smooth-corners",
	"version": "0.21.0",
	"description": "Exact-match smooth corners for Octane xplat \u2014 one generated curve (Rosenfeld continuous, Figma squircle, superellipse, clothoid) painted natively with optional child clipping on web, iOS, Android, and macOS",
	"keywords": [
		"clip-path",
		"corner-smoothing",
		"cross-platform",
		"nativescript",
		"octane",
		"smooth-corners",
		"squircle",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/smooth-corners",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/smooth-corners"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target smooth-corners",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test tests/*.test.mts",
		"test:e2e": "node e2e/overflow.web.mts",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"dependencies": {
		"@lisse/core": "0.7.3",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/css-engine": "workspace:*",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
