{
	"name": "@octane-xplat/smooth-corners",
	"version": "0.16.0",
	"description": "Exact-match smooth corners for Octane xplat — one generated curve (Rosenfeld continuous, Figma squircle, superellipse, clothoid) clipped natively on web, iOS, Android, and macOS",
	"keywords": [
		"clip-path",
		"corner-smoothing",
		"cross-platform",
		"nativescript",
		"octane",
		"smooth-corners",
		"squircle",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/smooth-corners",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/smooth-corners"
	},
	"files": [
		"types",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test tests/*.test.mjs",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"dependencies": {
		"@lisse/core": "0.7.2"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
