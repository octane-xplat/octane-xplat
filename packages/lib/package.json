{
	"name": "@octane-xplat/lib",
	"version": "0.14.0",
	"description": "Internal, unstable shared utilities for Octane xplat. Breaking changes may occur at any time; external use is discouraged.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lib"
	},
	"files": [
		"src",
		"dist",
		"types",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./types/generated/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typegen": "tsc -p tsconfig.build.json --emitDeclarationOnly",
		"typecheck": "tsc -p tsconfig.json",
		"prepack": "pnpm build",
		"test": "node --test tests/*.test.mjs",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	}
}
