{
	"name": "@octane-xplat/lib",
	"version": "0.19.0",
	"description": "Internal, unstable shared utilities for Octane xplat. Breaking changes may occur at any time; external use is discouraged.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lib"
	},
	"files": [
		"src",
		"dist",
		"types",
		"README.md",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./route-pattern": {
			"types": "./types/generated/route-pattern.d.ts",
			"default": "./dist/route-pattern.js"
		},
		"./server-boundary": {
			"types": "./types/generated/server-boundary.d.ts",
			"default": "./dist/server-boundary.js"
		},
		"./capability": {
			"types": "./types/generated/capability.d.ts",
			"default": "./dist/capability.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"prepack": "bun run typegen",
		"test": "node --test tests/*.test.mjs",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"devDependencies": {
		"typescript": "catalog:"
	}
}
