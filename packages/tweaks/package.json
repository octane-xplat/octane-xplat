{
	"name": "@octane-xplat/tweaks",
	"version": "0.20.0",
	"private": true,
	"description": "Live-tweakable values for Octane Xplat apps — edited from a dev panel, written back to source on Save",
	"keywords": [
		"devtools",
		"octane",
		"tweaks",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/tweaks",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/tweaks"
	},
	"files": [
		"types",
		"src",
		"dist",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./protocol": {
			"types": "./types/generated/protocol.d.ts",
			"default": "./src/protocol.ts"
		},
		"./dev": {
			"types": "./types/generated/dev.d.ts",
			"web": "./src/dev.web.ts",
			"native": "./src/dev.ts",
			"default": "./src/dev.ts"
		},
		"./vite": {
			"types": "./types/generated/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run typegen && tsc --runExternalCode -p tsconfig.vite.build.json",
		"typegen": "tsc --runExternalCode -p tsconfig.types.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "node --test test/"
	},
	"dependencies": {
		"@octane-xplat/devtools": "workspace:*",
		"@tsrx/oxc": "0.20.0",
		"magic-string": "1.4.5"
	},
	"peerDependencies": {
		"octane": ">=0.14.0 <1",
		"vite": ">=5",
		"@bamboocss/node": ">=1.56"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@bamboocss/node": "1.60.1"
	},
	"peerDependenciesMeta": {
		"@bamboocss/node": {
			"optional": true
		}
	}
}
