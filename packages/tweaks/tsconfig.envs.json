{
	"contentMappers": [
		{
			"package": "@tsrx/content-mapper",
			"extensions": [
				".tsrx"
			]
		}
	],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": [
			"node"
		],
		"lib": [
			"ESNext"
		]
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.tsrx"
			],
			"compilerOptions": {
				"lib": [
					"ESNext",
					"DOM",
					"DOM.Iterable"
				]
			}
		},
		"macos": {
			"include": [
				"src/devtools/**/*.ts",
				"src/devtools/**/*.tsrx"
			]
		}
	}
}
