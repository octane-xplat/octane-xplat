{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "types/generated",
		"rootDir": "src",
		"noEmitHelpers": false
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["src/**/*.test.*"]
}
