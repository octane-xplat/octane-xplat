{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"lib": [
			"esnext",
			"dom"
		],
		"jsx": "preserve",
		"jsxImportSource": "octane",
		"allowImportingTsExtensions": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"rootDir": "src",
		"outDir": "types"
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsrx"
	]
}
