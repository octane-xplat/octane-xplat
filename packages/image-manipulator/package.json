{
	"name": "@octane-xplat/image-manipulator",
	"version": "0.20.0",
	"description": "Expo-shaped image transformation and encoding for Octane Xplat",
	"keywords": [
		"crop",
		"cross-platform",
		"image",
		"nativescript",
		"octane",
		"resize"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/image-manipulator",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/image-manipulator"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"!src/**/*.test.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.macos.ts",
			"linux": "./src/index.linux.ts",
			"windows": "./src/index.windows.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run tests/core.test.ts",
		"test:browser": "node tests/browser.web.mjs",
		"test:macos-runtime": "node tests/macos-runtime.mjs",
		"test:ios-runtime": "node tests/ios-runtime.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	}
}
