{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/image-manipulator": ["../../../src/index.ts"] },
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"types": ["@nativescript/types"]
	},
	"environments": {
		"web": {
			"include": ["src/**/*.ts", "src/**/*.tsx", "../../examples/media/crop-image.ts", "../../examples/media/encode-webp.ts", "tests/hook.web.tsx"],
			"exclude": ["src/**/*.ios.ts", "src/**/*.android.ts", "src/**/*.macos.ts"]
		},
		"native": {
			"include": ["src/**/*.ts", "src/**/*.tsx", "tests/runtime.ios.ts"],
			"exclude": ["src/**/*.web.ts", "src/**/*.macos.ts"]
		},
		"macos": { "include": ["src/index.macos.ts", "src/**/*.macos.ts"] },
		"gtk": { "include": ["src/index.linux.ts"] },
		"windows": { "include": ["src/index.windows.ts"] }
	}
}
