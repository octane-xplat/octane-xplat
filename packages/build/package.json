{
	"name": "@octane-xplat/build",
	"version": "0.19.0",
	"description": "Project-installed Vite presets and build plugins for Octane Xplat",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/build"
	},
	"type": "module",
	"files": ["dist", "LICENSE", "README.md"],
	"exports": {
		"./worker": "./dist/build-worker.js",
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./macos/vite": {
			"types": "./dist/macos/vite.d.ts",
			"default": "./dist/macos/vite.js"
		},
		"./linux-gtk/vite": {
			"types": "./dist/linux-gtk/vite.d.ts",
			"default": "./dist/linux-gtk/vite.js"
		}
	},
	"engines": { "node": ">=22.22.2" },
	"publishConfig": { "access": "public" },
	"scripts": {
		"build": "vite build --config vite.package.config.ts",
		"prepack": "bun run build",
		"typecheck": "tsrx-tsc -p tsconfig.json",
		"test:packed": "node ../../tools/cli-go/build-tools-consumer.mjs"
	},
	"dependencies": {
		"jsonc-parser": "3.3.1",
		"yaml": "2.9.1",
		"ignore": "7.0.14",
		"marked": "18.1.2",
		"@babel/core": "8.0.9",
		"@babel/plugin-transform-unicode-property-regex": "8.0.1",
		"@babel/plugin-transform-unicode-sets-regex": "8.0.1",
		"@octane-xplat/lib": "workspace:*",
		"@tsrx/core": "0.5.5",
		"postcss": "8.5.32",
		"postcss-load-config": "6.0.1"
	},
	"peerDependencies": { "vite": "^8.3.0", "create-octane-xplat": "*", "wawoff2": "2.0.1" },
	"peerDependenciesMeta": { "create-octane-xplat": { "optional": true }, "wawoff2": { "optional": true } },
	"devDependencies": {
		"create-octane-xplat": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@types/node": "26.6.6",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
