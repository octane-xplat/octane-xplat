{
	"name": "@octane-xplat/mcp",
	"version": "0.0.0",
	"description": "MCP server for Octane Xplat consumer apps — project identity, capability discovery, permission and evidence contracts.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/mcp"
	},
	"bin": {
		"xplat-mcp": "./src/xplat-mcp.mjs"
	},
	"files": [
		"src",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./contracts": {
			"types": "./src/contracts/index.d.ts",
			"default": "./src/contracts/index.mjs"
		},
		"./contracts/*": {
			"types": "./src/contracts/*.d.ts",
			"default": "./src/contracts/*.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "node src/xplat-mcp.mjs",
		"test": "node --test tests/*.test.mjs",
		"test:consumer": "node tests/consumer-workflow.mjs",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.31.0",
		"@octane-xplat/cli": "workspace:*",
		"yaml": "2.9.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	}
}
