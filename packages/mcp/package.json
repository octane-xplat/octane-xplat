{
	"name": "@octane-xplat/mcp",
	"version": "0.18.0",
	"description": "MCP server for Octane Xplat consumer apps — project identity, capability discovery, permission and evidence contracts.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/mcp"
	},
	"bin": {
		"xplat-mcp": "./dist/xplat-mcp.js"
	},
	"files": [
		"src",
		"types",
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./contracts": {
			"types": "./types/contracts/index.d.ts",
			"default": "./dist/contracts/index.js"
		},
		"./contracts/*": {
			"types": "./types/contracts/*.d.ts",
			"default": "./dist/contracts/*.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "node src/xplat-mcp.ts",
		"build": "vite build",
		"prepack": "pnpm build",
		"test": "pnpm build && node --test tests/*.test.mjs",
		"test:consumer": "pnpm build && node tests/consumer-workflow.mjs",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.31.0",
		"@octane-xplat/cli": "workspace:*",
		"yaml": "2.9.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
