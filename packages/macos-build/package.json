{
	"name": "@octane-xplat/macos-build",
	"version": "0.19.0",
	"description": "Project-installed macOS packaging worker for the Octane Xplat CLI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/macos-build"
	},
	"type": "module",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		"./worker": "./dist/macos/package-worker.js",
		"./doctor-worker": "./dist/macos/doctor-worker.js",
		"./dev-worker": "./dist/macos/dev-worker.js"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build --config vite.package.config.ts",
		"prepack": "bun run build",
		"typecheck": "tsc -p tsconfig.json",
		"test:packed": "node ../../tools/cli-nim/macos-build-consumer.mjs"
	},
	"peerDependencies": {
		"vite": "^8.3.0"
	},
	"devDependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@types/node": "24.10.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
