{
  "name": "@octane-xplat/audio",
  "version": "0.1.0",
  "description": "Long-form audio playback for Octane xplat",
  "files": [
    "dist",
    "types",
    "src",
    "platforms"
  ],
  "type": "module",
  "exports": {
    ".": {
      "web": "./src/index.web.ts",
      "native": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./types/index.d.ts",
        "web": "./dist/web/index.js",
        "native": "./dist/native/index.js",
        "default": "./dist/native/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && vite build --mode native && tsc -p tsconfig.types.json && node ../../scripts/check-native-dist.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@nativescript-community/octane": "0.2.1",
    "@nativescript/core": "9.1.2",
    "@octanejs/vite-plugin": "0.1.61",
    "octane": "0.6.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "@nativescript-community/octane": ">=0.2.1 <1",
    "@nativescript/core": ">=9.1.0 <10",
    "octane": ">=0.6.3 <1"
  },
  "peerDependenciesMeta": {
    "@nativescript-community/octane": {
      "optional": true
    },
    "@nativescript/core": {
      "optional": true
    },
    "octane": {
      "optional": true
    }
  },
  "nativescript": {
    "platforms": {
      "android": "9.1.0",
      "ios": "9.1.0"
    }
  }
}
