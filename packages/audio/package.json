{
	"name": "@octane-xplat/audio",
	"version": "0.20.0",
	"description": "Long-form audio playback for Octane xplat",
	"keywords": [
		"android",
		"audio",
		"audio-player",
		"cross-platform",
		"ios",
		"music",
		"nativescript",
		"octane",
		"playback",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/audio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/audio"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/*.test.mts",
		"typegen": "tsrx-typegen --target audio",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"pack:check": "tsrx-typegen --pack-check",
		"test:macos-runtime": "node tests/packed-consumer.mts --macos-runtime",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test:runtime": "node tests/runtime.mts",
		"test:browser": "node tests/browser.mts",
		"test:macos-budgets": "node tests/profile-macos.mts"
	},
	"dependencies": {
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"playwright": "1.63.0",
		"@tsrx/content-mapper": "catalog:",
		"typescript-classic": "catalog:"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"AVFoundation",
				"CoreMedia"
			]
		}
	},
	"types": "./types/generated/index.d.ts"
}
