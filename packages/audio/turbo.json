{
	"extends": [
		"//"
	],
	"tasks": {
		"test:runtime": {
			"dependsOn": [
				"typegen",
				"^typegen",
				"@octane-xplat/cli#build",
				"@octane-xplat/bamboo#typegen"
			],
			"cache": false,
			"passThroughEnv": [
				"ANDROID_HOME",
				"ANDROID_SDK_ROOT",
				"JAVA_HOME",
				"GRADLE_USER_HOME",
				"ANDROID_ADB_SERVER_PORT",
				"ADB_SERVER_SOCKET",
				"XPLAT_IOS_DEVELOPMENT_TEAM"
			]
		},
		"test:browser": {
			"dependsOn": [
				"typegen",
				"^typegen"
			],
			"cache": false
		}
	}
