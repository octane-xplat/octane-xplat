{
	"name": "@octane-xplat/pretext",
	"version": "0.21.0",
	"description": "Cross-platform text measurement and layout adapter for Pretext",
	"keywords": [
		"cross-platform",
		"octane",
		"pretext",
		"text-layout",
		"text-measurement",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/pretext",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/pretext"
	},
	"files": [
		"dist",
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./dist/index.macos.js",
			"linux": "./dist/index.gtk.js",
			"gtk": "./dist/index.gtk.js",
			"windows": "./dist/index.windows.js",
			"web": "./dist/index.web.js",
			"browser": "./dist/index.web.js",
			"native": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./rich-inline": {
			"types": "./types/generated/rich-inline.d.ts",
			"macos": "./dist/rich-inline.macos.js",
			"linux": "./dist/rich-inline.gtk.js",
			"gtk": "./dist/rich-inline.gtk.js",
			"windows": "./dist/rich-inline.windows.js",
			"web": "./dist/rich-inline.web.js",
			"browser": "./dist/rich-inline.web.js",
			"native": "./dist/rich-inline.js",
			"default": "./dist/rich-inline.js"
		}
	},
	"types": "./types/generated/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target pretext",
		"build": "bun run typegen && tsc --runExternalCode -p tsconfig.build.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"prepack": "bun run build",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@chenglou/pretext": "1.0.0",
		"@formatjs/intl-getcanonicallocales": "3.3.0",
		"@formatjs/intl-locale": "5.4.1",
		"@formatjs/intl-segmenter": "12.3.0",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/nativescript-octane": "workspace:*",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	}
}
