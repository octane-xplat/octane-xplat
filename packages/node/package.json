{
	"name": "@octane-xplat/node",
	"version": "0.20.0",
	"private": true,
	"description": "Experimental, opt-in Node builtin modules for Octane Xplat",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/node"
	},
	"files": ["dist", "types", "NOTICE.md", "vendor/licenses", "vendor/ns-node/provenance.json"],
	"exports": {
		".": { "types": "./types/generated/index.d.ts", "default": "./dist/index.js" },
		"./events": { "types": "./types/generated/events.d.ts", "default": "./dist/events.js" },
		"./util": { "types": "./types/generated/util.d.ts", "default": "./dist/util.js" },
		"./assert": { "types": "./types/generated/assert.d.ts", "default": "./dist/assert.js" },
		"./buffer": { "types": "./types/generated/buffer.d.ts", "default": "./dist/buffer.js" },
		"./querystring": { "types": "./types/generated/querystring.d.ts", "default": "./dist/querystring.js" },
		"./stream": { "types": "./types/generated/stream.d.ts", "default": "./dist/stream.js" },
		"./install": { "types": "./types/generated/install.d.ts", "default": "./dist/install.js" },
		"./vite": { "types": "./types/generated/vite.d.ts", "default": "./dist/vite.js" },
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vite build --config vite.engine.config.ts && tsc --runExternalCode -p tsconfig.build.json",
		"typegen": "node scripts/typegen.mjs",
		"typecheck": "tsc --runExternalCode -p tsconfig.json && tsc --runExternalCode -p tests/tsconfig.json",
		"test": "node --test tests/*.test.mts",
		"test:web": "node tests/browser.mts",
		"test:macos": "node tests/macos.mts",
		"test:ios": "node tests/ios.mts"
	},
	"dependencies": {
		"abort-controller": "3.0.0",
		"buffer": "6.0.3",
		"process": "0.11.10",
		"readable-stream": "4.8.0",
		"@types/readable-stream": "4.0.25"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"playwright": "1.63.0",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": { "vite": "^8.3.0" },
	"peerDependenciesMeta": { "vite": { "optional": true } }
}
