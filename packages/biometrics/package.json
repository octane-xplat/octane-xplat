{
	"name": "@octane-xplat/biometrics",
	"version": "0.20.0",
	"description": "Biometric verification (FaceID/TouchID/fingerprint) for Octane xplat \u2014 matching web + NativeScript implementations",
	"keywords": [
		"android",
		"biometrics",
		"cross-platform",
		"faceid",
		"fingerprint",
		"ios",
		"nativescript",
		"octane",
		"touchid",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/biometrics",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/biometrics"
	},
	"files": [
		"src",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:packed": "node tests/packed-consumer.mts",
		"test": "node --test tests/*.test.mts",
		"test:macos-runtime": "node ../../apps/macos/test/verify-biometrics.mts",
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/biometrics": "1.3.1",
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"typescript-classic": "catalog:"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
