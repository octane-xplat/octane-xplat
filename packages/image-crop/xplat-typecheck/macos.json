{
	"extends": "../tsconfig.envs.json",
	"files": [
		"../../cli/src/typecheck-globals/macos.d.ts",
		"../src/Gesture.macos.tsrx",
		"../src/Guide.macos.tsrx",
		"../src/ImageCrop.tsrx",
