{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"paths": {
			"@octane-xplat/image-crop": ["../src/index.ts"],
			"octane": ["../node_modules/octane"],
			"octane/jsx-runtime": ["../node_modules/octane/dist/jsx-runtime.d.ts"],
			"@octane-xplat/ui": [
				"../ui/types/generated/index.d.ts"
			]
		},
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/media/crop-selection.tsrx",
				"../../examples/probes/image-crop-selection.tsrx"
			],
			"exclude": [
				"src/**/*.test.*",
				"src/**/*.macos.*"
			]
		},
		"native": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/media/crop-selection.tsrx",
				"../../examples/probes/image-crop-selection.tsrx"
			],
			"exclude": [
				"src/**/*.test.*",
				"src/**/*.macos.*"
			]
		},
		"macos": {
			"include": [
				"src/index.macos.ts",
				"src/**/*.macos.tsrx",
				"src/ImageCrop.tsrx",
				"tests/*.macos.tsrx"
			]
		}
	}
}
