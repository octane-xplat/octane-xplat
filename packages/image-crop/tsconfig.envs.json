{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"paths": {
			"@octane-xplat/ui": [
				"../ui/types/generated/index.d.ts"
			]
		},
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*",
				"src/**/*.macos.*"
			]
		},
		"native": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*",
				"src/**/*.macos.*"
			]
		},
		"macos": {
			"include": [
				"src/index.macos.ts",
				"src/**/*.macos.tsrx",
				"src/ImageCrop.tsrx",
				"tests/*.macos.tsrx"
			]
		}
	}
}
