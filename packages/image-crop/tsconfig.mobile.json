{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "@nativescript-community/octane",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true,
		"customConditions": ["native"],
		"paths": {
			"@octane-xplat/ui": ["../ui/types/generated/index.d.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsrx", "examples/**/*.tsrx"],
	"exclude": ["src/**/*.test.*", "src/**/*.macos.*"]
}
