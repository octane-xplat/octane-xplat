{
	"name": "@octane-xplat/media",
	"version": "0.19.0",
	"description": "Image picking and OS camera capture for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"camera",
		"cross-platform",
		"image-picker",
		"ios",
		"media",
		"nativescript",
		"octane",
		"photo",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/media",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/media"
	},
	"files": [
		"src",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"test:macos-runtime": "node tests/macos-runtime.mjs",
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/camera": "7.0.0",
		"@nativescript/imagepicker": "5.0.0",
		"@octane-xplat/camera": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
