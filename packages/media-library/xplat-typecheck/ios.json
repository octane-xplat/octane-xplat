		],
		"moduleSuffixes": [
			".ios",
			".mobile",
			".native",
			""
		],
		"customConditions": [
			"ios",
			"native"
		],
		"lib": [
			"ESNext"
		]
	},
	"include": [],
	"exclude": []
}
