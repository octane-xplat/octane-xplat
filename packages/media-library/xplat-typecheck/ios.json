{
	"extends": "../tsconfig.envs.json",
	"files": [
		"../../cli/src/typecheck-globals/native.d.ts",
		"../src/backend-types.ts",
		"../src/backend.ios.ts",
		"../src/backend.photos.ts",
		"../src/core.ts",
		"../src/index.ts",
		"../src/observer.photos.ts",
		"../src/photos-runtime-types.ts",
		"../src/photos-runtime.ios.ts",
		"../src/types.ts",
		"../src/unsupported.ts",
		"../src/use-permissions.tsx",
		"../tests/runtime.ios.ts",
		"./isolation-ios.ts"
	],
	"compilerOptions": {
		"paths": {
			"@octane-xplat/media-library": [
				"../src/index.ts"
			],
			"@octane-xplat/image-manipulator": [
				"../../image-manipulator/types/generated/index.d.ts"
			]
		},
		"resolveJsonModule": true,
