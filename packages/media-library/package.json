{
	"name": "@octane-xplat/media-library",
	"version": "0.18.0",
	"description": "Expo-shaped device media library queries, assets and albums for Octane Xplat",
	"keywords": [
		"albums",
		"cross-platform",
		"media-library",
		"nativescript",
		"octane",
		"photos"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/media-library",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/media-library"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"!src/**/*.test.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.macos.ts",
			"linux": "./src/index.linux.ts",
			"windows": "./src/index.windows.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"test:ios-runtime": "node tests/ios-runtime.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:macos-feasibility": "node tests/macos-feasibility.mjs"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/image-manipulator": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"jsdom": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	}
}
