{
	"name": "@octane-xplat/jsx",
	"version": "0.16.1",
	"description": "Shared native JSX type contract for Octane xplat — one intrinsic element vocabulary for the NativeScript and AppKit drivers, with DOM types exposed separately",
	"keywords": [
		"android",
		"appkit",
		"ios",
		"jsx",
		"jsx-runtime",
		"macos",
		"nativescript",
		"octane",
		"types",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/jsx",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/jsx"
	},
	"files": [
		"src",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./jsx-runtime": {
			"types": {
				"gtk": "./src/gtk.d.ts",
				"macos": "./src/macos.d.ts",
				"native": "./src/native.d.ts",
				"default": "./src/jsx-runtime.d.ts"
			}
		},
		"./jsx-dev-runtime": {
			"types": {
				"gtk": "./src/gtk.d.ts",
				"macos": "./src/macos.d.ts",
				"native": "./src/native.d.ts",
				"default": "./src/jsx-runtime.d.ts"
			}
		},
		"./intrinsics": {
			"types": {
				"gtk": "./src/gtk.d.ts",
				"macos": "./src/macos.d.ts",
				"native": "./src/native.d.ts",
				"default": "./src/intrinsics.d.ts"
			}
		},

		"./dom": {
			"types": "./src/dom/index.d.ts"
		},
		"./dom/jsx-runtime": {
			"types": "./src/dom/jsx-runtime.d.ts"
		},
		"./dom/jsx-dev-runtime": {
			"types": "./src/dom/jsx-runtime.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"devDependencies": {
		"@nativescript/core": "9.1.2",
		"@nativescript/types": "catalog:",
		"octane": "0.6.3",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	}
}
