{
	"targets": {
		"package": {
			"renderer": "@octane-xplat/jsx",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.ts",
						"./src/index.macos.ts"
					],
					"types": [
						"./types/generated/index.d.ts"
					]
				},
				"./*": {
					"source": "src/index.ts",
					"runtime": "./src/*",
					"types": "./types/generated/*.d.ts"
				},
				"./*.ts": {
					"source": "src/index.ts",
					"runtime": "./src/*.ts",
					"types": "./types/generated/*.d.ts"
				},
				"./*.tsrx": {
					"source": "src/index.ts",
					"runtime": "./src/*.tsrx",
					"types": "./types/generated/*.d.ts"
				}
			}
		}
	}
}
