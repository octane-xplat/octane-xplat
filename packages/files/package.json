{
	"name": "@octane-xplat/files",
	"version": "0.7.2",
	"description": "Native + web file pick and read/write for Octane xplat \u2014 matching web + NativeScript implementations",
	"keywords": [
		"octane",
		"xplat",
		"cross-platform",
		"files",
		"document-picker",
		"file-picker",
		"nativescript",
		"ios",
		"android",
		"web"
	],
	"license": "MIT",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/files",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/files"
	},
	"files": [
		"src"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": "./src/index.macos.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@nativescript-community/ui-document-picker": "1.1.29"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"octane": "0.6.3"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
