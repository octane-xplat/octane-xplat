{
	"name": "@octane-xplat/files",
	"version": "0.11.0",
	"description": "Native + web file pick and read/write for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"cross-platform",
		"document-picker",
		"file-picker",
		"files",
		"ios",
		"nativescript",
		"octane",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/files",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/files"
	},
	"files": [
		"src",
		"types"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.macos.d.ts",
					"default": "./src/index.macos.ts"
				},
				"types": "./types/index.d.ts",
				"default": "./src/index.ts"
			},
			"./*": "./src/*"
		},
		"access": "public"
	},
	"scripts": {
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@nativescript-community/ui-document-picker": "1.1.29",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@nativescript/types": "9.0.0",
		"@octane-xplat/ui": "workspace:*",
		"octane": "0.6.3"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
