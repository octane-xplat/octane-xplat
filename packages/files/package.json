{
	"name": "@octane-xplat/files",
	"version": "0.12.0",
	"description": "Native + web file pick and read/write for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"cross-platform",
		"document-picker",
		"file-picker",
		"files",
		"ios",
		"nativescript",
		"octane",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/files",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/files"
	},
	"files": [
		"dist",
		"src",
		"types"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.macos.d.ts",
					"default": "./src/index.macos.ts"
				},
				"linux": "./dist/linux/index.js",
				"types": "./types/index.d.ts",
				"web": "./dist/web/index.js",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			},
			"./*": {
				"linux": "./dist/linux/*.js",
				"types": "./src/*.ts",
				"web": "./dist/web/*.js",
				"native": "./dist/native/*.js",
				"default": "./dist/native/*.js"
			},
			"./*.ts": {
				"types": "./src/*.ts",
				"default": "./dist/native/*.js"
			},
			"./*.web.ts": {
				"types": "./src/*.web.ts",
				"default": "./dist/web/*.js"
			},
			"./*.macos.ts": "./src/*.macos.ts",
			"./*.linux.ts": {
				"types": "./src/*.linux.ts",
				"default": "./dist/linux/*.js"
			},
			"./*.tsrx": {
				"types": "./src/*.tsrx",
				"default": "./dist/native/*.js"
			},
			"./*.web.tsrx": {
				"types": "./src/*.web.tsrx",
				"default": "./dist/web/*.js"
			},
			"./*.macos.tsrx": "./src/*.macos.tsrx",
			"./*.linux.tsrx": {
				"types": "./src/*.linux.tsrx",
				"default": "./dist/linux/*.js"
			},
			"./*.web": "./dist/web/*.js",
			"./*.macos": "./src/*.macos.ts",
			"./*.linux": "./dist/linux/*.js"
		},
		"access": "public"
	},
	"scripts": {
		"test:packed": "node tests/packed-consumer.mjs",
		"build": "vite build && vite build --mode native && vite build --mode linux && node ../../scripts/check-native-dist.mjs",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@nativescript-community/ui-document-picker": "1.1.29",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@nativescript/types": "9.1.4",
		"@octane-xplat/ui": "workspace:*",
		"octane": "0.10.2",
		"@octanejs/vite-plugin": "0.1.61",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
