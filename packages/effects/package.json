{
	"name": "@octane-xplat/effects",
	"version": "0.9.0",
	"description": "Platform view-effect shaders for Octane xplat — iOS stitchable Metal via @nativescript/swift-ui, Android AGSL RuntimeShader",
	"keywords": [
		"agsl",
		"android",
		"cross-platform",
		"gpu",
		"ios",
		"metal",
		"nativescript",
		"octane",
		"shader",
		"view-effects",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/effects",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/effects"
	},
	"files": [
		"dist",
		"types",
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		"./ios": {
			"types": "./types/ios.d.ts",
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"types": "./types/android.d.ts",
			"native": "./src/android/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			"./ios": {
				"types": "./types/ios.d.ts",
				"native": "./dist/native/ios/index.js"
			},
			"./android": {
				"types": "./types/android.d.ts",
				"native": "./dist/native/android/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build --mode native && node ../../scripts/check-native-dist.mjs",
		"build:metal": "sh scripts/build-metal.sh",
		"check-types": "tsc -p tsconfig.types.json",
		"prepublishOnly": "pnpm build",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/swift-ui": "4.0.2"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.6.3",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "7.0.0",
			"android": "7.0.0"
		}
	}
}
