{
	"name": "@octane-xplat/effects",
	"version": "0.17.0",
	"description": "Platform view-effect shaders for Octane xplat — iOS stitchable Metal via @nativescript/swift-ui, Android AGSL RuntimeShader",
	"keywords": [
		"agsl",
		"android",
		"cross-platform",
		"gpu",
		"ios",
		"metal",
		"nativescript",
		"octane",
		"shader",
		"view-effects",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/effects",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/effects"
	},
	"files": [
		"types",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"web": "./src/index.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./ios": {
			"types": "./types/ios.d.ts",
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"types": "./types/android.d.ts",
			"native": "./src/android/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:metal": "sh scripts/build-metal.sh",
		"typecheck": "tsc -p tsconfig.types.json",
		"prepack": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/swift-ui": "4.0.2",
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "7.0.0",
			"android": "7.0.0"
		}
	}
}
