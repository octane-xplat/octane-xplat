{
	"name": "@octane-xplat/macos-renderer",
	"version": "0.11.1",
	"description": "Experimental AppKit renderer for Octane on macOS",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/macos-renderer"
	},
	"files": [
		"src",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./intrinsics": "./src/intrinsics.d.ts",
		"./jsx-runtime": {
			"types": "./src/jsx-runtime.d.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./src/jsx-runtime.d.ts"
		},
		"./compat/native-core": "./src/native-core-shim.ts",
		"./compat/escape-props": "./src/native-escape-props.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"test:overflow": "node ../../scripts/probe.mjs run test/fixtures/text-overflow.macos.tsrx --target macos",
		"test:packed": "node --experimental-strip-types test/packed-consumer.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@nativescript/macos-node-api": "0.4.4-next.2026-08-09-31292056208"
	},
	"peerDependencies": {
		"octane": ">=0.6.3 <1"
	}
}
