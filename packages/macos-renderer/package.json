{
	"name": "@octane-xplat/macos-renderer",
	"version": "0.18.0",
	"description": "Experimental AppKit renderer for Octane on macOS",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/macos-renderer"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"LICENSE"
	],
	"xplat": {
		"macos": {
			"prebuiltLibraries": [
				"platforms/macos/prebuilt/libxplatmason.dylib"
			],
			"notices": "platforms/macos/licenses/nativescript-mason.txt"
		}
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./intrinsics": "./src/intrinsics.d.ts",
		"./jsx-runtime": {
			"types": "./src/jsx-runtime.d.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./src/jsx-runtime.d.ts"
		},
		"./types": {
			"types": "./types/index.d.ts"
		},
		"./types/*": {
			"types": "./types/*.d.ts"
		},
		"./compat/native-core": "./src/native-core-shim.ts",
		"./compat/escape-props": "./src/native-escape-props.ts",
		"./compat/ns-core": "./src/ns-compat.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"test:gestures": "node ../../scripts/probe.ts run test/fixtures/gestures.macos.tsrx --target macos",
		"test:portals": "node ../../scripts/probe.ts run test/fixtures/portal-lifecycle.macos.tsrx --target macos",
		"test:overflow": "node ../../scripts/probe.ts run test/fixtures/text-overflow.macos.tsrx --target macos",
		"test:packed": "node --experimental-strip-types test/packed-consumer.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@nativescript/macos-node-api": "catalog:",
		"@nativescript/objc-node-api": "1.0.0-alpha.7",
		"@octane-xplat/css-engine": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"acorn": "8.15.0",
		"saxes": "6.0.0"
	},
	"devDependencies": {
		"octane": "catalog:"
	},
	"peerDependencies": {
		"octane": ">=0.6.3 <1"
	}
}
