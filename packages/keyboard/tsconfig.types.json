{
	"compilerOptions": {
		"strict": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"outDir": "types",
		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": [
		"src/types.ts",
		"src/props.ts",
		"src/focus-types.ts", "src/scroll-types.ts"
	]
}
