{
	"name": "@octane-xplat/barcode-scanner",
	"version": "0.18.0",
	"description": "Barcode and QR scanning for Octane xplat — ML Kit camera preview + still decode on iOS/Android, Vision still decode on macOS, BarcodeDetector on web",
	"keywords": [
		"android",
		"cross-platform",
		"nativescript",
		"octane",
		"xplat",
		"barcode",
		"qr",
		"scanner",
		"mlkit"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/barcode-scanner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/barcode-scanner"
	},
	"files": [
		"src",
		"platforms",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target octane",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test tests/*.test.ts",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"dependencies": {
		"@nativescript/mlkit-barcode-scanning": "3.0.4",
		"@nativescript/mlkit-core": "3.0.4",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	}
}
