{
	"name": "@octane-xplat/lexical",
	"version": "0.0.0",
	"description": "Unified rich-text editor facade for Octane xplat — live lexical on web/AppKit, Aztec + lexical document model on Android",
	"keywords": [
		"cross-platform",
		"editor",
		"lexical",
		"octane",
		"rich-text",
		"richtext",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/lexical",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lexical"
	},
	"files": [
		"dist",
		"types",
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"default": "./src/index.web.ts"
			},
			"native": {
				"default": "./src/index.ts"
			},
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.macos.d.ts",
					"default": "./src/index.macos.ts"
				},
				"web": {
					"types": "./types/index.d.ts",
					"default": "./dist/web/index.js"
				},
				"native": {
					"types": "./types/index.d.ts",
					"default": "./dist/native/index.js"
				},
				"types": "./types/index.d.ts",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && tsc -p tsconfig.types.json && node ../../scripts/check-native-dist.mjs && node ../richtext/build-browser.mjs",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@lexical/code": "0.51.0",
		"@lexical/extension": "0.51.0",
		"@lexical/html": "0.51.0",
		"@lexical/link": "0.51.0",
		"@lexical/list": "0.51.0",
		"@lexical/rich-text": "0.51.0",
		"@lexical/selection": "0.51.0",
		"@lexical/utils": "0.51.0",
		"@octane-xplat/richtext": "workspace:*",
		"@octanejs/lexical": "0.2.0",
		"lexical": "0.51.0",
		"zeed-dom": "0.18.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.6.3",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
