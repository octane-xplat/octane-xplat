{
	"name": "@octane-xplat/lexical",
	"version": "0.20.0",
	"description": "Unified rich-text editor facade for Octane xplat \u2014 live lexical on web/AppKit, Aztec + lexical document model on iOS/Android",
	"keywords": [
		"cross-platform",
		"editor",
		"lexical",
		"octane",
		"rich-text",
		"richtext",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/lexical",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lexical"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"dist/macos/browser.js",
		"dist/macos/browser.d.ts",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"pack:check": "tsrx-typegen --pack-check",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target lexical",
		"build:assets": "node ../richtext/build-browser.ts",
		"prepack": "bun run build:assets && bun run typegen && tsrx-typegen --pack-check",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.types.json"
	},
	"dependencies": {
		"@lexical/code": "0.53.0",
		"@lexical/extension": "0.53.0",
		"@lexical/html": "0.53.0",
		"@lexical/link": "0.53.0",
		"@lexical/list": "0.53.0",
		"@lexical/rich-text": "0.53.0",
		"@lexical/selection": "0.53.0",
		"@lexical/utils": "0.53.0",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/richtext": "workspace:*",
		"@octanejs/lexical": "0.2.13",
		"lexical": "0.53.0",
		"zeed-dom": "0.18.0"
	},
	"devDependencies": {
		"tsrx-typegen": "workspace:*",
		"@lexical/history": "0.53.0",
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-appkit": "workspace:*",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"types": "./types/generated/index.d.ts"
}
