{
	"targets": {
		"updates": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.ts",
						"./src/index.web.ts"
					],
					"types": [
						"./types/generated/index.d.ts"
					]
				},
				"./prepare": {
					"source": "src/index.ts",
					"runtime": "./prepare.cjs",
					"types": "./prepare.d.ts"
				}
			}
		}
	}
}
