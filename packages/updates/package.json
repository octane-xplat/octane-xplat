{
	"name": "@octane-xplat/updates",
	"version": "0.18.0",
	"description": "Optional next-launch OTA bundle updates for Octane Xplat iOS and Android apps",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/updates"
	},
	"files": [
		"src",
		"types",
		"native",
		"prepare.cjs",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.web.d.ts",
			"native": "./src/index.ts",
			"default": "./src/index.web.ts"
		},
		"./prepare": "./prepare.cjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsc -p tsconfig.types.json",
		"typecheck": "tsc -p tsconfig.types.json --noEmit --emitDeclarationOnly false",
		"test": "node --test tests/client.test.mjs tests/prepare.test.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"prepack": "pnpm typegen",
		"test:native-guard": "node --test tests/native-guard.test.mjs",
		"test:native-lifecycle": "node tests/native-lifecycle.mjs"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@octane-xplat/platform": "workspace:*",
		"fflate": "0.8.3"
	},
	"devDependencies": {
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/fingerprint": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/fingerprint": ">=0.18.0 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		},
		"@octane-xplat/fingerprint": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	}
}
