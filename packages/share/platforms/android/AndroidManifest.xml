<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Package visibility for the share-file grant loop on API 30+;
	     the chooser itself grants the picked target regardless. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.SEND" />
			<data android:mimeType="*/*" />
		</intent>
	</queries>
	<application>
		<!-- share.file content URIs. XplatShareFileProvider keeps this
		     element's android:name unique — a bare androidx.core.content.FileProvider
		     entry cannot merge with the same-name providers other plugins
		     (e.g. @nativescript/camera, social-share) declare, and the manifest
		     merger fails even though their `.provider` authority differs.
		     Authority `${applicationId}.xplatshare` and FILE_PROVIDER_PATHS
		     (the literal key androidx.core reads) are unchanged. -->
		<provider
			android:name="com.octanexplat.share.XplatShareFileProvider"
			android:authorities="${applicationId}.xplatshare"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/xplat_share_paths" />
		</provider>
	</application>
</manifest>
