{
	"name": "@octane-xplat/lottie",
	"version": "0.18.0",
	"description": "Lottie animation leaf for Octane xplat — lottie-web on web, NativeScript on mobile, and Airbnb Lottie on AppKit",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lottie"
	},
	"files": [
		"types",
		"platforms",
		"src/index.ts",
		"src/index.web.ts",
		"src/index.macos.ts",
		"src/Lottie.macos.tsrx",
		"src/Lottie.tsrx",
		"src/Lottie.web.tsrx",
		"src/props.ts",
		"src/references.d.ts",
		"src/escape-props.ts",
		"src/escape-props.web.ts",
		"src/layout-child.ts",
		"src/layout-child.web.ts",
		"src/vendor/ui-lottie/LICENSE.md",
		"src/vendor/ui-lottie/src/lottie/index.android.ts",
		"src/vendor/ui-lottie/src/lottie/index.common.ts",
		"src/vendor/ui-lottie/src/lottie/index.d.ts",
		"src/vendor/ui-lottie/src/lottie/index.ios.ts",
		"src/vendor/ui-lottie/src/lottie/utils.ts",
		"src/vendor/ui-lottie/src/lottie/typings"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "pnpm typegen",
		"test:packed": "node tests/packed-consumer.mjs",
		"typegen": "tsrx-typegen --target octane"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"lottie-web": "5.13.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "6.0.0",
			"ios": "6.0.1"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"AppKit",
				"QuartzCore"
			],
			"swiftWholeModuleOptimization": true,
			"swiftHeaderImports": [
				"AppKit/AppKit.h",
				"QuartzCore/QuartzCore.h"
			],
			"resources": {
				"PrivacyInfo.xcprivacy": "platforms/macos/resources/PrivacyInfo.xcprivacy"
			},
			"notices": "platforms/macos/resources/THIRD-PARTY-NOTICES.txt"
		}
	}
}
