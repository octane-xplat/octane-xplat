{
	"name": "@octane-xplat/lottie",
	"version": "0.13.0",
	"description": "Lottie animation leaf for Octane xplat — lottie-web on web, NativeScript on mobile, and Airbnb Lottie on AppKit",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lottie"
	},
	"files": [
		"dist",
		"types",
		"platforms",
		"src/index.ts",
		"src/index.web.ts",
		"src/index.macos.ts",
		"src/Lottie.macos.tsrx",
		"src/Lottie.tsrx",
		"src/Lottie.web.tsrx",
		"src/props.ts",
		"src/native-elements.d.ts",
		"src/references.d.ts",
		"src/cx.mobile.ts",
		"src/escape-props.ts",
		"src/escape-props.web.ts",
		"src/layout-child.ts",
		"src/layout-child.web.ts",
		"src/vendor/ui-lottie/LICENSE.md",
		"src/vendor/ui-lottie/src/lottie/index.android.ts",
		"src/vendor/ui-lottie/src/lottie/index.common.ts",
		"src/vendor/ui-lottie/src/lottie/index.d.ts",
		"src/vendor/ui-lottie/src/lottie/index.ios.ts",
		"src/vendor/ui-lottie/src/lottie/utils.ts",
		"src/vendor/ui-lottie/src/lottie/typings"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"default": "./src/index.macos.ts"
				},
				"web": {
					"types": "./types/generated/index.web.d.ts",
					"default": "./dist/web/index.js"
				},
				"native": {
					"types": "./types/generated/index.d.ts",
					"default": "./dist/native/index.js"
				},
				"types": "./types/generated/index.d.ts",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && tsrx-typegen --target octane && node ../../scripts/check-native-dist.mjs",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"lottie-web": "5.13.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.1",
		"@nativescript/core": "9.1.3",
		"@nativescript/types": "9.1.4",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"octane": "0.11.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "6.0.0",
			"ios": "6.0.1"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"AppKit",
				"QuartzCore"
			],
			"swiftWholeModuleOptimization": true,
			"swiftHeaderImports": [
				"AppKit/AppKit.h",
				"QuartzCore/QuartzCore.h"
			],
			"resources": {
				"PrivacyInfo.xcprivacy": "platforms/macos/resources/PrivacyInfo.xcprivacy"
			},
			"notices": "platforms/macos/resources/THIRD-PARTY-NOTICES.txt"
		}
	}
}
