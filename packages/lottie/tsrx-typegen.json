{
	"targets": {
		"octane": {
			"renderer": "@octane-xplat/jsx",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.macos.ts",
						"./src/index.web.ts",
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.d.ts"
					]
				}
			}
		}
	},
	"sourceExtensions": {
		".ts": ".js",
		".tsx": ".js",
		".tsrx": ".js"
	},
	"overrides": {
		"vendor/ui-lottie/src/lottie/index.common.d.ts": "types/overrides/index.common.d.ts",
		"vendor/ui-lottie/src/lottie/index.ios.d.ts": "types/overrides/index.ios.d.ts",
		"vendor/ui-lottie/src/lottie/utils.d.ts": "types/overrides/utils.d.ts"
	}
}
