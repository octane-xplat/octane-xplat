{
	"targets": {
		"lingui": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.d.ts"
					]
				},
				"./extractor": {
					"source": "src/extractor.ts",
					"runtime": "./dist/extractor.js",
					"types": "./types/generated/extractor.d.ts"
				},
				"./locales/*": {
					"source": "src/index.ts",
					"runtime": "./dist/locales/*.js",
					"types": "./dist/locales/*.d.ts"
				},
				"./time-zones/*": {
					"source": "src/index.ts",
					"runtime": "./dist/time-zones/*.js",
					"types": "./dist/time-zones/*.d.ts"
				}
			}
		}
	}
}
