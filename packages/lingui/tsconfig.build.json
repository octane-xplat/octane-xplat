{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "./tsconfig.types.json",
	"compilerOptions": {
		"rootDir": "src",
		"emitDeclarationOnly": false,
		"declaration": false,
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"isolatedDeclarations": false
	},
	"include": [
		"src/extractor.ts"
	]
}
