{
	"name": "@octane-xplat/lingui",
	"version": "0.17.0",
	"description": "Lingui localization runtime for Octane xplat — core macros, signal-free locale store, per-target locale detection",
	"keywords": [
		"android",
		"cross-platform",
		"i18n",
		"ios",
		"lingui",
		"localization",
		"nativescript",
		"octane",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/lingui",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lingui"
	},
	"files": [
		"dist",
		"types",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		},
		"./extractor": {
			"types": "./types/extractor.d.ts",
			"default": "./dist/extractor.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build && pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "pnpm build && node --test tests/*.test.mjs",
		"build": "tsc -p tsconfig.build.json",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@lingui/core": "6.8.0"
	},
	"devDependencies": {
		"@lingui/cli": "6.8.0",
		"@lingui/format-json": "6.8.0",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@lingui/cli": ">=6.5.0 <7",
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@lingui/cli": {
			"optional": true
		},
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	}
}
