{
	"name": "@octane-xplat/lingui",
	"version": "0.18.0",
	"description": "Lingui localization runtime for Octane xplat — core macros, signal-free locale store, per-target locale detection",
	"keywords": [
		"android",
		"cross-platform",
		"i18n",
		"ios",
		"lingui",
		"localization",
		"nativescript",
		"octane",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/lingui",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lingui"
	},
	"files": [
		"dist",
		"types",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		},
		"./extractor": {
			"types": "./types/extractor.d.ts",
			"default": "./dist/extractor.js"
		},
		"./locales/*": {
			"types": "./dist/locales/*.d.ts",
			"default": "./dist/locales/*.js"
		},
		"./time-zones/*": {
			"types": "./dist/time-zones/*.d.ts",
			"default": "./dist/time-zones/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsc -p tsconfig.types.json && node scripts/build-intl-data.mjs",
		"prepack": "pnpm build && pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test --test-concurrency=1 tests/*.test.mjs",
		"build": "tsc -p tsconfig.build.json",
		"test:packed": "node tests/packed-consumer.mjs",
		"test:intl": "node --test tests/intl.mjs",
		"typecheck": "tsc -p tsconfig.types.json --emitDeclarationOnly false --declaration false --noEmit"
	},
	"dependencies": {
		"@formatjs/intl-collator": "0.2.9",
		"@formatjs/intl-datetimeformat": "7.8.2",
		"@formatjs/intl-getcanonicallocales": "3.2.12",
		"@formatjs/intl-listformat": "8.3.15",
		"@formatjs/intl-locale": "5.3.12",
		"@formatjs/intl-numberformat": "9.4.3",
		"@formatjs/intl-pluralrules": "6.3.16",
		"@lingui/core": "6.8.0",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@lingui/cli": "6.8.0",
		"@lingui/format-json": "6.8.0",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@lingui/cli": ">=6.5.0 <7",
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@lingui/cli": {
			"optional": true
		},
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	}
}
