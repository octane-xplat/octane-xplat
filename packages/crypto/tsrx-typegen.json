{
	"targets": {
		"crypto": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.web.ts",
						"./src/index.macos.ts",
						"./src/index.linux.ts",
						"./src/index.windows.ts",
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.d.ts"
					]
				}
			}
		}
	}
}
