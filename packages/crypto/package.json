{
	"name": "@octane-xplat/crypto",
	"version": "0.18.0",
	"description": "Expo-shaped secure randomness, hashing and AES-GCM for Octane Xplat",
	"keywords": [
		"aes",
		"cross-platform",
		"crypto",
		"hash",
		"nativescript",
		"octane"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/crypto",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/crypto"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"!src/**/*.test.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.macos.ts",
			"linux": "./src/index.linux.ts",
			"windows": "./src/index.windows.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"test:packed": "node tests/packed-consumer.mjs",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:browser": "node tests/browser.web.mjs",
		"test:ios-runtime": "node tests/ios-runtime.mjs",
		"test:ios-bridge": "node tests/ios-bridge.mjs",
		"test:macos-consumer": "node tests/macos-consumer.mjs"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"jsdom": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"CryptoKit",
				"Security"
			]
		}
	}
}
