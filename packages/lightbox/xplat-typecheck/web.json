{
	"extends": "../tsconfig.envs.json",
	"files": [
		"../src/index.web.ts",
		"./isolation-web.ts"
	],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"types": [],
		"paths": {
			"@octane-xplat/ui": [
				"../ui/types/generated/index.d.ts"
			],
			"@octane-xplat/motion": [
				"../motion/types/generated/index.d.ts"
			]
		},
		"jsxImportSource": "@octane-xplat/jsx",
		"moduleSuffixes": [
			".web",
			""
		],
		"customConditions": [
			"web"
		],
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		]
	},
	"include": [],
	"exclude": []
}
