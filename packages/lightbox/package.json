{
	"name": "@octane-xplat/lightbox",
	"version": "0.17.1",
	"private": true,
	"description": "Full-screen media lightbox for Octane xplat — thumbnail morph, pinch/double-tap zoom, pull to dismiss, swipe paging",
	"keywords": [
		"android",
		"cross-platform",
		"gallery",
		"ios",
		"lightbox",
		"media",
		"nativescript",
		"octane",
		"web",
		"xplat",
		"zoom"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/lightbox",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lightbox"
	},
	"files": [
		"types/generated",
		"src",
		"LICENSE.lightbox",
		"UPSTREAM.md",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "node ../../scripts/typecheck.ts",
		"typegen": "tsrx-typegen --target lightbox",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:e2e": "node e2e/lightbox.mjs",
		"test:native": "vitest run -c vitest.native.config.mts"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/motion": "workspace:*",
		"@octane-xplat/ui": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/gesturehandler": "2.0.45",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"jsdom": "catalog:",
		"octane": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/gesturehandler": "2.0.45",
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/gesturehandler": {
			"optional": true
		},
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
