{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"isolatedDeclarations": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"noEmitOnError": true,
		"rootDir": "src",
		"outDir": "types/generated",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"allowImportingTsExtensions": true,
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"paths": {
			"@octane-xplat/ui": [
				"../ui/types/generated/index.d.ts"
			],
			"@octane-xplat/motion": [
				"../motion/types/generated/index.d.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsrx",
		"src/**/*.tsx"
	],
	"exclude": [
		"src/**/*.test.*",
		"src/**/*.spec.*"
	]
}
