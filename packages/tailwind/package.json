{
  "name": "@octane-xplat/tailwind",
  "version": "0.20.0",
  "private": true,
  "description": "Optional Tailwind compiler integration for Octane Xplat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/octane-xplat/octane-xplat",
    "directory": "packages/tailwind"
  },
  "files": [
    "dist",
    "types",
    "src/*.css",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.css",
    "./vite": {
      "types": "./types/generated/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "typegen": "tsc --runExternalCode -p tsconfig.build.json",
    "typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "postcss-nesting": "13.0.2",
    "postcss-value-parser": "4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@octane-xplat/build": "workspace:*",
    "@tsrx/content-mapper": "catalog:",
    "@types/node": "26.6.6",
    "typescript": "catalog:",
    "@octane-xplat/css-engine": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  }
}
