{
	"name": "@octane-xplat/platform",
	"version": "0.11.1",
	"description": "Headless platform capabilities for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"biometrics",
		"capabilities",
		"clipboard",
		"cross-platform",
		"deep-links",
		"geolocation",
		"ios",
		"nativescript",
		"octane",
		"platform-services",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/platform",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/platform"
	},
	"files": [
		"dist",
		"src",
		"platforms",
		"types"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/macos/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"linux": "./src/index.ts",
			"web": "./src/index.web.ts",
			"default": "./src/index.ts"
		},
		"./host": {
			"types": "./src/host-protocol.ts",
			"import": "./src/host-protocol.ts"
		},
		"./host/web": {
			"types": "./src/host-runtime.web.ts",
			"import": "./src/host-runtime.web.ts"
		},
		"./host/services": "./src/host-services.ts",
		"./*": "./src/*"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"macos": {
					"types": "./types/generated/macos/index.macos.d.ts",
					"default": "./dist/native/index.macos.js"
				},
				"linux": {
					"types": "./src/index.ts",
					"default": "./dist/linux/index.js"
				},
				"web": {
					"types": "./src/index.web.ts",
					"default": "./dist/web/index.web.js"
				},
				"types": "./src/index.ts",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			},
			"./host": {
				"types": "./src/host-protocol.ts",
				"import": "./dist/native/host-protocol.js"
			},
			"./host/web": {
				"types": "./src/host-runtime.web.ts",
				"import": "./dist/web/host-runtime.web.js"
			},
			"./host/services": {
				"types": "./src/host-services.ts",
				"default": "./dist/native/host-services.js"
			},
			"./*": {
				"linux": {
					"types": "./src/*.ts",
					"default": "./dist/linux/*.js"
				},
				"web": {
					"types": "./src/*.ts",
					"default": "./dist/web/*.js"
				},
				"types": "./src/*.ts",
				"native": "./dist/native/*.js",
				"default": "./dist/native/*.js"
			},
			"./*.tsrx": {
				"types": "./src/*.tsrx",
				"default": "./dist/native/*.js"
			},
			"./*.ts": {
				"types": "./src/*.ts",
				"default": "./dist/native/*.js"
			},
			"./*.web.ts": {
				"types": "./src/*.web.ts",
				"default": "./dist/web/*.web.js"
			},
			"./*.web.tsrx": {
				"types": "./src/*.web.tsrx",
				"default": "./dist/web/*.web.js"
			},
			"./*.web": {
				"types": "./src/*.web.ts",
				"default": "./dist/web/*.web.js"
			},
			"./*.linux.ts": {
				"types": "./src/*.linux.ts",
				"default": "./dist/linux/*.linux.js"
			},
			"./*.linux": {
				"types": "./src/*.linux.ts",
				"default": "./dist/linux/*.linux.js"
			}
		}
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typegen": "node scripts/typegen-macos.mjs",
		"prepack": "pnpm build",
		"build": "vite build && vite build --mode native && vite build --mode linux && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"octane": "0.10.2",
		"typescript": "5.9.3",
		"@octanejs/vite-plugin": "0.1.61",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
