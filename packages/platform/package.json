{
	"name": "@octane-xplat/platform",
	"version": "0.18.0",
	"description": "Headless platform capabilities for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"biometrics",
		"capabilities",
		"clipboard",
		"cross-platform",
		"deep-links",
		"geolocation",
		"ios",
		"nativescript",
		"octane",
		"platform-services",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/platform",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/platform"
	},
	"files": [
		"src",
		"platforms",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"linux": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./host": {
			"types": "./types/generated/host-protocol.d.ts",
			"import": "./src/host-protocol.ts"
		},
		"./host/web": {
			"types": "./types/generated/host-runtime.web.d.ts",
			"import": "./src/host-runtime.web.ts"
		},
		"./host/services": {
			"types": "./types/generated/host-services.d.ts",
			"default": "./src/host-services.ts"
		},
		"./testing": {
			"types": "./types/generated/testing.mobile.d.ts",
			"native": "./src/testing.mobile.ts"
		},
		"./dev-actions": {
			"types": "./types/generated/dev-actions.d.ts",
			"default": "./src/dev-actions.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		},
		"./breakpoints": {
			"macos": {
				"types": "./types/generated/breakpoints.macos.d.ts",
				"default": "./src/breakpoints.macos.tsrx"
			},
			"types": "./types/generated/breakpoints.d.ts",
			"default": "./src/breakpoints"
		},
		"./breakpoints.tsrx": {
			"macos": {
				"types": "./types/generated/breakpoints.macos.d.ts",
				"default": "./src/breakpoints.macos.tsrx"
			},
			"types": "./types/generated/breakpoints.d.ts",
			"default": "./src/breakpoints.tsrx"
		},
		"./breakpoints.ts": {
			"macos": {
				"types": "./types/generated/breakpoints.macos.d.ts",
				"default": "./src/breakpoints.macos.tsrx"
			},
			"types": "./types/generated/breakpoints.d.ts",
			"default": "./src/breakpoints.tsrx"
		},
		"./breakpoints.web.ts": {
			"types": "./types/generated/breakpoints.web.d.ts",
			"default": "./src/breakpoints.web.tsrx"
		},
		"./lifecycle": {
			"macos": {
				"types": "./types/generated/lifecycle.macos.d.ts",
				"default": "./src/lifecycle.macos.tsrx"
			},
			"types": "./types/generated/lifecycle.d.ts",
			"default": "./src/lifecycle"
		},
		"./lifecycle.tsrx": {
			"macos": {
				"types": "./types/generated/lifecycle.macos.d.ts",
				"default": "./src/lifecycle.macos.tsrx"
			},
			"types": "./types/generated/lifecycle.d.ts",
			"default": "./src/lifecycle.tsrx"
		},
		"./lifecycle.ts": {
			"macos": {
				"types": "./types/generated/lifecycle.macos.d.ts",
				"default": "./src/lifecycle.macos.tsrx"
			},
			"types": "./types/generated/lifecycle.d.ts",
			"default": "./src/lifecycle.tsrx"
		},
		"./lifecycle.web.ts": {
			"types": "./types/generated/lifecycle.web.d.ts",
			"default": "./src/lifecycle.web.tsrx"
		},
		"./safe-area": {
			"macos": {
				"types": "./types/generated/safe-area.macos.d.ts",
				"default": "./src/safe-area.macos.tsrx"
			},
			"types": "./types/generated/safe-area.d.ts",
			"default": "./src/safe-area"
		},
		"./safe-area.tsrx": {
			"macos": {
				"types": "./types/generated/safe-area.macos.d.ts",
				"default": "./src/safe-area.macos.tsrx"
			},
			"types": "./types/generated/safe-area.d.ts",
			"default": "./src/safe-area.tsrx"
		},
		"./safe-area.ts": {
			"macos": {
				"types": "./types/generated/safe-area.macos.d.ts",
				"default": "./src/safe-area.macos.tsrx"
			},
			"types": "./types/generated/safe-area.d.ts",
			"default": "./src/safe-area.tsrx"
		},
		"./safe-area.web.ts": {
			"types": "./types/generated/safe-area.web.d.ts",
			"default": "./src/safe-area.web.tsrx"
		},
		"./screen": {
			"macos": {
				"types": "./types/generated/screen.macos.d.ts",
				"default": "./src/screen.macos.tsrx"
			},
			"types": "./types/generated/screen.d.ts",
			"default": "./src/screen"
		},
		"./screen.tsrx": {
			"macos": {
				"types": "./types/generated/screen.macos.d.ts",
				"default": "./src/screen.macos.tsrx"
			},
			"types": "./types/generated/screen.d.ts",
			"default": "./src/screen.tsrx"
		},
		"./screen.ts": {
			"macos": {
				"types": "./types/generated/screen.macos.d.ts",
				"default": "./src/screen.macos.tsrx"
			},
			"types": "./types/generated/screen.d.ts",
			"default": "./src/screen.tsrx"
		},
		"./screen.web.ts": {
			"types": "./types/generated/screen.web.d.ts",
			"default": "./src/screen.web.tsrx"
		},
		"./use-keep-awake.macos.ts": {
			"types": "./types/generated/use-keep-awake.macos.d.ts",
			"default": "./src/use-keep-awake.macos.tsrx"
		},
		"./use-keep-awake.ts": {
			"types": "./types/generated/use-keep-awake.d.ts",
			"default": "./src/use-keep-awake.tsrx"
		},
		"./use-keep-awake.web.ts": {
			"types": "./types/generated/use-keep-awake.web.d.ts",
			"default": "./src/use-keep-awake.web.tsrx"
		},
		"./*.tsrx": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.tsrx"
		},
		"./ios": {
			"types": "./types/generated/types/ios.d.ts",
			"default": "./src/types/ios.ts"
		},
		"./android": {
			"types": "./types/generated/types/android.d.ts",
			"default": "./src/types/android.ts"
		},
		"./macos": {
			"types": "./types/generated/types/macos.macos.d.ts",
			"default": "./src/types/macos.macos.ts"
		},
		"./windows": {
			"types": "./types/generated/types/windows.d.ts",
			"default": "./src/types/windows.ts"
		},
		"./environment": {
			"macos": {
				"types": "./types/generated/environment.macos.d.ts",
				"default": "./src/environment.macos.ts"
			},
			"linux": {
				"types": "./types/generated/environment.web.d.ts",
				"default": "./src/environment.web.ts"
			},
			"windows": {
				"types": "./types/generated/environment.web.d.ts",
				"default": "./src/environment.web.ts"
			},
			"web": {
				"types": "./types/generated/environment.web.d.ts",
				"default": "./src/environment.web.ts"
			},
			"types": "./types/generated/environment.d.ts",
			"default": "./src/environment.ts"
		},
		"./locale": {
			"macos": {
				"types": "./types/generated/locale.macos.d.ts",
				"default": "./src/locale.macos.ts"
			},
			"types": "./types/generated/locale.d.ts",
			"default": "./src/locale"
		},
		"./locale.ts": {
			"macos": {
				"types": "./types/generated/locale.macos.d.ts",
				"default": "./src/locale.macos.ts"
			},
			"types": "./types/generated/locale.d.ts",
			"default": "./src/locale.ts"
		},
		"./device": {
			"macos": {
				"types": "./types/generated/device.macos.d.ts",
				"default": "./src/device.macos.ts"
			},
			"types": "./types/generated/device.d.ts",
			"default": "./src/device"
		},
		"./device.ts": {
			"macos": {
				"types": "./types/generated/device.macos.d.ts",
				"default": "./src/device.macos.ts"
			},
			"types": "./types/generated/device.d.ts",
			"default": "./src/device.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs && vitest run --config vitest.environment.config.mts",
		"test:connectivity:macos": "node tests/verify-connectivity-macos.mjs",
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"generate:native-types": "node scripts/generate-native-types.ts"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/macos-node-api": "catalog:",
		"@nativescript/objc-node-api": "1.0.0-alpha.7",
		"@nativescript/types": "catalog:",
		"@nativescript/types-android": "catalog:",
		"@nativescript/types-ios": "catalog:",
		"@nativescript/unit-test-runner": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@nativescript/types-android": ">=9.1.1 <10",
		"@nativescript/types-ios": ">=9.1.3 <10",
		"@nativescript/unit-test-runner": ">=5.0.0 <6",
		"octane": ">=0.6.3 <1",
		"vitest": ">=4.1.0 <5"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"@nativescript/unit-test-runner": {
			"optional": true
		},
		"vitest": {
			"optional": true
		},
		"@nativescript/types-ios": {
			"optional": true
		},
		"@nativescript/types-android": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"Network"
			]
		}
	}
}
