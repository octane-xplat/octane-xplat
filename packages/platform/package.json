{
	"name": "@octane-xplat/platform",
	"version": "0.14.0",
	"description": "Headless platform capabilities for Octane xplat \u2014 matching web + NativeScript implementations",
	"keywords": [
		"android",
		"biometrics",
		"capabilities",
		"clipboard",
		"cross-platform",
		"deep-links",
		"geolocation",
		"ios",
		"nativescript",
		"octane",
		"platform-services",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/platform",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/platform"
	},
	"files": [
		"dist",
		"src",
		"platforms",
		"types"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/macos/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"linux": "./src/index.ts",
			"web": "./src/index.web.ts",
			"default": "./src/index.ts"
		},
		"./host": {
			"types": "./src/host-protocol.ts",
			"import": "./src/host-protocol.ts"
		},
		"./host/web": {
			"types": "./src/host-runtime.web.ts",
			"import": "./src/host-runtime.web.ts"
		},
		"./host/services": "./src/host-services.ts",
		"./testing": {
			"types": "./src/testing.mobile.ts",
			"native": "./src/testing.mobile.ts"
		},
		"./dev-actions": "./src/dev-actions.ts",
		"./ios": {
			"types": "./src/types/ios.ts",
			"import": "./src/types/ios.ts",
			"default": "./src/types/ios.ts"
		},
		"./android": {
			"types": "./src/types/android.ts",
			"import": "./src/types/android.ts",
			"default": "./src/types/android.ts"
		},
		"./macos": {
			"types": "./src/types/macos.macos.ts",
			"import": "./src/types/macos.macos.ts",
			"default": "./src/types/macos.macos.ts"
		},
		"./windows": {
			"types": "./src/types/windows.ts",
			"import": "./src/types/windows.ts",
			"default": "./src/types/windows.ts"
		},
		"./*": "./src/*"
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/generated/macos/index.macos.d.ts",
					"default": "./dist/native/index.macos.js"
				},
				"linux": {
					"types": "./src/index.ts",
					"default": "./dist/linux/index.js"
				},
				"web": {
					"types": "./src/index.web.ts",
					"default": "./dist/web/index.web.js"
				},
				"types": "./src/index.ts",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			},
			"./host": {
				"types": "./src/host-protocol.ts",
				"import": "./dist/native/host-protocol.js"
			},
			"./host/web": {
				"types": "./src/host-runtime.web.ts",
				"import": "./dist/web/host-runtime.web.js"
			},
			"./host/services": {
				"types": "./src/host-services.ts",
				"default": "./dist/native/host-services.js"
			},
			"./testing": {
				"types": "./src/testing.mobile.ts",
				"native": "./dist/native/testing.mobile.js"
			},
			"./dev-actions": {
				"types": "./src/dev-actions.ts",
				"linux": "./dist/linux/dev-actions.js",
				"web": "./dist/web/dev-actions.js",
				"default": "./dist/native/dev-actions.js"
			},
			"./ios": {
				"types": "./src/types/ios.ts",
				"import": "./dist/native/types/ios.js",
				"default": "./dist/native/types/ios.js"
			},
			"./android": {
				"types": "./src/types/android.ts",
				"import": "./dist/native/types/android.js",
				"default": "./dist/native/types/android.js"
			},
			"./macos": {
				"types": "./src/types/macos.macos.ts",
				"import": "./dist/native/types/macos.macos.js",
				"default": "./dist/native/types/macos.macos.js"
			},
			"./windows": {
				"types": "./src/types/windows.ts",
				"import": "./dist/native/types/windows.js",
				"default": "./dist/native/types/windows.js"
			},
			"./*": {
				"linux": {
					"types": "./src/*.ts",
					"default": "./dist/linux/*.js"
				},
				"web": {
					"types": "./src/*.ts",
					"default": "./dist/web/*.js"
				},
				"types": "./src/*.ts",
				"native": "./dist/native/*.js",
				"default": "./dist/native/*.js"
			},
			"./*.tsrx": {
				"types": "./src/*.tsrx",
				"default": "./dist/native/*.js"
			},
			"./*.ts": {
				"types": "./src/*.ts",
				"default": "./dist/native/*.js"
			},
			"./*.web.ts": {
				"types": "./src/*.web.ts",
				"default": "./dist/web/*.web.js"
			},
			"./*.web.tsrx": {
				"types": "./src/*.web.tsrx",
				"default": "./dist/web/*.web.js"
			},
			"./*.web": {
				"types": "./src/*.web.ts",
				"default": "./dist/web/*.web.js"
			},
			"./*.linux.ts": {
				"types": "./src/*.linux.ts",
				"default": "./dist/linux/*.linux.js"
			},
			"./*.linux": {
				"types": "./src/*.linux.ts",
				"default": "./dist/linux/*.linux.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"test:connectivity:macos": "node tests/verify-connectivity-macos.mjs",
		"typegen": "node scripts/typegen-macos.mjs",
		"prepack": "pnpm build",
		"build": "vite build && vite build --mode native && vite build --mode linux && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"generate:native-types": "node scripts/generate-native-types.mjs"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@nativescript/objc-node-api": "1.0.0-alpha.7",
		"@nativescript/types": "9.1.4",
		"@nativescript/unit-test-runner": "5.0.0",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.11.0",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@nativescript/unit-test-runner": ">=5.0.0 <6",
		"octane": ">=0.6.3 <1",
		"vitest": ">=4.1.0 <5"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"@nativescript/unit-test-runner": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"Network"
			]
		}
	},
	"dependencies": {
		"@nativescript/macos-node-api": "0.4.4-next.2026-08-09-31292056208"
	}
}