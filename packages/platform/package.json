{
	"name": "@octane-xplat/platform",
	"version": "0.7.3",
	"description": "Headless platform capabilities for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"octane",
		"xplat",
		"cross-platform",
		"platform-services",
		"capabilities",
		"clipboard",
		"geolocation",
		"biometrics",
		"deep-links",
		"nativescript",
		"ios",
		"android",
		"web"
	],
	"license": "MIT",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/platform",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/platform"
	},
	"files": [
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": "./src/index.macos.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"octane": "0.6.3"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs"
	}
}
