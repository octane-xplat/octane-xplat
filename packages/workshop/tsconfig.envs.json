{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"tests/**/*.ts"
			],
			"exclude": [
				"src/**/*.test.*",
				"src/mobile/**",
				"src/build/**"
			]
		},
		"native": {
			"files": [
				"src/mobile/index.mobile.ts"
			],
			"compilerOptions": {
				"types": [
					"@nativescript/types"
				]
			}
		}
	}
}
