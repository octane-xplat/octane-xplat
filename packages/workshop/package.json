{
	"name": "@octane-xplat/workshop",
	"version": "0.20.0",
	"description": "Development-only component workshop for Octane Xplat \u2014 typed stories, metadata discovery, adaptive shell, lifecycle and warm reload",
	"keywords": [
		"components",
		"cross-platform",
		"dev-tools",
		"octane",
		"stories",
		"storybook",
		"workshop",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/workshop",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/workshop"
	},
	"files": [
		"types",
		"dist",
		"src",
		"MOBILE.md",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"node": "./dist/index.js",
			"default": "./src/index.ts"
		},
		"./web": {
			"types": "./types/generated/web/index.web.d.ts",
			"default": "./src/web/index.web.ts"
		},
		"./vite": {
			"types": "./src/build/vite.d.ts",
			"default": "./dist/build/vite.js"
		},
		"./node": {
			"types": "./src/build/node.d.ts",
			"default": "./dist/build/node.js"
		},
		"./package.json": "./package.json",
		"./mobile": {
			"types": "./types/generated/mobile/index.mobile.d.ts",
			"default": "./src/mobile/index.mobile.ts"
		},
		"./vite-mobile": {
			"types": "./src/build/vite-mobile.d.ts",
			"default": "./dist/build/vite-mobile.js"
		},
		"./macos": {
			"types": "./types/generated/macos/index.macos.d.ts",
			"default": "./src/macos/index.macos.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target workshop",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run && tsrx-tsc --noEmit -p tsconfig.test.json",
		"test:e2e": "bun run --filter @xplat/workshop-demo test:e2e",
		"test:packed": "bun run build && node tests/packed-consumer.web.mjs",
		"test:packed:linux": "node tests/packed-consumer.linux.mjs",
		"test:packed:macos": "node tests/packed-consumer.macos.mjs",
		"test:packed:windows": "node tests/packed-windows-preflight.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"test:types": "tsrx-tsc --noEmit -p tsconfig.test.json",
		"test:packed:mobile": "node tests/packed-consumer.mobile.mjs",
		"prepack": "bun run build && bun run typegen && tsrx-typegen --pack-check",
		"build": "vite build"
	},
	"dependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"storybook": "10.6.5",
		"tinyglobby": "0.2.17"
	},
	"devDependencies": {
		"@octane-xplat/css-engine": "workspace:*",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/macos-node-api": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@octane-xplat/linux-gtk": "workspace:*"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.4 <1",
		"@nativescript/core": ">=9.1.3 <10",
		"@nativescript/macos-node-api": "0.4.4-next.2026-08-09-31292056208",
		"@octane-xplat/macos-renderer": ">=0.14.0 <1",
		"@octanejs/vite-plugin": ">=0.1.61",
		"octane": ">=0.6.3 <1",
		"vite": ">=8",
		"@octane-xplat/linux-gtk": ">=0.18.0 <1"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"@nativescript-community/octane": {
			"optional": true
		},
		"@octane-xplat/macos-renderer": {
			"optional": true
		},
		"@nativescript/macos-node-api": {
			"optional": true
		},
		"@octane-xplat/linux-gtk": {
			"optional": true
		}
	}
}
