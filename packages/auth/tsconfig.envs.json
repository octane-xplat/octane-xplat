{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"native": {
			"files": [
				"src/index.ts",
				"examples/auth0-flow.ts"
			],
			"compilerOptions": {
				"types": [
					"@nativescript/types"
				]
			}
		},
		"web": {
			"files": [
				"src/index.web.ts",
				"examples/auth0-flow.ts"
			]
		},
		"macos": {
			"include": [
				"src/*.macos.ts",
				"src/*.macos.tsrx",
				"src/types.ts",
				"examples/auth0-flow.ts"
			]
		}
	}
}
