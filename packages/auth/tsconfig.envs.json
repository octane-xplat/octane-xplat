{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/auth": ["../../../src/index.ts"], "@octane-xplat/platform": ["../../../../platform/src/index.ts"] },
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"native": {
			"files": [
				"src/index.ts",
				"src/apple-sign-in-button-view.ios.ts",
				"../../examples/auth/auth0-flow.ts"
			],
			"compilerOptions": {
				"types": [
					"@nativescript/types"
				]
			}
		},
		"web": {
			"files": [
				"src/index.web.ts",
				"../../examples/auth/auth0-flow.ts"
			]
		},
		"macos": {
			"include": [
				"src/*.macos.ts",
				"src/*.macos.tsrx",
				"src/types.ts",
				"../../examples/auth/auth0-flow.ts"
			]
		}
	}
}
