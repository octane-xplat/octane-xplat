{
	"name": "@octane-xplat/auth",
	"version": "0.20.0",
	"description": "Sign in with Apple + Google Sign-In + hosted-auth sessions for Octane xplat — native SDKs on iOS/Android, platform web SDKs in the browser",
	"keywords": [
		"android",
		"apple",
		"auth",
		"cross-platform",
		"google",
		"ios",
		"nativescript",
		"oauth",
		"octane",
		"pkce",
		"sign-in",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/auth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/auth"
	},
	"files": [
		"types",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"typegen": "tsrx-typegen --target octane",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test tests/*.test.mjs",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"dependencies": {
		"@nativescript/apple-sign-in": "2.0.0",
		"@nativescript/google-signin": "2.1.1",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/secure-storage": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
