{
	"compilerOptions": {
		"strict": true,
		"isolatedDeclarations": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"allowImportingTsExtensions": true,
		"types": [
			"@nativescript/types"
		]
	},
	"include": [
		"src/apple.ts",
		"src/apple.web.ts",
		"src/google.ts",
		"src/google.web.ts",
		"src/AppleSignInButton.tsrx",
		"src/AppleSignInButton.web.tsrx",
		"src/GoogleSignInButton.tsrx",
		"src/GoogleSignInButton.web.tsrx",
		"src/index.ts",
		"src/index.web.ts",
		"src/base64.ts",
		"src/hosted.ts",
		"src/sha256.ts",
		"src/types.ts"
	]
}
