{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src"
	},
	"include": [
		"src/apple.ts",
		"src/apple.web.ts",
		"src/google.ts",
		"src/google.web.ts",
		"src/AppleSignInButton.tsrx",
		"src/AppleSignInButton.web.tsrx",
		"src/GoogleSignInButton.tsrx",
		"src/GoogleSignInButton.web.tsrx",
		"src/index.ts",
		"src/index.web.ts",
		"src/native-elements.d.ts",
		"src/types.ts"
	]
}
