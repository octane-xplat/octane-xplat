{
	"name": "@octane-xplat/macos-appkit",
	"version": "0.20.0",
	"description": "Experimental AppKit renderer for Octane on macOS",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/macos-appkit"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"LICENSE"
	],
	"xplat": {
		"macos": {
			"frameworks": ["AppKit", "QuartzCore", "CoreVideo"],
			"prebuiltLibraries": [
				"platforms/macos/prebuilt/libxplatmason.dylib"
			],
			"notices": "platforms/macos/licenses/nativescript-mason.txt"
		}
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./host": {
			"types": "./src/host.d.ts",
			"import": "./src/host.ts",
			"default": "./src/host.ts"
		},
		"./types": {
			"types": "./types/index.d.ts"
		},
		"./types/*": {
			"types": "./types/*.d.ts"
		},
		"./compat/native-core": "./src/native-core-shim.ts",
		"./compat/escape-props": "./src/native-escape-props.ts",
		"./compat/ns-core": "./src/ns-compat.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"test:accessibility": "node --test test/common-control-accessibility.test.ts",
		"test:keyboard": "node --test test/keyboard.test.ts",
		"test:mason": "node --test test/mason*.test.ts",
		"test:gestures": "node ../../tools/probe/cli.ts run test/fixtures/gestures.macos.tsrx --target macos",
		"test:portals": "node ../../tools/probe/cli.ts run test/fixtures/portal-lifecycle.macos.tsrx --target macos",
		"test:overflow": "node ../../tools/probe/cli.ts run test/fixtures/text-overflow.macos.tsrx --target macos",
		"test:animation-runtime": "node test/animation-runtime.mts",
		"test:packed": "node --experimental-strip-types test/packed-consumer.ts",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@nativescript/macos-node-api": "catalog:",
		"@nativescript/objc-node-api": "1.0.0-alpha.7",
		"@octane-xplat/css-engine": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"acorn": "8.19.0",
		"saxes": "6.0.0"
	},
	"devDependencies": {
		"vite": "catalog:",
		"octane": "catalog:",
		"typescript": "catalog:",
		"typescript-classic": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"octane": ">=0.6.3 <1"
	}
}
