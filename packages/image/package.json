{
	"name": "@octane-xplat/image",
	"version": "0.20.0",
	"description": "Cached image loading for Octane xplat \u2014 Glide/SDWebImage engine (ui-image) on native, <img> on web",
	"keywords": [
		"android",
		"cache",
		"cross-platform",
		"glide",
		"image",
		"ios",
		"nativescript",
		"octane",
		"sdwebimage",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/image",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/image"
	},
	"files": [
		"types",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"typegen": "tsrx-typegen --target octane",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript-community/ui-image": "5.0.18",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.10.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
