{
	"name": "@octane-xplat/native-picker",
	"version": "0.1.0",
	"description": "Platform-native single-selection picker for Octane xplat",
	"files": [
		"dist",
		"types",
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		"./types": "./src/types.ts",
		"./ios": {
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"native": "./src/android/index.ts"
		},
		"./web": {
			"web": "./src/web/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./types": "./types/index.d.ts",
			"./ios": {
				"types": "./types/index.d.ts",
				"native": "./dist/native/ios/index.js"
			},
			"./android": {
				"types": "./types/index.d.ts",
				"native": "./dist/native/android/index.js"
			},
			"./web": {
				"types": "./types/index.d.ts",
				"web": "./dist/web/web/index.js"
			}
		}
	},
	"scripts": {
		"build": "vite build && vite build --mode native && tsc -p tsconfig.types.json",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@nativescript/jetpack-compose": "1.0.0-beta.0",
		"@nativescript/swift-ui": "4.0.2"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.1",
		"@nativescript/core": "9.1.2",
		"@octanejs/vite-plugin": "0.1.60",
		"octane": "0.5.0",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.1.51 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
