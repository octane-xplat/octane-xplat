{
	"targets": {
		"octane": {
			"renderer": "@octane-xplat/jsx",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": "./src/index.ts",
					"types": "./types/generated/index.d.ts"
				},
				"./format": {
					"source": "src/format.ts",
					"runtime": "./src/format.ts",
					"types": "./types/generated/format.d.ts"
				}
			}
		}
	},
	"sourceExtensions": {
		".tsrx": ".js",
		".ts": ".js",
		".tsx": ".js"
	},
	"overrides": {}
}
