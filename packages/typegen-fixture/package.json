{
	"name": "tsrx-typegen-fixture",
	"version": "0.0.0",
	"private": true,
	"files": [
		"src",
		"types/generated"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./format": {
			"types": "./types/generated/format.d.ts",
			"default": "./src/format.ts"
		}
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"typegen:check": "tsrx-typegen --project tsconfig.types.json --check",
		"typecheck:consumer": "tsc --noEmit -p tsconfig.consumer.json",
		"test:packed": "node ../tsrx-typegen/tests/packed-consumer.mjs",
		"prepack": "pnpm typegen && pnpm exec tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"devDependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"octane": ">=0.1.51 <1"
	}
}
