{
	"extends": "../tsconfig.envs.json",
	"files": [
		"../../cli/src/typecheck-globals/native.d.ts",
		"../src/ViewShot.tsx",
		"../src/backend-types.ts",
		"../src/backend.apple.ts",
		"../src/backend.ios.ts",
		"../src/controller.ts",
		"../src/index.ts",
		"../src/options.ts",
		"../src/props.ts",
		"../src/service.ts",
		"../src/targets.ts",
		"../src/types.ts",
		"../src/unsupported.ts",
		"../src/use-view-shot.tsx",
		"./isolation-ios.ts"
	],
	"compilerOptions": {
		"paths": {
			"@octane-xplat/view-shot": [
				"../src/index.ts"
			]
		},
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"types": [
			"../node_modules/@nativescript/types/globals.d.ts",
			"../../../node_modules/.bun/@nativescript+types-ios@9.1.3/node_modules/@nativescript/types-ios/index.d.ts"
		],
		"moduleSuffixes": [
			".ios",
			".mobile",
			".native",
			""
		],
		"customConditions": [
			"ios",
			"native"
		],
		"lib": [
			"ESNext"
		]
	},
	"include": [],
	"exclude": []
}
