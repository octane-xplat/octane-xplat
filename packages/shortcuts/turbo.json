{
	"extends": ["//"],
	"tasks": {
		"typegen": {
			"outputs": ["dist/**/*.d.ts"]
		},
		"build": {
			"outputs": ["dist/**/*.js"]
		},
		"typecheck": {
			"dependsOn": ["typegen", "^typegen"]
		},
		"test:e2e": {
			"dependsOn": ["typegen", "build"],
			"cache": false
		},
		"test:windows-runtime": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["SHORTCUTS_WINDOWS_HOST", "SHORTCUTS_WINDOWS_RUNTIME"]
		},
		"test:gtk-runtime": {
			"dependsOn": ["typegen", "build"],
			"cache": false,
			"env": ["SHORTCUTS_GTK_HOST", "SHORTCUTS_GTK_VM"]
		}
	}
}
