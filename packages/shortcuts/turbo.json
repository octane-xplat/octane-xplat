{
	"extends": ["//"],
	"tasks": {
		"typegen": {
			"outputs": ["types/generated/**/*.d.ts", "types/generated/.tsrx-typegen-manifest.json"]
		},
		"build": {
			"outputs": ["dist/**/*.js"]
		},
		"typecheck": {
			"dependsOn": ["typegen", "^typegen"],
			"inputs": ["$TURBO_DEFAULT$", "../../scripts/typecheck.ts", "../../packages/cli/src/tsconfig-envs.ts", "../../examples/keyboard-shortcuts/workspace.ts"]
		},
		"test:docs": {
			"dependsOn": ["typegen"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/app/keyboard-shortcuts-api.md"],
			"outputs": []
		},
		"test:e2e": {
			"dependsOn": ["typegen", "build"],
			"cache": false
		},
		"test:windows-runtime": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["SHORTCUTS_WINDOWS_HOST", "SHORTCUTS_WINDOWS_RUNTIME"]
		},
		"test:gtk-runtime": {
			"dependsOn": ["typegen", "build"],
			"cache": false,
			"env": ["SHORTCUTS_GTK_HOST", "SHORTCUTS_GTK_VM"]
		}
	}
}
