{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/shortcuts": ["../../../src/index.ts"] }
	},
	"environments": {
		"web": {
			"include": ["src/**/*.ts", "../../examples/keyboard-shortcuts/workspace.ts"]
		},
		"macos": {
			"files": ["src/index.macos.ts"]
		},
		"gtk": {
			"files": ["../linux-gtk-renderer/src/gi.d.ts", "src/index.gtk.ts"]
		},
		"windows": {
			"files": ["src/index.windows.ts"]
		}
	}
}
