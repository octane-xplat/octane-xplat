{
	"name": "@octane-xplat/shortcuts",
	"version": "0.18.0",
	"description": "Scoped keyboard shortcuts, sequences and recording for web and native desktop apps",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/shortcuts"
	},
	"files": [
		"types/generated",
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./dist/index.macos.js"
			},
			"gtk": {
				"types": "./types/generated/index.gtk.d.ts",
				"default": "./dist/index.gtk.js"
			},
			"windows": {
				"types": "./types/generated/index.windows.d.ts",
				"default": "./dist/index.windows.js"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./dist/index.web.js"
			},
			"browser": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./dist/index.web.js"
			},
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json --declaration false",
		"typegen": "tsrx-typegen --target shortcuts",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"test:docs": "node tests/docs-reference.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:e2e": "node tests/browser.web.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"test:gtk-runtime": "node tests/gtk-runtime.mjs",
		"test:windows-runtime": "node tests/windows-runtime.mjs"
	},
	"dependencies": {
		"@casbin/expression-eval": "5.3.0"
	},
	"devDependencies": {
		"@nativescript/core": "https://pkg.pr.new/@nativescript/core@abae298",
		"jsdom": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.4-0 <10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
