{
	"name": "@octane-xplat/tiptap",
	"version": "0.9.0",
	"description": "Unified rich-text editor facade for Octane xplat — @octanejs/tiptap on web, @octane-xplat/richtext (Aztec) + tiptap doc model on native",
	"keywords": [
		"cross-platform",
		"editor",
		"octane",
		"prosemirror",
		"rich-text",
		"richtext",
		"tiptap",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/tiptap",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/tiptap"
	},
	"files": [
		"dist",
		"types",
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"default": "./src/index.macos.ts"
			},
			"web": {
				"default": "./src/index.web.ts"
			},
			"native": {
				"default": "./src/index.ts"
			},
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.d.ts",
					"default": "./src/index.macos.ts"
				},
				"web": {
					"types": "./types/index.d.ts",
					"default": "./dist/web/index.js"
				},
				"native": {
					"types": "./types/index.d.ts",
					"default": "./dist/native/index.js"
				},
				"types": "./types/index.d.ts",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && tsc -p tsconfig.types.json && node ../../scripts/check-native-dist.mjs",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@octane-xplat/richtext": "workspace:*",
		"@octanejs/tiptap": "0.0.51",
		"@tiptap/core": "3.28.0",
		"@tiptap/pm": "3.28.0",
		"@tiptap/starter-kit": "3.28.0",
		"@tiptap/static-renderer": "3.28.0",
		"zeed-dom": "^0.15.1"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.6.3",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
