{
	"name": "@octane-xplat/tiptap",
	"version": "0.18.0",
	"description": "Unified rich-text editor facade for Octane xplat — live tiptap on web/AppKit, Aztec + tiptap document model on iOS/Android",
	"keywords": [
		"cross-platform",
		"editor",
		"octane",
		"prosemirror",
		"rich-text",
		"richtext",
		"tiptap",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/tiptap",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/tiptap"
	},
	"files": [
		"types",
		"src",
		"platforms",
		"dist/macos/browser.js",
		"dist/macos/browser.d.ts",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/index.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"pack:check": "tsrx-typegen --pack-check",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsc -p tsconfig.types.json",
		"build:assets": "node ../richtext/build-browser.ts",
		"prepack": "pnpm build:assets && pnpm typegen && tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/richtext": "workspace:*",
		"@octanejs/tiptap": "0.0.61",
		"@tiptap/core": "3.32.0",
		"@tiptap/pm": "3.32.0",
		"@tiptap/starter-kit": "3.32.0",
		"@tiptap/static-renderer": "3.32.0",
		"zeed-dom": "0.18.0"
	},
	"devDependencies": {
		"tsrx-typegen": "workspace:*",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
