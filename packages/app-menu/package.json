{
	"name": "@octane-xplat/app-menu",
	"version": "0.20.0",
	"description": "Native desktop application menu bar for macOS, Windows and GTK apps",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/app-menu"
	},
	"files": [
		"types/generated",
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./dist/index.macos.js",
			"gtk": "./dist/index.gtk.js",
			"windows": "./dist/index.windows.js",
			"web": "./dist/index.web.js",
			"browser": "./dist/index.web.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --runExternalCode -p tsconfig.build.json --declaration false",
		"typegen": "tsrx-typegen --target app-menu",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"pack:check": "tsrx-typegen --pack-check",
		"prepack": "bun run build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"test:gtk-runtime": "node tests/gtk-runtime.mts",
		"test:windows-runtime": "node tests/windows-runtime.mts"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"jsdom": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"@nativescript/core": "https://pkg.pr.new/@nativescript/core@abae298"
	},
	"types": "./types/generated/index.d.ts",
	"peerDependencies": {
		"@nativescript/core": ">=9.1.4-0 <10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	}
}
