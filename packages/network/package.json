{
	"name": "@octane-xplat/network",
	"version": "0.20.0",
	"description": "Incremental HTTP response transport for Octane Xplat",
	"keywords": [
		"http",
		"streaming",
		"nativescript"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/network",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/network"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"linux": "./src/unavailable.ts",
			"windows": "./src/unavailable.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target network",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "node --test tests/*.test.mjs",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:runtime": "node tests/runtime.mjs",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@octane-xplat/platform": "workspace:*",
		"web-streams-polyfill": "4.3.0",
		"@kayahr/text-encoding": "2.2.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"rouzer": "6.0.2",
		"zod": "4.6.5",
		"playwright": "1.63.0",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation"
			]
		}
	},
	"types": "./types/generated/index.d.ts"
}
