{
	"extends": [
		"//"
	],
	"tasks": {
		"test": {
			"cache": false,
			"dependsOn": [
				"build",
				"^build",
				"^typegen"
			]
		},
		"typecheck": {
			"dependsOn": [
				"build",
				"^typegen"
			]
		},
		"test:a11y": {
			"dependsOn": [
				"build",
				"^build",
				"^typegen"
			],
			"cache": false,
			"passThroughEnv": [
				"XPLAT_GTK_KEEP_A11Y"
			]
		},
		"typegen": {
			"outputs": [
				"dist/**"
			]
		},
		"test:runtime": {
			"dependsOn": [
				"build",
				"^typegen",
				"^build"
			],
			"cache": false
		},
		"build:gestures": {
			"dependsOn": [
				"build",
				"^build",
				"^typegen"
			],
			"outputs": [
				"test/fixtures/dist-shared-gestures/**"
			]
		},
		"test:gestures": {
			"dependsOn": [
				"build:gestures"
			],
			"cache": false,
			"passThroughEnv": [
				"DISPLAY",
				"XPLAT_MASON_TYPELIB",
				"XPLAT_GTK_GESTURE_BUNDLE"
			]
		}
	}
}
