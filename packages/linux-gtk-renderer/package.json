{
	"name": "@octane-xplat/linux-gtk",
	"version": "0.18.0",
	"description": "Experimental GTK4 renderer for Octane on Linux (GJS universal runtime)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/linux-gtk-renderer"
	},
	"files": [
		"dist",
		"native/xplatmason/*.c",
		"native/xplatmason/*.h",
		"native/xplatmason/build.sh",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./host": {
			"types": "./dist/host.d.ts",
			"import": "./dist/host.js",
			"default": "./dist/host.js"
		},
		"./compat/native-core": {
			"types": "./dist/native-core-shim.d.ts",
			"default": "./dist/native-core-shim.js"
		},
		"./compat/escape-props": {
			"types": "./dist/native-escape-props.d.ts",
			"default": "./dist/native-escape-props.js"
		}
	},
	"scripts": {
		"test": "node --test test/build.test.mjs test/mason.test.mjs test/css.test.mjs test/style-css.test.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/fixtures/tsconfig.routing.json",
		"build": "tsc -p tsconfig.build.json && node build.mjs",
		"prepack": "pnpm exec turbo run build --filter=@octane-xplat/linux-gtk",
		"test:a11y": "node --test test/a11y.test.mjs",
		"typegen": "tsc -p tsconfig.build.json && node build.mjs"
	},
	"devDependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"octane": ">=0.14.0 <1"
	},
	"dependencies": {
		"@octane-xplat/css-engine": "workspace:*",
		"@octane-xplat/jsx": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
