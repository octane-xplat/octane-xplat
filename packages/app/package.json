{
	"name": "@xplat/app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*"
	},
	"scripts": {
		"gen": "xplat routes --dir src/app && bamboo codegen",
		"routes:watch": "xplat routes --dir src/app --watch"
	},
	"dependencies": {
		"@octane-xplat/audio": "workspace:*",
		"@octane-xplat/biometrics": "workspace:*",
		"@octane-xplat/files": "workspace:*",
		"@octane-xplat/geolocation": "workspace:*",
		"@octane-xplat/haptics": "workspace:*",
		"@octane-xplat/media": "workspace:*",
		"@octane-xplat/motion": "workspace:*",
		"@octane-xplat/notifications": "workspace:*",
		"@octane-xplat/pager": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/secure-storage": "workspace:*",
		"@octane-xplat/share": "workspace:*",
		"@octane-xplat/sounds": "workspace:*",
		"@octane-xplat/sqlite": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octane-xplat/video": "workspace:*",
		"@xplat/demos": "workspace:*"
	},
	"devDependencies": {
		"@bamboocss/dev": "1.56.2",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/bamboo": "workspace:*",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/macos-renderer": "workspace:*",
		"octane": "catalog:"
	},
	"peerDependencies": {
		"octane": ">=0.6.3 <1"
	}
}
