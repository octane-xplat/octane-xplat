{
	"name": "@octane-xplat/sentry",
	"version": "0.20.0",
	"description": "Sentry error and performance reporting for Octane xplat \u2014 @nativescript-community/sentry on iOS/Android, @sentry/browser on web",
	"keywords": [
		"android",
		"cross-platform",
		"nativescript",
		"octane",
		"xplat",
		"sentry",
		"crash-reporting",
		"errors"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/sentry",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/sentry"
	},
	"files": [
		"src",
		"platforms",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"test:artifacts": "node tests/source-map-artifacts.mjs",
		"typegen": "tsrx-typegen --target octane",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"devDependencies": {
		"@sentry/cli": "3.8.2",
		"vite": "catalog:",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"dependencies": {
		"@nativescript-community/sentry": "4.6.49",
		"@sentry/browser": "11.9.0",
		"@octane-xplat/lib": "workspace:*"
	}
}
