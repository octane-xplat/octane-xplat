{
	"targets": {
		"octane": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": ["./src/index.macos.ts", "./src/index.web.ts", "./src/index.ts"],
					"types": ["./types/generated/index.d.ts", "./types/generated/index.web.d.ts"]
				},
				"./*": {"source": "src/index.ts", "runtime": ["./src/*"], "types": ["./types/generated/*.d.ts"]},
				"./*.ts": {"source": "src/index.ts", "runtime": ["./src/*.ts"], "types": ["./types/generated/*.d.ts"]}
			}
		}
	},
	"sourceExtensions": {
		".ts": ".js",
		".tsx": ".js",
		".tsrx": ".js"
	},
	"overrides": {}
}
