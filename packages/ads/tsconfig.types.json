{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"allowImportingTsExtensions": true,
		"types": [
			"@nativescript/types"
		]
	},
	"include": [
		"src/types.ts",
		"src/ads.ts",
		"src/ads.web.ts",
		"src/ads.macos.ts",
		"src/ads.linux.ts",
		"src/ads.windows.ts",
		"src/index.ts",
		"src/index.web.ts",
		"src/index.macos.ts",
		"src/index.windows.ts",
		"src/props.ts",
		"src/native-elements.d.ts",
		"src/BannerAd.tsrx",
		"src/BannerAd.web.tsrx"
	]
}
