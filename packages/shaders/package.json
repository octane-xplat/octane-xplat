{
	"name": "@octane-xplat/shaders",
	"version": "0.18.0",
	"description": "Thin adapter that runs the published `shaders` WebGPU library on Octane xplat Canvas surfaces — web (implemented) and NativeScript iOS/Android (experimental, device verification pending)",
	"keywords": [
		"canvas",
		"cross-platform",
		"gpu",
		"graphics",
		"nativescript",
		"octane",
		"shader",
		"webgpu",
		"wgsl",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/shaders",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/shaders"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target shaders",
		"typecheck": "tsc -p tsconfig.check.json",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@octane-xplat/canvas": "workspace:*",
		"shaders": "4.0.5"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "7.0.0",
			"android": "7.0.0"
		}
	},
	"types": "./types/generated/index.d.ts"
}
