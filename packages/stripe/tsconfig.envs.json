{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"types": ["@nativescript/types"]
	},
	"environments": {
		"web": {
			"include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.ts"],
			"exclude": ["src/**/*.ios.ts", "src/**/*.android.ts", "src/**/*.macos.ts"]
		},
		"native": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"tests/runtime.ios.ts",
				"tests/spm-runtime.ios.ts"
			],
			"exclude": ["src/**/*.web.ts", "src/**/*.macos.ts"]
		},
		"macos": {
			"include": ["src/index.macos.ts", "src/**/*.macos.ts"]
		},
		"linux": {
			"include": ["src/index.linux.ts"]
		},
		"windows": {
			"include": ["src/index.windows.ts"]
		}
	}
}
