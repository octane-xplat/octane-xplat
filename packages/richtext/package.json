{
	"name": "@octane-xplat/richtext",
	"version": "0.16.1",
	"description": "Native rich-text editing leaf for Octane xplat — Android Aztec and AppKit WKWebView StarterKit",
	"keywords": [
		"android",
		"aztec",
		"cross-platform",
		"editor",
		"octane",
		"rich-text",
		"richtext",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/richtext",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/richtext"
	},
	"files": [
		"types",
		"src",
		"platforms",
		"nativescript.config.ts",
		"dist/macos/browser.js",
		"dist/macos/browser.d.ts",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/index.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		},
		"./macos-host": {
			"types": "./types/macos-host.d.ts",
			"default": "./src/NativeEditor.macos.tsx"
		},
		"./browser-transport": {
			"types": "./types/browser-transport.d.ts",
			"default": "./src/browser-transport.web.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"test:macos": "node test/verify-wk.mjs",
		"test:native": "vitest run --config vitest.native.config.mts",
		"test:packed": "node test/packed-consumer.mjs",
		"typegen": "tsc -p tsconfig.types.json",
		"build:assets": "node build-browser.ts",
		"prepack": "pnpm build:assets && pnpm typegen"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tiptap/core": "3.28.0",
		"@tiptap/starter-kit": "3.28.0",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"WebKit"
			]
		}
	}
}