{
	"name": "@octane-xplat/richtext",
	"version": "0.19.0",
	"description": "Native rich-text editing leaf for Octane xplat — Android Aztec and AppKit WKWebView StarterKit",
	"keywords": [
		"android",
		"aztec",
		"cross-platform",
		"editor",
		"octane",
		"rich-text",
		"richtext",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/richtext",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/richtext"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"nativescript.config.ts",
		"dist/macos/browser.js",
		"dist/macos/browser.d.ts",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./macos-host": {
			"types": "./types/generated/NativeEditor.macos.d.ts",
			"default": "./src/NativeEditor.macos.tsx"
		},
		"./browser-transport": {
			"types": "./types/generated/browser-transport.web.d.ts",
			"default": "./src/browser-transport.web.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --test test/*.test.mjs",
		"test:macos": "node test/verify-wk.mjs",
		"test:native": "vitest run --config vitest.native.config.mts",
		"test:packed": "node test/packed-consumer.mjs",
		"typegen": "tsrx-typegen --target richtext",
		"build:assets": "node build-browser.ts",
		"prepack": "bun run build:assets && bun run typegen && tsrx-typegen --pack-check",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.types.json"
	},
	"devDependencies": {
		"tsrx-typegen": "workspace:*",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@tiptap/core": "3.28.0",
		"@tiptap/starter-kit": "3.28.0",
		"esbuild": "0.27.7",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"WebKit"
			]
		}
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*"
	},
	"types": "./types/generated/index.d.ts"
}
