{
	"name": "@octane-xplat/richtext",
	"version": "0.11.0",
	"description": "Native rich-text editing leaf for Octane xplat — Android Aztec and AppKit WKWebView StarterKit",
	"keywords": [
		"android",
		"aztec",
		"cross-platform",
		"editor",
		"octane",
		"rich-text",
		"richtext",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/richtext",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/richtext"
	},
	"files": [
		"dist",
		"types",
		"src",
		"platforms",
		"nativescript.config.ts"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"default": "./src/index.web.ts"
			},
			"native": {
				"default": "./src/index.ts"
			},
			"default": "./src/index.ts"
		},
		"./macos-host": {
			"types": "./types/macos-host.d.ts",
			"default": "./src/NativeEditor.macos.tsx"
		},
		"./browser-transport": {
			"types": "./types/browser-transport.d.ts",
			"default": "./src/browser-transport.web.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.macos.d.ts",
					"default": "./src/index.macos.ts"
				},
				"web": {
					"types": "./types/index.d.ts",
					"default": "./dist/web/index.js"
				},
				"native": {
					"types": "./types/index.d.ts",
					"default": "./dist/native/index.js"
				},
				"types": "./types/index.d.ts",
				"default": "./dist/native/index.js"
			},
			"./macos-host": {
				"types": "./types/macos-host.d.ts",
				"default": "./src/NativeEditor.macos.tsx"
			},
			"./browser-transport": {
				"types": "./types/browser-transport.d.ts",
				"default": "./src/browser-transport.web.ts"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && tsc -p tsconfig.types.json && node ../../scripts/check-native-dist.mjs && node build-browser.mjs",
		"prepublishOnly": "pnpm build",
		"test": "node --test test/*.test.mjs",
		"test:macos": "node test/verify-wk.mjs",
		"test:packed": "node test/packed-consumer.mjs"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"@tiptap/core": "3.28.0",
		"@tiptap/starter-kit": "3.28.0",
		"octane": "0.6.3",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"WebKit"
			]
		}
	}
}
