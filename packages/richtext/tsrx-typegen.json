{
	"targets": {
		"richtext": {
			"renderer": "@octane-xplat/jsx",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.macos.ts",
						"./src/index.web.ts",
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.macos.d.ts",
						"./types/generated/index.web.d.ts",
						"./types/generated/index.d.ts"
					]
				},
				"./macos-host": {
					"source": "src/NativeEditor.macos.tsx",
					"runtime": [
						"./src/NativeEditor.macos.tsx"
					],
					"types": [
						"./types/generated/NativeEditor.macos.d.ts"
					]
				},
				"./browser-transport": {
					"source": "src/browser-transport.web.ts",
					"runtime": [
						"./src/browser-transport.web.ts"
					],
					"types": [
						"./types/generated/browser-transport.web.d.ts"
					]
				}
			}
		}
	},
	"overrides": {
		"index.d.ts": "types/overrides/index.d.ts"
	}
}
