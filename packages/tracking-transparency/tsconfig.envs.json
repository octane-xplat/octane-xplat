{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/tracking-transparency": ["../../../src/index.ts"] },
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"types": [
			"@nativescript/types"
		]
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"../../examples/privacy/tracking-actions.ts"
			],
			"exclude": [
				"src/**/*.ios.ts",
				"src/**/*.android.ts",
				"src/**/*.macos.ts"
			]
		},
		"native": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"tests/runtime.ios.ts"
			],
			"exclude": [
				"src/**/*.web.ts",
				"src/**/*.macos.ts"
			]
		},
		"macos": {
			"include": [
				"src/index.macos.ts",
				"src/**/*.macos.ts"
			]
		},
		"windows": {
			"include": [
				"src/index.windows.ts"
			]
		},
		"gtk": {
			"include": [
				"src/index.gtk.ts",
				"src/index.linux.ts"
			]
		}
	}
}
