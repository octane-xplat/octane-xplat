{
	"name": "@octane-xplat/tracking-transparency",
	"version": "0.19.0",
	"description": "Expo-shaped tracking authorization and explicit advertising-identifier access for Octane apps",
	"keywords": [
		"nativescript",
		"octane",
		"privacy",
		"tracking-transparency"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/tracking-transparency",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/tracking-transparency"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"examples",
		"!src/**/*.test.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.macos.ts",
			"gtk": "./src/index.gtk.ts",
			"linux": "./src/index.linux.ts",
			"windows": "./src/index.windows.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:ios-api": "node tests/native-api.mjs ios",
		"test:ios": "node tests/ios-runtime.mjs",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/jsx": "workspace:*",
		"@tsrx/typescript-plugin": "catalog:",
		"jsdom": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.3 <10",
		"octane": ">=0.16.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "9.1.0",
			"android": "9.1.0"
		}
	}
}
