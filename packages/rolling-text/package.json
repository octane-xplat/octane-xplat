{
	"name": "@octane-xplat/rolling-text",
	"version": "0.20.0",
	"description": "Rolling/slot-machine text label for Octane xplat \u2014 per-unit roll with survivor matching on web, iOS and Android",
	"keywords": [
		"android",
		"animated-text",
		"cross-platform",
		"ios",
		"nativescript",
		"octane",
		"rolling-text",
		"slot-text",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/rolling-text",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/rolling-text"
	},
	"files": [
		"types/generated",
		"src",
		"LICENSE.scritto",
		"LICENSE.slot-text",
		"UPSTREAM.md",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target rolling-text",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test:macos-runtime": "node tests/macos-runtime.mts",
		"test:intl": "node --test tests/intl.mts"
	},
	"dependencies": {
		"@formatjs/intl-getcanonicallocales": "3.3.0",
		"@formatjs/intl-locale": "5.4.1",
		"@formatjs/intl-segmenter": "12.3.0",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"jsdom": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"@octane-xplat/cli": "workspace:*"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/macos-appkit": "workspace:*",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"@octane-xplat/macos-appkit": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
