{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src"
	},
	"include": [
		"src/AnimatedImage.tsrx",
		"src/AnimatedImage.web.tsrx",
		"src/index.ts",
		"src/index.web.ts",
		"src/native-elements.d.ts",
		"src/props.ts"
	]
}
