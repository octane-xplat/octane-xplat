{
	"name": "@octane-xplat/haptics",
	"version": "0.20.0",
	"description": "Advanced, capability-aware haptics for Octane xplat",
	"keywords": [
		"android",
		"cross-platform",
		"haptic-feedback",
		"haptics",
		"ios",
		"nativescript",
		"octane",
		"taptic-engine",
		"vibration",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/haptics",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/haptics"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"scripts",
		"nativescript.config.ts",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target haptics",
		"test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mts",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.types.json",
		"test:ios-build": "node tests/ios-build.mts"
	},
	"dependencies": {
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"nativescript": "9.1.1",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"types": "./types/generated/index.d.ts"
}
