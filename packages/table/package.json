{
	"name": "@octane-xplat/table",
	"version": "0.18.0",
	"description": "Headless data grid for Octane xplat \u2014 @tanstack/table-core row model (sorting, filtering, pagination, selection, grouping) rendered through shared VirtualList on web, iOS, Android, and macOS",
	"keywords": [
		"android",
		"cross-platform",
		"data-grid",
		"datagrid",
		"ios",
		"nativescript",
		"octane",
		"table",
		"tanstack",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/table",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/table"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/generated/index.d.ts",
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target table",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@tanstack/table-core": "9.3.1"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
