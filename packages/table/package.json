{
	"name": "@octane-xplat/table",
	"version": "0.11.1",
	"description": "Headless data grid for Octane xplat — @tanstack/table-core row model (sorting, filtering, pagination, selection, grouping) rendered through shared VirtualList on web, iOS, Android, and macOS",
	"keywords": [
		"android",
		"cross-platform",
		"data-grid",
		"datagrid",
		"ios",
		"nativescript",
		"octane",
		"table",
		"tanstack",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/table",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/table"
	},
	"files": [
		"dist",
		"types",
		"src"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/index.d.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.macos.d.ts",
					"default": "./src/index.macos.ts"
				},
				"types": "./types/index.d.ts",
				"web": "./dist/web/index.js",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"test": "vitest run",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.web.json && tsrx-tsc --noEmit -p tsconfig.native.json"
	},
	"dependencies": {
		"@tanstack/table-core": "9.2.4"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.6.3",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
