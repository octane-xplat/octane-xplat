{
	"name": "@octane-xplat/fingerprint",
	"version": "0.20.0",
	"description": "Expo-shaped native compatibility fingerprints for Octane Xplat projects",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/fingerprint"
	},
	"bin": {
		"xplat-fingerprint": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --runExternalCode -p tsconfig.build.json",
		"typecheck": "tsc --runExternalCode -p tsconfig.build.json --noEmit",
		"test": "node --test tests/*.test.mjs",
		"prepack": "bun run build",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"jsonc-parser": "3.3.1",
		"minimatch": "11.0.3",
		"yaml": "2.9.1",
		"typescript-classic": "catalog:"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"@tsrx/content-mapper": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=22.22.2"
	}
}
