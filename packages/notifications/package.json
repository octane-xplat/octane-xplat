{
	"name": "@octane-xplat/notifications",
	"version": "0.9.0",
	"description": "Local notifications for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"cross-platform",
		"ios",
		"local-notifications",
		"nativescript",
		"notifications",
		"octane",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/notifications",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/notifications"
	},
	"files": [
		"src",
		"types",
		"platforms"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"default": "./src/index.ts"
		},
		"./*": "./src/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:packed": "node tests/packed-consumer.mjs",
		"build": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build",
		"test": "node --experimental-strip-types --test tests/notifications.macos.test.ts",
		"test:macos": "node tests/verify-macos.mjs"
	},
	"dependencies": {
		"@nativescript/local-notifications": "7.0.0",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"octane": "0.6.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"UserNotifications"
			]
		}
	}
}
