+        for (;;) {
+            // Device traffic takes priority: while the app is actively
+            // fetching, excess crawl workers pause so live demand owns the
+            // transform lanes; a small residual keeps warming the tail.
+            // They resume once demand goes quiet — a boot burst or aborted
+            // boot must not retire the crawl while a warming frontier
+            // remains.
+            if (options.signal?.aborted)
+                return;
+            if (workerIndex >= keepAlive && pending.length && options.isDeviceActive?.()) {
+                await yieldPause();
+                continue;
+            }
+            const path = pending.shift();
+            if (!path)
+                return;
+            visited.add(path);
+            let body;
+            try {
+                const response = await fetchImpl(path);
+                if (!response || response.status < 200 || response.status >= 300) {
+                    response?.body?.cancel?.().catch(() => { });
+                    continue;
+                }
+                body = await response.text();
+            }
+            catch {
+                continue;
+            }
+            for (const child of extractBootCrawlUrls(body)) {
+                enqueue(child);
+            }
+        }
+    };
+    await Promise.all(Array.from({ length: concurrency }, (_v, i) => worker(i)));
+    return { visited };
+}
