+ * handle whose `stop()` aborts the walk; `done` resolves with the visited
+ * path set (or the crawl error, which is logged and never rethrown).
+ */
+export function startBootGraphCrawl(server, options = {}) {
+    const verbose = !!options.verbose;
+    const log = (line) => {
+        if (verbose)
+            console.info(line);
+    };
+    const controller = new AbortController();
+    const state = { done: null, stop: () => controller.abort() };
+    const launch = () => {
+        const address = server.httpServer?.address?.();
+        if (!address || typeof address !== 'object' || !address.port)
