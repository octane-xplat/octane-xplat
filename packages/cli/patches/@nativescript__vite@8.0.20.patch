+++ b/hmr/server/boot-graph-crawl.js
@@ -0,0 +1,187 @@
+import { resolveProjectMainEntryPath } from './vite-plugin.js';
+// Boot graph crawl — server-side pre-warm of the device module graph.
+//
+// NativeScript iOS gives every module fetch a 5-second request budget (async
+// graph-walk and synchronous resolver alike), while a cold Vite transform can
+// take longer — the runtime's async walk then marks the dependency failed,
+// `LoadHttpModuleForUrl` falls back to a blocking synchronous fetch, and
+// hundreds of serial cold transforms blow the boot budget entirely. The
+// device walks the same served-code specifier graph this crawl traverses:
+// every reachable `/ns/*` URL is fetched through the real middleware, which
+// populates the shared transform cache and the /ns/m response memo during
+// the prepare/install window before the app launches. Device requests then
+// hit warm transforms and memoized responses instead of cold pipelines.
+//
+// The crawl only reads: it issues ordinary GETs through the existing
+// middleware, mutates no module state, and never blocks shutdown. Requests
+// carry `x-ns-vite-boot-crawl` so shared transform queueing can keep device
+// demand ahead of warm-up work (see shared-transform-request's priority).
+export const BOOT_CRAWL_HEADER = 'x-ns-vite-boot-crawl';
+const BOOT_CRAWL_HEADER_VALUE = '1';
+// The session descriptor mints recording sessions and is fetched exactly
+// once per device boot — the crawl is warm-up traffic, not a boot signal.
+const CRAWL_SKIP_PATHS = new Set(['/__ns_dev__/session', '/ns-hmr']);
+// `?t=169…` cache-busters are freshly minted per request (same policy as the
+// boot recorder) — crawling them only mints dead variants.
+const VOLATILE_T_PARAM_RE = /[?&]t=\d+(?:&|$)/;
+// Quoted strings in served JS that resolve onto the device's fetchable URL
+// spaces: /ns/* module/bridge routes and the served vendor bundle.
+const CRAWL_URL_RE = /["'`]([^"'`]*?\/(?:ns\/(?!hmr\b)[A-Za-z][^"'`]*|@nativescript\/vendor\.mjs))["'`]/g;
+/**
+ * Extract every `/ns/*` (and vendor bundle) URL the device would fetch from a
+ * served module body. Returns deduplicated `pathname+search` strings relative
+ * to the dev-server origin — the served code emits absolute URLs on the
+ * device-reachable host, but only the path component matters for crawling.
+ */
+export function extractBootCrawlUrls(code) {
+    const urls = new Set();
+    if (typeof code !== 'string' || !code)
+        return urls;
+    for (const match of code.matchAll(CRAWL_URL_RE)) {
+        let pathname;
+        try {
+            pathname = new URL(match[1], 'http://boot-crawl.invalid').pathname;
+        }
+        catch {
+            continue;
+        }
+        if (!pathname)
+            continue;
+        if (CRAWL_SKIP_PATHS.has(pathname))
+            continue;
+        const search = match[1].includes('?') ? match[1].slice(match[1].indexOf('?')) : '';
+        const pathWithSearch = search ? `${pathname}${search}` : pathname;
+        if (VOLATILE_T_PARAM_RE.test(pathWithSearch))
+            continue;
+        urls.add(pathWithSearch);
+    }
+    return urls;
+}
+/**
+ * Seed set covering the dev-client bootstrap (which names the entry-runtime,
+ * hot-context, css-handler, launch-bridge and core-bridge modules), the
+ * single-payload bundles, and the application entry itself.
+ */
