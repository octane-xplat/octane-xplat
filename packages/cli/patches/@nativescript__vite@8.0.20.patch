+/**
+ * Walk the served module graph with bounded concurrency. Each 2xx response
+ * body is scanned for child /ns/* specifiers that are queued for their own
+ * fetch, so the traversal reaches exactly the modules the runtime's async
+ * walk would request. `fetchImpl` defaults to global fetch against `origin`
+ * with the crawl header set; `signal` aborts the walk on server shutdown.
+ */
+export async function runBootGraphCrawl(options) {
+    const origin = options.origin;
