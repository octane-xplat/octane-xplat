+    return [
+        '/__ns_dev__/client',
+        '/ns/import-map.json',
+        '/@nativescript/vendor.mjs',
+        '/ns/deps-bundle.mjs',
+        '/ns/core-bundle.mjs',
+        '/ns/core',
+        `/ns/m${resolveProjectMainEntryPath(projectRoot)}`,
+    ];
