@@ -1569,11 +1569,25 @@ napi_value Pointer::customInspect(napi_env env, napi_callback_info info) {
 }

 void Pointer::finalize(napi_env env, void* data, void* hint) {
-  if (PostFinalizer(env, finalizePointerNow, data, hint)) {
+  // xplat: never erase from g_pointerCache re-entrantly. A GC finalization
+  // pass on the JS thread runs this inline inside outer napi calls that hold
+  // iterators into the map (getCachedPointer, cachePointer), leaving dangling
+  // iterators and corrupting the table. Always defer to the runloop instead.
+  ObjCBridgeState* bridgeState = ObjCBridgeState::InstanceData(env);
+  CFRunLoopRef runLoop = bridgeState != nullptr ? bridgeState->jsRunLoop : CFRunLoopGetMain();
+  if (runLoop == nullptr) {
+    if (PostFinalizer(env, finalizePointerNow, data, hint)) {
+      return;
+    }
+    finalizePointerNow(env, data, hint);
     return;
   }
-
-  finalizePointerNow(env, data, hint);
+  CFRetain(runLoop);
+  CFRunLoopPerformBlock(runLoop, kCFRunLoopCommonModes, ^{
+    finalizePointerNow(env, data, hint);
+    CFRelease(runLoop);
+  });
+  CFRunLoopWakeUp(runLoop);
 }

 Pointer::Pointer(void* data) { this->data = data; }
