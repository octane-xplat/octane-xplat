+// Marshals a JS-backed ffi callback onto the thread that owns the napi env.
+// Method and function IMPs invoked on a foreign thread must run their whole
+// body — argument conversion, the napi call, and the return conversion — on
+// the JS thread, so the invoking ObjC frame parks on a semaphore while the
+// JS runloop performs impl. This mirrors the ENABLE_JS_RUNTIME delivery path
+// JSBlockCallback uses, and works for generic-napi embedders too: jsRunLoop
+// is captured unconditionally at Closure construction. Unlike the TSFN block
+// path, delivery needs no env->loop servicing from the embedder and fires in
+// common modes, including nested modal runloops.
+void marshalCallbackToJSThread(ffi_cif* cif, void* ret, void* args[], void* data,
+                               void (*impl)(ffi_cif* cif, void* ret, void* args[], void* data)) {
+  Closure* closure = (Closure*)data;
+
+  closure->retain();
+  struct ClosureRetainGuard {
+    Closure* closure;
+    ~ClosureRetainGuard() {
+      if (closure != nullptr) {
+        closure->release();
+      }
+    }
+  } retainGuard{closure};
+
+  // A dead bridge state means the env is gone; no thread can legally run JS.
+  // Hand the ObjC caller a defined return instead of parking on a runloop
+  // that will never service the block, or dereferencing torn-down state.
+  if (closure->bridgeState != nullptr &&
+      !IsBridgeStateLive(closure->bridgeState, closure->bridgeStateToken)) {
+    if (ret != nullptr && cif->rtype != nullptr && cif->rtype->size > 0) {
+      memset(ret, 0, cif->rtype->size);
+    }
+    return;
+  }
+
+  if (std::this_thread::get_id() == closure->jsThreadId ||
+      shouldInvokeCallbackOnNativeCallerThread()) {
+    impl(cif, ret, args, data);
+    return;
+  }
+
+  CFRunLoopRef runloop = closure->jsRunLoop;
+  if (runloop == nullptr) {
+    runloop = CFRunLoopGetMain();
+  }
+
+  if (runloop == nullptr) {
+    impl(cif, ret, args, data);
+    return;
+  }
+
+  CFRetain(runloop);
+  dispatch_semaphore_t done = dispatch_semaphore_create(0);
+  CFRunLoopPerformBlock(runloop, kCFRunLoopCommonModes, ^{
+    impl(cif, ret, args, data);
+    dispatch_semaphore_signal(done);
+    CFRelease(runloop);
+  });
+  CFRunLoopWakeUp(runloop);
+  dispatch_semaphore_wait(done, DISPATCH_TIME_FOREVER);
+}
+
+void JSMethodCallback(ffi_cif* cif, void* ret, void* args[], void* data) {
+  marshalCallbackToJSThread(cif, ret, args, data, JSMethodCallbackImpl);
+}
+
+void JSFunctionCallback(ffi_cif* cif, void* ret, void* args[], void* data) {
+  marshalCallbackToJSThread(cif, ret, args, data, JSFunctionCallbackImpl);
