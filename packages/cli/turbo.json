{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		// The dist bundle reads the vendored packages' built dist files.
		"build": { "dependsOn": ["^typegen", "@octane-xplat/lib#build", "create-octane-xplat#build"] },
		// The release worker bundles the creator's Node compatibility export.
		"build:go": { "dependsOn": ["create-octane-xplat#build"], "inputs": ["$TURBO_DEFAULT$", "vendor/nativescript-cli/**", "../../tools/cli-go/**"] },
		"build:go-onnx": { "dependsOn": ["create-octane-xplat#build"], "inputs": ["$TURBO_DEFAULT$", "vendor/nativescript-cli/**", "../../tools/cli-go/**"] },
		"test:optimizer": { "dependsOn": ["build", "^build"], "outputs": [] },
		"test:toolchain": { "dependsOn": ["build", "^build"], "outputs": [] },
		"test:markdown": {
			"dependsOn": [],
			"outputs": []
		},
		"test:native-runtime": {
			"dependsOn": ["build"],
			"outputs": []
		},
		// Executes installed patched Core source outside Turbo's source inputs.
		"test:css-variables": {
			"dependsOn": [],
			"cache": false,
			"outputs": []
		},
		"test:css-platform": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"test:updates": {
			"dependsOn": ["build"],
			"outputs": []
		},
		// Install a consumer with distinct compatible PostCSS versions.
		"test:postcss-consumer": {
			"cache": false
		},
		// The tests exercise dist/ — a single turbo-scheduled build is the only
		// writer; in-script builds raced dependents' builds on the same dir.
		"test": {
			"dependsOn": ["build", "^typegen", "^build", "test:postcss-consumer"],
			"outputs": []
		}
	}
}
