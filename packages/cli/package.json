{
	"name": "@octane-xplat/cli",
	"version": "0.7.1",
	"description": "xplat — dev/build/doctor for octane-xplat apps (web + iOS + Android + experimental macOS)",
	"keywords": [
		"octane",
		"xplat",
		"cross-platform",
		"cli",
		"dev-server",
		"build",
		"doctor",
		"typecheck",
		"nativescript",
		"vite"
	],
	"license": "MIT",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/cli"
	},
	"bin": {
		"xplat": "./src/cli.mjs"
	},
	"files": [
		"src",
		"patches"
	],
	"type": "module",
	"exports": {
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./src/vite.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@alloc/cmd-ts": "0.17.1",
		"@clack/prompts": "1.8.1",
		"yaml": "2.9.1"
	}
}
