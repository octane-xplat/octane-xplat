{
	"name": "@octane-xplat/cli",
	"version": "0.18.0",
	"description": "xplat — dev/build/doctor for octane-xplat apps (web + iOS + Android + experimental macOS)",
	"keywords": [
		"build",
		"cli",
		"cross-platform",
		"dev-server",
		"doctor",
		"nativescript",
		"octane",
		"typecheck",
		"vite",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/cli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/cli"
	},
	"bin": {
		"xplat": "./bin/xplat.mjs"
	},
	"files": [
		"src",
		"dist",
		"bin",
		"patches"
	],
	"type": "module",
	"exports": {
		"./linux": {
			"types": "./src/linux/package.d.ts",
			"default": "./dist/linux/package.js"
		},
		"./macos": {
			"types": "./src/macos/dev.d.ts",
			"default": "./dist/macos/dev.js"
		},
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./macos/vite": {
			"types": "./src/macos/vite.d.ts",
			"default": "./dist/macos/vite.js"
		},
		"./linux-gtk/vite": {
			"types": "./src/linux-gtk/vite.d.ts",
			"default": "./dist/linux-gtk/vite.js"
		},
		"./mcp/code-service": {
			"default": "./dist/mcp/code-service.js"
		},
		"./mcp/docs-service": {
			"default": "./dist/mcp/docs-service.js"
		},
		"./mcp/*": "./dist/mcp/*.js",
		"./mcp/*.mjs": "./dist/mcp/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"prepack": "pnpm build",
		"test": "node --test --test-concurrency=2 test/*.test.mjs test/*.test.ts",
		"test:markdown": "node --test test/markdown-rich.test.ts",
		"test:css-platform": "node --test test/css-platform.test.mjs",
		"test:postcss-consumer": "node test/postcss-consumer.mjs",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@alloc/cmd-ts": "0.17.1",
		"@babel/core": "7.29.7",
		"@babel/plugin-transform-unicode-property-regex": "7.29.7",
		"@babel/plugin-transform-unicode-sets-regex": "7.29.7",
		"@clack/prompts": "1.8.1",
		"@octane-xplat/fmt": "0.1.0",
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/lint": "workspace:*",
		"@tsrx/core": "0.2.4",
		"create-octane-xplat": "workspace:*",
		"ignore": "7.0.12",
		"marked": "18.0.14",
		"postcss": "8.5.28",
		"postcss-load-config": "6.0.1",
		"wawoff2": "2.0.1",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@nativescript-community/vite-octane": "0.2.1",
		"@nativescript/core": "catalog:",
		"@nativescript/vite": "8.0.20",
		"@types/node": "24.10.1",
		"abort-controller": "3.0.0",
		"nativescript-vite-8-0-21": "npm:@nativescript/vite@8.0.21",
		"vite": "catalog:"
	}
}
