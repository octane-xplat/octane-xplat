{
	"name": "@octane-xplat/cli",
	"version": "0.19.0",
	"description": "xplat \u2014 dev/build/doctor for octane-xplat apps (web + iOS + Android + experimental macOS)",
	"keywords": [
		"build",
		"cli",
		"cross-platform",
		"dev-server",
		"doctor",
		"nativescript",
		"octane",
		"typecheck",
		"vite",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/cli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/cli"
	},
	"bin": {
		"xplat": "./bin/xplat.mjs"
	},
	"files": [
		"src",
		"dist",
		"bin",
		"patches",
		"!dist/xplat",
		"!dist/xplat.exe"
	],
	"type": "module",
	"exports": {
		"./linux": {
			"types": "./src/linux/package.d.ts",
			"default": "./dist/linux/package.js"
		},
		"./macos": {
			"types": "./src/macos/dev.d.ts",
			"default": "./dist/macos/dev.js"
		},
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./macos/vite": {
			"types": "./src/macos/vite.d.ts",
			"default": "./dist/macos/vite.js"
		},
		"./linux-gtk/vite": {
			"types": "./src/linux-gtk/vite.d.ts",
			"default": "./dist/linux-gtk/vite.js"
		},
		"./mcp/code-service": {
			"default": "./dist/mcp/code-service.js"
		},
		"./mcp/docs-service": {
			"default": "./dist/mcp/docs-service.js"
		},
		"./mcp/*": "./dist/mcp/*.js",
		"./mcp/*.mjs": "./dist/mcp/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"prepack": "bun run build",
		"test": "node --test --test-concurrency=2 test/*.test.mjs test/*.test.ts",
		"test:docs-search": "node --test test/mcp-docs.test.mjs",
		"test:native-runtime": "node --test test/vite-native-runtime.test.mjs",
		"test:markdown": "node --test test/markdown-rich.test.ts",
		"test:typecheck-envs": "node --test test/tsconfig-envs.test.mjs",
		"test:routes": "node --test --test-concurrency=2 test/route-*.test.mjs",
		"test:css-platform": "node --test test/css-platform.test.mjs",
		"test:updates": "node --test test/updates.test.mjs",
		"test:postcss-consumer": "node test/postcss-consumer.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"build:executable": "bun standalone/build.mjs",
		"test:executable": "node --test standalone/test.mjs",
		"test:patches-pnpm": "node --test standalone/patches-pnpm.test.mjs",
		"test:patches-install": "node --test test/patches-*.test.mjs standalone/patches-install.test.mjs",
		"build:nim": "node ../../tools/cli-nim/build.mjs",
		"test:nim": "node --test ../../tools/cli-nim/native.test.mjs ../../tools/cli-nim/package.test.mjs ../../tools/cli-nim/args.test.mjs ../../tools/cli-nim/workspace.test.mjs",
		"pack:nim": "node ../../tools/cli-nim/pack.mjs",
		"test:nim-packages": "node --test ../../tools/cli-nim/package-manager.test.mjs",
		"test:nim-identity": "node --test ../../tools/cli-nim/identity.test.mjs",
		"test:nim-code": "node --test ../../tools/cli-nim/code.test.mjs ../../tools/cli-nim/code-command.test.mjs ../../tools/cli-nim/build-record.test.mjs",
		"check:nim": "node ../../tools/cli-nim/check.mjs",
		"benchmark:nim": "node ../../tools/cli-nim/benchmark.mjs",
		"benchmark:nim-routes": "node ../../tools/cli-nim/benchmark-routes.mjs",
		"test:nim-docs": "node --test ../../tools/cli-nim/docs.test.mjs ../../tools/cli-nim/docs-service.test.mjs ../../tools/cli-nim/guidance-command.test.mjs ../../tools/cli-nim/docs-read-command.test.mjs ../../tools/cli-nim/docs-search-command.test.mjs",
		"test:nim-index": "node --test ../../tools/cli-nim/sqlite.test.mjs ../../tools/cli-nim/docs-index.test.mjs",
		"prepare:nim-tokenizer": "node ../../tools/cli-nim/model-fixtures.mjs --tokenizer-only",
		"test:nim-tokenizer": "node --test ../../tools/cli-nim/tokenizer.test.mjs",
		"prepare:nim-model": "node ../../tools/cli-nim/ort-fixtures.mjs",
		"build:nim-model": "node ../../tools/cli-nim/build-model.mjs",
		"test:nim-model": "node --test ../../tools/cli-nim/model.test.mjs",
		"test:nim-http": "node --test ../../tools/cli-nim/http.test.mjs",
		"build:nim-http": "node ../../tools/cli-nim/build-probe.mjs http",
		"test:nim-http-live": "node ../../tools/cli-nim/http-live.mjs",
		"build:nim-process": "node ../../tools/cli-nim/build-probe.mjs process",
		"test:nim-process": "node --test ../../tools/cli-nim/process.test.mjs ../../tools/cli-nim/process-windows.test.mjs",
		"test:nim-build-tools": "node ../../tools/cli-nim/build-tools-consumer.mjs --with-native-cli",
		"build:nim-docs-compute": "node ../../tools/cli-nim/build-probe.mjs docs-compute",
		"test:nim-docs-compute": "node --test ../../tools/cli-nim/docs-compute.test.mjs",
		"build:nim-env": "node ../../tools/cli-nim/build-probe.mjs env",
		"test:nim-env": "node --test ../../tools/cli-nim/env.test.mjs",
		"test:nim-route-command": "node --test --test-concurrency=2 ../../tools/cli-nim/routes-command.test.mjs ../../tools/cli-nim/routes-watch.test.mjs",
		"test:nim-prerequisites": "node --test ../../tools/cli-nim/prerequisites.test.mjs",
		"test:nim-actions": "node --test ../../tools/cli-nim/actions-command.test.mjs ../../tools/cli-nim/actions-worker.test.mjs",
		"test:nim-lint": "node --test ../../tools/cli-nim/lint-command.test.mjs",
		"test:nim-status": "node --test ../../tools/cli-nim/status.test.mjs",
		"test:nim-targets": "node --test ../../tools/cli-nim/targets.test.mjs",
		"test:nim-sessions": "node --test ../../tools/cli-nim/sessions.test.mjs",
		"test:nim-attach": "node --test ../../tools/cli-nim/attach.test.mjs",
		"test:nim-history": "node --test ../../tools/cli-nim/history.test.mjs",
		"test:nim-reports": "node --test ../../tools/cli-nim/reports.test.mjs",
		"test:macos-packaging": "node --test test/macos-config.test.mjs test/macos-native.test.mjs test/macos-dev-bundle.test.mjs",
		"test:nim-macos-publication": "node --test ../../tools/cli-nim/macos-publication.test.mjs",
		"test:nim-macos-build": "node ../../tools/cli-nim/macos-build-consumer.mjs --with-native-cli",
		"test:nim-macos-dev": "node ../../tools/cli-nim/macos-dev-consumer.mjs",
		"test:nim-runtime-build": "node --test ../../tools/cli-nim/runtime-build.test.mjs",
		"test:nim-runtime-logs": "node --test ../../tools/cli-nim/runtime-logs.test.mjs",
		"test:nim-jobs": "node --test ../../tools/cli-nim/jobs.test.mjs",
		"build:nim-rpc": "node ../../tools/cli-nim/build-probe.mjs rpc",
		"test:nim-rpc": "node --test ../../tools/cli-nim/rpc.test.mjs",
		"build:nim-host": "node ../../tools/cli-nim/build-probe.mjs host",
		"test:nim-host": "node --test ../../tools/cli-nim/host-integration.test.mjs",
		"test:nim-host-bootstrap": "node --test ../../tools/cli-nim/host-bootstrap.test.mjs",
		"test:nim-typecheck": "node --test ../../tools/cli-nim/typecheck-command.test.mjs",
		"test:nim-worker": "node --test ../../tools/cli-nim/build-worker.test.mjs",
		"test:nim-routes": "node --test ../../tools/cli-nim/route-path.test.mjs ../../tools/cli-nim/route-generation.test.mjs ../../tools/cli-nim/route-templates.test.mjs"
	},
	"dependencies": {
		"@alloc/cmd-ts": "0.17.1",
		"@babel/core": "8.0.9",
		"@babel/plugin-transform-unicode-property-regex": "8.0.1",
		"@babel/plugin-transform-unicode-sets-regex": "8.0.1",
		"@clack/prompts": "1.8.1",
		"@octane-xplat/docs-search": "workspace:*",
		"@octane-xplat/fmt": "0.1.1",
		"@octane-xplat/lib": "workspace:*",
		"@octane-xplat/lint": "workspace:*",
		"@tsrx/core": "0.5.5",
		"create-octane-xplat": "workspace:*",
		"ignore": "7.0.14",
		"jsonc-parser": "3.3.1",
		"marked": "18.1.2",
		"postcss": "8.5.32",
		"postcss-load-config": "6.0.1",
		"wawoff2": "2.0.1",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@nativescript-community/vite-octane": "0.2.1",
		"@nativescript/core": "catalog:",
		"@nativescript/vite": "8.0.20",
		"@types/node": "24.10.1",
		"abort-controller": "3.0.0",
		"nativescript-vite-8-0-21": "npm:@nativescript/vite@8.0.21",
		"vite": "catalog:"
	}
}
