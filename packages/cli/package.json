{
	"name": "@octane-xplat/cli",
	"version": "0.21.0",
	"description": "xplat — dev/build/doctor for octane-xplat apps (web + iOS + Android + experimental macOS)",
	"keywords": [
		"build",
		"cli",
		"cross-platform",
		"dev-server",
		"doctor",
		"nativescript",
		"octane",
		"typecheck",
		"vite",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/cli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/cli"
	},
	"bin": {
		"xplat": "./bin/xplat.exe"
	},
	"files": [
		"src",
		"dist",
		"bin",
		"patches",
		"!dist/xplat",
		"!dist/xplat.exe",
		"install-native.mjs"
	],
	"type": "module",
	"exports": {
		"./linux": {
			"types": "./src/linux/package.d.ts",
			"default": "./dist/linux/package.js"
		},
		"./macos": {
			"types": "./src/macos/dev.d.ts",
			"default": "./dist/macos/dev.js"
		},
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./macos/vite": {
			"types": "./src/macos/vite.d.ts",
			"default": "./dist/macos/vite.js"
		},
		"./linux-gtk/vite": {
			"types": "./src/linux-gtk/vite.d.ts",
			"default": "./dist/linux-gtk/vite.js"
		},
		"./mcp/code-service": {
			"default": "./dist/mcp/code-service.js"
		},
		"./mcp/docs-service": {
			"default": "./dist/mcp/docs-service.js"
		},
		"./mcp/*": "./dist/mcp/*.js",
		"./mcp/*.mjs": "./dist/mcp/*.js",
		"./worker": "./dist/build-worker.js",
		"./tsrx-mapper": "./bin/tsrx-mapper.mjs",
		"./package.json": "./package.json"
	},
	"typescript": {
		"contentMapper": {
			"exec": ["node", "bin/tsrx-mapper.mjs"],
			"dynamicConfig": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"prepack": "node install-native.mjs --prepare-package && bun run build",
		"test": "node --test --test-concurrency=2 test/*.test.mts test/*.test.ts",
		"test:docs-search": "node --test test/mcp-docs.test.mts",
		"test:native-runtime": "node --test test/vite-native-runtime.test.mts test/mason-layout.test.mts",
		"test:markdown": "node --test test/markdown-rich.test.ts",
		"test:typecheck-envs": "node --test test/tsconfig-envs.test.mts",
		"test:routes": "node --test --test-concurrency=2 test/route-*.test.mts",
		"test:css-variables": "node --test test/native-css-variables.test.mts",
		"test:css-platform": "node --test test/css-platform.test.mts test/css-layers.test.mts test/vite-inline-stylesheets.test.mts",
		"test:updates": "node --test test/updates.test.mts",
		"test:postcss-consumer": "node test/postcss-consumer.mts",
		"typecheck": "tsc --runExternalCode -p tsconfig.json",
		"test:patches-install": "node --test test/patches-*.test.mts",
		"test:macos-packaging": "node --test test/macos-config.test.mts test/macos-native.test.mts test/macos-dev-bundle.test.mts",
		"test:fmt": "node --test test/fmt.test.mjs",
		"test:compatibility": "node --test test/compatibility.test.mjs",
		"test:doctor": "node --test test/doctor-checks.test.mjs",
		"build:go": "node ../../tools/cli-go/build.mjs --cli",
		"build:go-onnx": "node ../../tools/cli-go/build.mjs --cli --onnx",
		"test:go-dev": "node --test ../../tools/cli-go/dev.test.mts",
		"test:go-cli": "node --test ../../tools/cli-go/cli.test.mts",
		"test:go-clean": "node --test ../../tools/cli-go/clean.test.mts",
		"test:go-patches": "node --test ../../tools/cli-go/patches.test.mts",
		"test:go-foreground-input": "node --test ../../tools/cli-go/foreground-input.test.mts",
		"test:go-response-roots": "node --test --test-name-pattern=response.roots ../../tools/cli-go/doctor.test.mts ../../tools/cli-go/patches.test.mts",
		"test:go-doctor": "node --test ../../tools/cli-go/doctor.test.mts",
		"test:go-release-worker": "node --test ../../tools/cli-go/release-worker.test.mts",
		"test:go-native-entry": "node --test ../../tools/cli-go/native-entry.test.mts",
		"test:go-package": "node --test ../../tools/cli-go/package.test.mts ../../tools/cli-go/stage-release.test.mts",
		"test:go-registry": "node --test ../../tools/cli-go/registry-package.test.mts",
		"test:go-device-relay": "node --test test/dev-device-relay.test.mts",
		"test:go-workshop-macos": "node --test ../../tools/cli-go/workshop-macos.test.mts",
		"test:go-workshop-engine": "node --test ../../tools/cli-go/workshop-engine.test.mts",
		"test:go-workshop": "node --test ../../tools/cli-go/workshop.test.mts",
		"test:go-fonts": "node --test ../../tools/cli-go/fonts.test.mts",
		"test:fonts": "node --test test/fonts.test.mts test/ios-variable-font.test.mts",
		"test:go-updates": "node --test ../../tools/cli-go/updates.test.mts",
		"test:go-add": "node --test ../../tools/cli-go/add.test.mts",
		"test:go-upgrade": "node --test ../../tools/cli-go/upgrade.test.mts",
		"test:go-routes": "node --test ../../tools/cli-go/routes.test.mts",
		"test:go-build-macos-real": "node --test ../../tools/cli-go/build-macos-real.test.mts",
		"test:go-nativescript-real": "node ../../tools/cli-go/nativescript-real.mts",
		"test:go-dev-android-real": "node ../../tools/cli-go/dev-android-real.mts",
		"test:go-dev-android-http": "node ../../tools/cli-go/dev-android-http.mts",
		"test:go-dev-ios-real": "node ../../tools/cli-go/dev-ios-real.mts",
		"test:go-linux-build": "node --test ../../tools/cli-go/linux-build.test.mts",
		"test:go-build": "node --test ../../tools/cli-go/build-command.test.mts",
		"test:go-lint": "node --test ../../tools/cli-go/lint.test.mts",
		"test:go-fmt": "node --test ../../tools/cli-go/format.test.mts",
		"test:go-typecheck": "node --test ../../tools/cli-go/typecheck.test.mts",
		"test:go-typecheck-real": "node --test ../../tools/cli-go/typecheck-real.test.mts",
		"measure:go-cli": "node ../../tools/cli-go/measure.mjs",
		"measure:go-cli-onnx": "node ../../tools/cli-go/measure.mjs --onnx",
		"test:go-binding": "node --test ../../tools/cli-go/package-binding.test.mts",
		"test:go-code": "node --test ../../tools/cli-go/code.test.mts",
		"test:go-doc-data": "node --test ../../tools/cli-go/doc-data.test.mts",
		"test:go-doc-snapshot": "node --test ../../tools/cli-go/doc-snapshot.test.mts",
		"test:go-docs": "node --test ../../tools/cli-go/docs.test.mts",
		"test:go-doc-index": "node --test ../../tools/cli-go/docs-index.test.mts",
		"test:go-dev-server": "node --test ../../tools/cli-go/dev-server.test.mts",
		"test:go-reports": "node --test ../../tools/cli-go/reports.test.mts",
		"test:go-android-reports-real": "node ../../tools/cli-go/android-reports-real.mts --run",
		"postinstall": "node install-native.mjs",
		"postpack": "node install-native.mjs"
	},
	"dependencies": {
		"@babel/core": "8.1.0",
		"@babel/plugin-transform-unicode-property-regex": "8.0.1",
		"@babel/plugin-transform-unicode-sets-regex": "8.0.1",
		"@octane-xplat/docs-search": "workspace:*",
		"@octane-xplat/fmt": "0.3.0",
		"@octane-xplat/lib": "workspace:*",
		"@tsrx/content-mapper": "catalog:",
		"@tsrx/core": "0.5.5",
		"create-octane-xplat": "workspace:*",
		"ignore": "7.0.14",
		"jsonc-parser": "3.3.1",
		"marked": "18.1.2",
		"postcss": "8.5.32",
		"postcss-load-config": "6.0.1",
		"postcss-value-parser": "4.2.0",
		"wawoff2": "2.0.1",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@nativescript-community/vite-octane": "0.2.1",
		"@nativescript/core": "catalog:",
		"@nativescript/vite": "8.0.20",
		"@tsrx/content-mapper": "catalog:",
		"@types/node": "26.6.6",
		"abort-controller": "3.0.0",
		"nativescript-vite-8-0-21": "npm:@nativescript/vite@8.0.21",
		"typescript": "catalog:",
		"typescript-classic": "catalog:",
		"vite": "catalog:"
	}
}
