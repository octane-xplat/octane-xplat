{
	"name": "@octane-xplat/cli",
	"version": "0.14.0",
	"description": "xplat \u2014 dev/build/doctor for octane-xplat apps (web + iOS + Android + experimental macOS)",
	"keywords": [
		"build",
		"cli",
		"cross-platform",
		"dev-server",
		"doctor",
		"nativescript",
		"octane",
		"typecheck",
		"vite",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/cli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/cli"
	},
	"bin": {
		"xplat": "./src/cli.mjs"
	},
	"files": [
		"src",
		"patches"
	],
	"type": "module",
	"exports": {
		"./linux": {
			"types": "./src/linux/package.d.ts",
			"default": "./src/linux/package.mjs"
		},
		"./macos": {
			"types": "./src/macos/dev.d.ts",
			"default": "./src/macos/dev.mjs"
		},
		"./vite": {
			"types": "./src/vite.d.ts",
			"default": "./src/vite.mjs"
		},
		"./macos/vite": {
			"types": "./src/macos/vite.d.ts",
			"default": "./src/macos/vite.mjs"
		},
		"./mcp/code-service": {
			"default": "./src/mcp/code-service.mjs"
		},
		"./mcp/docs-service": {
			"default": "./src/mcp/docs-service.mjs"
		},
		"./mcp/*": "./src/mcp/*.mjs",
		"./mcp/*.mjs": "./src/mcp/*.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@alloc/cmd-ts": "0.17.1",
		"@clack/prompts": "1.8.1",
		"@octane-xplat/fmt": "0.1.0",
		"@tsrx/core": "0.2.4",
		"create-octane-xplat": "workspace:*",
		"ignore": "7.0.12",
		"marked": "18.0.14",
		"wawoff2": "2.0.1",
		"yaml": "2.9.1"
	}
}
