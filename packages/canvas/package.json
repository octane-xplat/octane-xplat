{
	"name": "@octane-xplat/canvas",
	"version": "0.19.0",
	"description": "Canvas/GPU surface for Octane xplat — web <canvas> + @nativescript/canvas (2D, WebGL/WebGL2, WebGPU/WGSL)",
	"keywords": [
		"canvas",
		"cross-platform",
		"gpu",
		"graphics",
		"nativescript",
		"octane",
		"webgl",
		"webgl2",
		"webgpu",
		"wgsl",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/canvas",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/canvas"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.macos.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target canvas",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"test:macos-runtime": "node ../../scripts/probe.ts run tests/unsupported.macos.tsrx --target macos --deps @octane-xplat/canvas",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.types.json"
	},
	"dependencies": {
		"@nativescript/canvas": "3.0.0-beta.6",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/macos-renderer": "workspace:*",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"@octane-xplat/macos-renderer": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
