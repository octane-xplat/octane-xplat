{
  "name": "@octane-xplat/desktop",
  "version": "0.20.0",
  "description": "Native desktop application menus, tray icons, app residency and global shortcuts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/octane-xplat/octane-xplat",
    "directory": "packages/desktop"
  },
  "files": [
    "types/generated",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./types/generated/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/generated/index.d.ts",
      "macos": "./dist/index.macos.js",
      "gtk": "./dist/index.gtk.js",
      "windows": "./dist/index.windows.js",
      "web": "./dist/index.web.js",
      "browser": "./dist/index.web.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --runExternalCode -p tsconfig.build.json --declaration false",
    "typegen": "tsrx-typegen --target desktop",
    "typecheck": "node ../../scripts/typecheck.ts",
    "test": "vitest run",
    "pack:check": "tsrx-typegen --pack-check",
    "prepack": "bun run build && tsrx-typegen --pack-check",
    "test:packed": "node tests/menu/packed-consumer.mts && node tests/tray/packed-consumer.mts && node tests/shortcuts/packed-consumer.mts",
    "test:window-gtk-runtime": "node tests/window/gtk-runtime.mts",
    "test:window-macos-runtime": "node tests/window/macos-runtime.mts",
    "test:tray-macos-runtime": "node tests/tray/appkit-runtime.mts",
    "test:tray-macos-packaged": "node tests/tray/macos-packaged.mts",
    "test:tray-gtk-runtime": "node tests/tray/gtk-runtime.mts",
    "test:tray-windows-runtime": "node tests/tray/windows-runtime.mts",
    "test:shortcuts-macos-runtime": "node tests/shortcuts/macos-runtime.mts",
    "test:shortcuts-gtk-runtime": "node tests/shortcuts/gtk-runtime.mts",
    "test:shortcuts-windows-runtime": "node tests/shortcuts/windows-runtime.mts",
    "test:menu-gtk-runtime": "node tests/menu/gtk-runtime.mts",
    "test:menu-windows-runtime": "node tests/menu/windows-runtime.mts"
  },
  "dependencies": {
    "@octane-xplat/lib": "workspace:*",
    "@octane-xplat/platform": "workspace:*"
  },
  "devDependencies": {
    "@nativescript/core": "https://pkg.pr.new/@nativescript/core@abae298",
    "@octane-xplat/ui": "workspace:*",
    "@tsrx/content-mapper": "catalog:",
    "tsrx-typegen": "workspace:*",
    "typescript": "catalog:",
    "typescript-classic": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nativescript/core": ">=9.1.4-0 <10"
  },
  "peerDependenciesMeta": {
    "@nativescript/core": {
      "optional": true
    }
  }
}
