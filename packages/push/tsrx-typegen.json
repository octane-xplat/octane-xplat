{
	"targets": {
		"push": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.macos.ts",
						"./src/index.web.ts",
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.macos.d.ts",
						"./types/generated/index.web.d.ts",
						"./types/generated/index.d.ts"
					]
				},
				"./firebase-messaging-sw.js": {
					"source": "src/index.ts",
					"runtime": "./web/firebase-messaging-sw.js",
					"types": "./web/firebase-messaging-sw.d.ts"
				}
			}
		}
	}
}
