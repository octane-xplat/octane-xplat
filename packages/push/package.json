{
	"name": "@octane-xplat/push",
	"version": "0.10.0",
	"description": "Push notifications for Octane xplat — Firebase Cloud Messaging via @nativescript/firebase-messaging on iOS/Android and the Firebase JS SDK on web",
	"keywords": [
		"android",
		"apns",
		"cross-platform",
		"fcm",
		"firebase",
		"ios",
		"nativescript",
		"octane",
		"push",
		"push-notifications",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/push",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/push"
	},
	"files": [
		"dist",
		"types",
		"src",
		"web"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": "./src/index.macos.ts",
			"types": "./types/index.d.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./firebase-messaging-sw.js": {
			"types": "./web/firebase-messaging-sw.d.ts",
			"default": "./web/firebase-messaging-sw.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./types/index.d.ts",
				"web": "./dist/web/index.js",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			},
			"./firebase-messaging-sw.js": {
				"types": "./web/firebase-messaging-sw.d.ts",
				"default": "./web/firebase-messaging-sw.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/firebase-core": "5.0.2",
		"@nativescript/firebase-messaging": "5.0.2",
		"firebase": "12.19.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
