{
	"name": "@octane-xplat/camera",
	"version": "0.19.0",
	"description": "Live camera preview for Octane xplat \u2014 web getUserMedia + native capture (AVCapture / CameraX)",
	"keywords": [
		"android",
		"camera",
		"camera-preview",
		"cross-platform",
		"ios",
		"nativescript",
		"octane",
		"photo",
		"video-capture",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/camera",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/camera"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"linux": "./src/index.web.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./photo-sheet.macos": {
			"types": "./src/photo-sheet.macos.ts",
			"native": "./src/photo-sheet.macos.ts",
			"default": "./src/photo-sheet.macos.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target camera",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:ios-writer": "node tests/ios-writer-simulator.mjs",
		"test:ios-device": "node tests/ios-device.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "vitest run && node --test tests/*.test.mjs",
		"test:web": "node tests/browser-conformance.web.mjs",
		"test:webkitgtk": "node tests/webkitgtk-conformance.linux.mjs",
		"typecheck": "tsc --runExternalCode --noEmit -p tsconfig.types.json",
		"test:macos-runtime": "node tests/packed-consumer.mjs --macos-native"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"mediabunny": "1.62.1"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@nativescript/macos-node-api": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"typescript-classic": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1",
		"@nativescript/macos-node-api": "0.5.0-beta.0"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		},
		"@nativescript/macos-node-api": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "7.0.0",
			"android": "7.0.0"
		}
	},
	"types": "./types/generated/index.d.ts"
}
