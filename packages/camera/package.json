{
	"name": "@octane-xplat/camera",
	"version": "0.18.0",
	"description": "Live camera preview for Octane xplat — web getUserMedia + native capture (AVCapture / CameraX)",
	"keywords": [
		"android",
		"camera",
		"camera-preview",
		"cross-platform",
		"ios",
		"nativescript",
		"octane",
		"photo",
		"video-capture",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/camera",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/camera"
	},
	"files": [
		"types/generated",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"linux": "./src/index.web.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target camera",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "vitest run && node --test tests/*.test.mjs",
		"test:macos-photo": "node tests/photo-native.macos.mjs",
		"test:macos-photo-hardware": "node tests/photo-hardware.macos.mjs",
		"test:web": "node tests/browser-conformance.web.mjs",
		"test:webkitgtk": "node tests/webkitgtk-conformance.linux.mjs",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.types.json"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"mediabunny": "1.62.1"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"@nativescript/macos-node-api": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1",
		"@nativescript/macos-node-api": "0.4.4-next.2026-08-09-31292056208"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		},
		"@nativescript/macos-node-api": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"ios": "7.0.0",
			"android": "7.0.0"
		}
	},
	"xplat": {
		"macos": {
			"swiftHeaderImports": [
				"AppKit/AppKit.h"
			],
			"frameworks": [
				"AVFoundation",
				"CoreMedia",
				"AppKit"
			]
		}
	},
	"types": "./types/generated/index.d.ts"
}
