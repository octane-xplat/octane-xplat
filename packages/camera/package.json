{
	"name": "@octane-xplat/camera",
	"version": "0.8.0",
	"description": "Live camera preview for Octane xplat — web getUserMedia + native capture (AVCapture / CameraX)",
	"keywords": [
		"octane",
		"xplat",
		"cross-platform",
		"camera",
		"camera-preview",
		"photo",
		"video-capture",
		"nativescript",
		"ios",
		"android",
		"web"
	],
	"license": "MIT",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/camera",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/camera"
	},
	"files": ["dist", "types", "src", "platforms"],
	"type": "module",
	"nativescript": {
		"platforms": {
			"ios": "7.0.0",
			"android": "7.0.0"
		}
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./types/index.d.ts",
				"web": "./dist/web/index.js",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			}
		}
	},
	"scripts": {
		"build": "vite build && vite build --mode native && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.6.3",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": { "optional": true },
		"@nativescript/core": { "optional": true },
		"octane": { "optional": true }
	}
}
