{
	"extends": ["//"],
	"tasks": {
		"typegen": {
			"outputs": ["types/generated/**/*.d.ts", "types/generated/.tsrx-typegen-manifest.json"]
		},
		"build": {
			"outputs": ["dist/**/*.js"]
		},
		"typecheck": {
			"dependsOn": ["typegen", "^typegen"],
			"inputs": ["$TURBO_DEFAULT$", "../../scripts/typecheck.ts", "../../packages/cli/src/tsconfig-envs.ts", "../../examples/keyboard-shortcuts/global-quick-entry.ts"]
		},
		"test:windows-runtime": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["GLOBAL_SHORTCUTS_WINDOWS_HOST", "GLOBAL_SHORTCUTS_WINDOWS_RUNTIME"]
		},
		"test:macos-runtime": {
			"dependsOn": ["typegen", "build"],
			"cache": false
		},
		"test:gtk-runtime": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["GLOBAL_SHORTCUTS_LINUX_HOST"]
		}
	}
}
