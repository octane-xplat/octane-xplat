{
	"extends": ["//"],
	"tasks": {
		"typegen": {
			"outputs": ["types/generated/**/*.d.ts"]
		},
		"build": {
			"outputs": ["dist/**/*.js"]
		},
		"typecheck": {
			"dependsOn": ["typegen", "^typegen"]
		},
		"test:windows-runtime": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["GLOBAL_SHORTCUTS_WINDOWS_HOST", "GLOBAL_SHORTCUTS_WINDOWS_RUNTIME"]
		},
		"test:macos-runtime": {
			"dependsOn": ["typegen", "build"],
			"cache": false
		},
		"test:gtk-runtime": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["GLOBAL_SHORTCUTS_LINUX_HOST"]
		}
	}
}
