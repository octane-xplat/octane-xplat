{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/global-shortcuts": ["../../../src/index.ts"] }
	},
	"environments": {
		"web": {
			"include": ["src/**/*.ts", "../../examples/keyboard-shortcuts/global-quick-entry.ts"]
		},
		"macos": {
			"files": ["src/index.macos.ts"]
		},
		"gtk": {
			"files": [
				"../linux-gtk-renderer/src/gi.d.ts",
				"../linux-gtk-renderer/src/host-globals.d.ts",
				"src/index.gtk.ts"
			]
		},
		"windows": {
			"files": ["src/index.windows.ts"]
		}
	}
}
