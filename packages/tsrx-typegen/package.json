{
	"name": "tsrx-typegen",
	"version": "0.3.0",
	"description": "Generate consumer-ready TypeScript declarations for TSRX libraries",
	"keywords": [
		"build-tool",
		"codegen",
		"declarations",
		"dts",
		"tsrx",
		"typegen",
		"typescript"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/tsrx-typegen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/tsrx-typegen"
	},
	"bin": {
		"tsrx-typegen": "./bin/tsrx-typegen.mjs"
	},
	"files": [
		"src",
		"dist",
		"bin"
	],
	"type": "module",
	"scripts": {
		"build": "vite build",
		"prepack": "pnpm build",
		"test": "pnpm build && node tests/pack-check.mjs && node tests/packed-consumer.mjs",
