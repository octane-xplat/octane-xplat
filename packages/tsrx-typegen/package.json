	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@tsrx/typescript-plugin": ">=0.4.11 <1",
		"typescript": ">=5.9.3 <6"
	}
}
