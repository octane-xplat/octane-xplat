{
	"name": "tsrx-typegen",
	"version": "0.6.1",
	"description": "Generate consumer-ready TypeScript declarations for TSRX libraries",
	"keywords": [
		"build-tool",
		"codegen",
		"declarations",
		"dts",
		"tsrx",
		"typegen",
		"typescript"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/tsrx-typegen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/tsrx-typegen"
	},
	"bin": {
		"tsrx-typegen": "./bin/tsrx-typegen.mjs"
	},
	"files": [
		"src",
		"dist",
		"bin"
	],
	"type": "module",
	"scripts": {
		"build": "vite build",
		"prepack": "bun run build",
		"test": "bun run build && node tests/pack-check.mts && node tests/packed-consumer.mts",
		"typecheck": "tsc --runExternalCode -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"vite": "catalog:"
	},
	"dependencies": {
		"typescript": "7.1.0-beta",
		"typescript-classic": "npm:typescript@5.9.3"
	}
}
