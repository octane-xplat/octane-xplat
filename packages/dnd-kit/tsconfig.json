{
	"compilerOptions": {
		"strict": true,
		"isolatedDeclarations": true,
		"skipLibCheck": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"paths": {
			"@octane-xplat/ui": ["../ui/types/generated/index.d.ts"]
		},
		"allowImportingTsExtensions": true
	},
	"include": ["src/index.ts"],
	"exclude": ["**/*.test.*"]
}
