{
	"name": "@octane-xplat/dnd-kit",
	"version": "0.18.0",
	"description": "Drag and drop and sortable lists for Octane web and NativeScript",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/dnd-kit",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/dnd-kit"
	},
	"files": [
		"types",
		"src",
		"README.md",
		"examples",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.json",
		"typecheck": "node ../../scripts/typecheck.ts && tsrx-tsc --noEmit -p tsconfig.example.json",
		"test": "vitest run",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@dnd-kit/abstract": "0.5.1",
		"@dnd-kit/collision": "0.5.1",
		"@dnd-kit/geometry": "0.5.1",
		"@dnd-kit/state": "0.5.1",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"abort-controller": "3.0.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
