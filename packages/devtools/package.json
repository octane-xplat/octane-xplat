{
	"name": "@octane-xplat/devtools",
	"version": "0.20.0",
	"description": "Devtools channel clients for Octane Xplat — app channels, per-target Node backends, and devtools panel connections over the xplat dev hub",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/devtools"
	},
	"files": [
		"src",
		"dist"
	],
	"type": "module",
	"exports": {
		"./app": {
			"types": "./dist/app.d.ts",
			"web": "./src/app.ts",
			"native": "./src/app.ts",
			"default": "./src/app.ts"
		},
		"./backend": {
			"types": "./dist/backend.d.ts",
			"default": "./dist/backend.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"web": "./src/client.ts",
			"default": "./dist/client.js"
		},
		"./macos": {
			"types": "./src/macos/index.macos.ts",
			"default": "./src/macos/index.macos.ts"
		},
		"./desktop": {
			"types": "./src/desktop/index.macos.ts",
			"default": "./src/desktop/index.macos.ts"
		},
		"./desktop-node": {
			"types": "./dist/host/desktop.d.ts",
			"default": "./dist/host/desktop.js"
		},
		"./panel": {
			"types": "./src/panel/index.ts",
			"default": "./src/panel/index.ts"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./host/records": {
			"types": "./dist/host/records.d.ts",
			"default": "./dist/host/records.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --runExternalCode -p tsconfig.build.json && vite build --config vite.panel.config.mjs",
		"typegen": "tsc --runExternalCode -p tsconfig.build.json",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/ui": "workspace:*"
	},
	"peerDependencies": {
		"octane": ">=0.6.3 <1"
	},
	"devDependencies": {
		"@nativescript/macos-node-api": "catalog:",
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"@types/node": "26.6.6",
		"octane": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/devtools"
}
