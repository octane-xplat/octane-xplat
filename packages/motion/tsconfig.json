{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@octane-xplat/ui": [
				"../ui/types/generated/index.d.ts"
			]
		},
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsrx",
		"examples/**/*.tsrx"
	],
	"exclude": [
		"src/**/*.test.*"
	]
}
