{
	"name": "@octane-xplat/motion",
	"version": "0.19.0",
	"description": "Declarative motion and retained presence for Octane on web, iOS and Android",
	"keywords": [
		"android",
		"animation",
		"cross-platform",
		"ios",
		"motion",
		"nativescript",
		"octane",
		"presence",
		"spring",
		"transitions",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/motion",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/motion"
	},
	"files": [
		"types/generated",
		"src",
		"LICENSE.motion",
		"UPSTREAM.md",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target motion",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:macos-runtime": "node tests/macos-runtime.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"test:intl": "node --test tests/intl.mjs",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.types.json"
	},
	"dependencies": {
		"@formatjs/intl-getcanonicallocales": "3.2.12",
		"@formatjs/intl-locale": "5.3.12",
		"@formatjs/intl-segmenter": "12.2.15",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"motion-dom": "14.7.1"
	},
	"devDependencies": {
		"@nativescript-community/gesturehandler": "2.0.45",
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"jsdom": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/typescript-plugin": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/gesturehandler": "2.0.45",
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/macos-renderer": "workspace:*",
		"octane": ">=0.1.51 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"@nativescript-community/gesturehandler": {
			"optional": true
		},
		"@octane-xplat/macos-renderer": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
