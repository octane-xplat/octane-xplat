{
	"extends": ["//"],
	"tasks": {
		"test:browser": {
			"cache": false
		},
		"test:apple-engine": {
			"cache": false
		},
		"test:android-engine": {
			"cache": false,
			"passThroughEnv": ["ANDROID_HOME", "JAVA_HOME"]
		},
		"test:ios-engine": {
			"cache": false,
			"passThroughEnv": ["GODDARD_*"]
		},
		"test:ios-runtime": {
			"dependsOn": ["^typegen"],
			"cache": false,
			"passThroughEnv": [
				"XPLAT_NATIVE_TEST_REPO",
				"XPLAT_IOS_DEVICE",
				"XPLAT_MC_BIG",
				"GODDARD_*"
			]
		},
		"test:macos-consumer": {
			"cache": false,
			"passThroughEnv": ["XPLAT_MACOS_SDK", "XPLAT_MACOS_SWIFTC"]
		}
	}
}
