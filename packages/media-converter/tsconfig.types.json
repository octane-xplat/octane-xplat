{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": false,
		"isolatedDeclarations": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"rootDir": "src",
		"outDir": "types/generated",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["@nativescript/types"]
	},
	"include": ["src/**/*.ts"]
}
