{
	"name": "@octane-xplat/native-prerender",
	"version": "0.20.0",
	"private": true,
	"description": "Native startup artifact contracts, production and adoption",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./codec": {
			"types": "./dist/codec.d.ts",
			"default": "./dist/codec.js"
		},
		"./ios/mason-binding": {
			"types": "./platforms/ios/mason-binding.ios.d.ts",
			"default": "./platforms/ios/mason-binding.ios.js"
		}
	},
	"scripts": {
		"build": "tsc --runExternalCode -p tsconfig.build.json --declaration false",
		"typegen": "tsc --runExternalCode -p tsconfig.build.json --emitDeclarationOnly",
		"typecheck": "tsc --runExternalCode -p tsconfig.json && node --check platforms/mason-binding-core.js && node --check platforms/android/mason-binding.android.js && node --check platforms/ios/mason-binding.ios.js",
		"test": "node --test tests/*.test.mjs",
		"test:codec:native": "node tests/native-codec.mjs"
	},
	"devDependencies": {
		"@tsrx/content-mapper": "catalog:",
		"@types/node": "26.6.6",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": "9.1.3",
		"@octane-xplat/nativescript-mason-core": "1.0.0-beta.10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		},
		"@octane-xplat/nativescript-mason-core": {
			"optional": true
		}
	},
	"files": [
		"dist",
		"platforms",
		"README.md"
	]
}
