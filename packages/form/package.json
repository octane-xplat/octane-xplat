{
	"name": "@octane-xplat/form",
	"version": "0.20.0",
	"description": "Typed form state and validation for Octane Xplat, powered by TanStack Form",
	"keywords": [
		"octane",
		"forms",
		"tanstack",
		"validation",
		"cross-platform"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/form",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/form"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*",
		"NOTICE"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:native": "vitest run --config vitest.native.config.mts",
		"typegen": "tsrx-typegen --target form",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test:packed": "node tests/packed-consumer.mts"
	},
	"dependencies": {
		"@tanstack/form-core": "1.33.5",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"@octane-xplat/cli": "workspace:*",
		"jsdom": "catalog:"
	},
	"peerDependencies": {
		"octane": ">=0.16.3 <1"
	},
	"types": "./types/generated/index.d.ts"
}
