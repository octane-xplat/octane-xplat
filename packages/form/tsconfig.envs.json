{
	"contentMappers": [
		{
			"package": "@tsrx/content-mapper",
			"extensions": [
				".tsrx"
			]
		}
	],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			],
			"files": [
				"tests/types.tsrx",
				"tests/fixtures/lifecycle.tsrx"
			]
		},
		"native": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		},
		"macos": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		},
		"linux": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		},
		"windows": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"examples/**/*.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		}
	}
}
