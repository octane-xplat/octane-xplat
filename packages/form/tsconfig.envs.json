{
	"contentMappers": [
		{
			"package": "@tsrx/content-mapper",
			"extensions": [
				".tsrx"
			]
		}
	],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@octane-xplat/jsx",
		"paths": {
			"@octane-xplat/form": ["../../../src/index.ts"],
			"@octane-xplat/ui": ["../../../node_modules/@octane-xplat/ui/types/generated/index.d.ts"],
			"octane": ["../../../node_modules/octane/dist/index.d.ts"],
			"octane/jsx-runtime": ["../../../node_modules/octane/dist/jsx-runtime.d.ts"],
			"octane/tsrx-boundary": ["../../../node_modules/octane/dist/tsrx-boundary.d.ts"]
		}
	},
	"environments": {
		"web": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/forms/trip-form.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			],
			"files": [
				"tests/types.tsrx",
				"tests/fixtures/lifecycle.tsrx"
			]
		},
		"native": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/forms/trip-form.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		},
		"macos": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/forms/trip-form.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		},
		"gtk": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/forms/trip-form.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		},
		"windows": {
			"include": [
				"src/**/*.ts",
				"src/**/*.tsrx",
				"../../examples/forms/trip-form.tsrx"
			],
			"exclude": [
				"src/**/*.test.*"
			]
		}
	}
}
