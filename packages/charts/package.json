{
	"name": "@octane-xplat/charts",
	"version": "0.13.0",
	"description": "Cross-platform SVG charts for Octane xplat — a DOM-free d3 core with web, iOS/Android, and macOS AppKit leaves",
	"keywords": [
		"android",
		"charts",
		"cross-platform",
		"d3",
		"graph",
		"ios",
		"macos",
		"nativescript",
		"octane",
		"svg",
		"visualization",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/charts",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/charts"
	},
	"files": [
		"dist",
		"types",
		"src"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/index.d.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/index.d.ts",
					"default": "./dist/macos/index.js"
				},
				"types": "./types/index.d.ts",
				"web": "./dist/web/index.js",
				"native": "./dist/native/index.js",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && vite build --mode macos && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"typegen": "tsc -p tsconfig.types.json",
		"typecheck": "tsrx-tsc --noEmit -p tsconfig.check.json && tsrx-tsc --noEmit -p tsconfig.check.web.json && tsrx-tsc --noEmit -p tsconfig.check.macos.json",
		"test": "vitest run",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"d3-array": "3.2.4",
		"d3-format": "3.1.2",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"d3-time-format": "4.1.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"@types/d3-array": "3.2.2",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/d3-time-format": "4.0.3",
		"octane": "0.11.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	}
}
