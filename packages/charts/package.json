{
	"name": "@octane-xplat/charts",
	"version": "0.18.0",
	"description": "Cross-platform SVG charts for Octane xplat \u2014 a DOM-free d3 core with web, iOS/Android, and macOS AppKit leaves",
	"keywords": [
		"android",
		"charts",
		"cross-platform",
		"d3",
		"graph",
		"ios",
		"macos",
		"nativescript",
		"octane",
		"svg",
		"visualization",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/charts",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/charts"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/generated/index.d.ts",
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target charts",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"d3-array": "3.2.4",
		"d3-format": "3.1.2",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"d3-time-format": "4.1.0"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"@types/d3-array": "3.2.2",
		"@types/d3-format": "3.0.4",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/d3-time-format": "4.0.3",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
