{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"allowImportingTsExtensions": true,
		"types": ["@nativescript/types"]
	},
	"include": ["src/*.ts", "src/*.tsrx", "type-support/*.d.ts"],
	"exclude": ["**/*.test.*"]
}
