{
	"name": "@octane-xplat/calendar",
	"version": "0.20.0",
	"description": "Device calendar for Octane xplat \u2014 event store reads and writes via EventKit/CalendarContract",
	"keywords": [
		"android",
		"cross-platform",
		"nativescript",
		"octane",
		"xplat",
		"calendar",
		"events"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/calendar",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/calendar"
	},
	"files": [
		"src",
		"platforms",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target octane",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "node --test tests/*.test.ts"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"dependencies": {
		"@octane-xplat/platform": "workspace:*"
	}
}
