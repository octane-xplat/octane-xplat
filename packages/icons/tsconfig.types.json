{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@octane-xplat/jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"allowImportingTsExtensions": true
	},
	"files": ["src/index.ts", "src/index.web.ts", "src/index.macos.ts"]
}
