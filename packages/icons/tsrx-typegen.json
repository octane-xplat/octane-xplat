{
	"targets": {
		"icons": {
			"renderer": "@octane-xplat/jsx",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": [
						"./src/index.macos.ts",
						"./src/index.web.ts",
						"./src/index.ts"
					],
					"types": [
						"./types/generated/index.d.ts"
					]
				},
				"./vite": {
					"source": "src/vite/index.ts",
					"runtime": [
						"./dist/vite/index.js"
					],
					"types": [
						"./types/generated/vite/index.d.ts"
					]
				}
			}
		}
	}
}
