{
	"name": "@octane-xplat/icons",
	"version": "0.17.0",
	"description": "Bundled, set-agnostic Iconify icons for Octane web and NativeScript",
	"keywords": [
		"cross-platform",
		"iconify",
		"icons",
		"nativescript",
		"octane"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/icons",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/icons"
	},
	"files": [
		"src",
		"types/generated",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target icons",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "node --test tests/*.test.mjs",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@iconify/types": "2.0.0",
		"@iconify/utils": "3.1.7",
		"@octane-xplat/ui": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
