{
	"name": "@octane-xplat/icons",
	"version": "0.19.0",
	"description": "Bundled, set-agnostic Iconify icons for Octane web and NativeScript",
	"keywords": [
		"cross-platform",
		"iconify",
		"icons",
		"nativescript",
		"octane"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/icons",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/icons"
	},
	"files": [
		"src",
		"dist/vite",
		"icons.d.ts",
		"types/generated",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./vite": {
			"types": "./types/generated/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"typegen": "tsrx-typegen --target icons",
		"typecheck": "node ../../scripts/typecheck.ts && bun run tsc --noEmit -p tsconfig.build.json",
		"test": "bun run build && node --test tests/*.test.mjs",
		"prepack": "bun run build && bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@iconify/types": "2.0.0",
		"@iconify/utils": "3.1.7",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/ui": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1",
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
