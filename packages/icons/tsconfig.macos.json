{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@nativescript-community/octane",
		"moduleSuffixes": [".macos", ""],
		"customConditions": ["macos"],
		"lib": ["ESNext"],
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated/macos",
		"paths": {
			"@xplat/macos/renderer/jsx-runtime": ["../../apps/macos/src/renderer/jsx-runtime.d.ts"]
		}
	},
	"files": ["src/index.macos.ts"]
}
