{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/print": ["../../../src/index.ts"] },
		"resolveJsonModule": true,
		"types": ["@nativescript/types"]
	},
	"environments": {
		"web": {
			"include": ["src/**/*.ts", "../../examples/printing/upload-pdf.ts"],
			"exclude": ["src/**/*.ios.ts", "src/**/*.android.ts", "src/**/*.macos.ts"]
		},
		"native": {
			"include": ["src/**/*.ts", "tests/runtime.ios.ts"],
			"exclude": ["src/**/*.web.ts", "src/**/*.macos.ts"]
		},
		"macos": {
			"include": ["src/index.macos.ts", "src/**/*.macos.ts"]
		},
		"gtk": {
			"include": ["src/index.linux.ts"]
		},
		"windows": {
			"include": ["src/index.windows.ts"]
		}
	}
}
