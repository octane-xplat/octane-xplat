{
	"name": "@octane-xplat/nano-icons",
	"version": "0.14.0",
	"description": "Build-time icon fonts and layered glyph rendering for Octane Xplat \u2014 SVG directories or Iconify collections compile to a TTF + typed glyph map (pipeline adapted from react-native-nano-icons)",
	"keywords": [
		"cross-platform",
		"icons",
		"nativescript",
		"octane",
		"svg"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/nano-icons",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/nano-icons"
	},
	"files": [
		"dist",
		"types/generated",
		"bin",
		"LICENSES.md"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./build": {
			"types": "./types/generated/build/index.d.ts",
			"default": "./src/build/index.ts"
		},
		"./build/cli": {
			"types": "./types/generated/build/cli.d.ts",
			"default": "./src/build/cli.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/generated/index.macos.d.ts",
					"default": "./dist/macos/index.js"
				},
				"web": {
					"types": "./types/generated/index.web.d.ts",
					"default": "./dist/web/index.js"
				},
				"native": {
					"types": "./types/generated/index.d.ts",
					"default": "./dist/native/index.js"
				},
				"types": "./types/generated/index.d.ts",
				"default": "./dist/native/index.js"
			},
			"./build": {
				"types": "./types/generated/build/index.d.ts",
				"default": "./dist/build/index.js"
			},
			"./build/cli": {
				"types": "./types/generated/build/cli.d.ts",
				"default": "./dist/build/cli.js"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && vite build --mode macos && vite build --mode node && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"typegen": "tsrx-typegen --target nano-icons",
		"typecheck": "node ../../scripts/typecheck.mjs && pnpm exec tsc --noEmit -p tsconfig.build.json",
		"test": "pnpm build && node --test tests/*.test.mjs",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@iconify/types": "2.0.0",
		"@iconify/utils": "3.1.7",
		"@octane-xplat/ui": "workspace:*",
		"@xmldom/xmldom": "0.9.12",
		"cubic2quad": "1.2.1",
		"fonteditor-core": "2.6.3",
		"pathkit-wasm": "1.0.0",
		"svg2ttf": "6.0.3"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"@types/node": "20.19.0",
		"@types/svg2ttf": "5.0.3",
		"octane": "0.11.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1",
		"@octane-xplat/macos-renderer": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		},
		"@octane-xplat/macos-renderer": {
			"optional": true
		}
	},
	"bin": {
		"nano-icons": "./bin/nano-icons.mjs"
	}
}
