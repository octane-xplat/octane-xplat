{
	"name": "@octane-xplat/nano-icons",
	"version": "0.14.0",
	"description": "Shared icon preparation with per-instance materialization over Octane's existing SVG renderers — strategy adapted from react-native-nano-icons",
	"keywords": [
		"cross-platform",
		"icons",
		"nativescript",
		"octane",
		"svg"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/nano-icons",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/nano-icons"
	},
	"files": [
		"dist",
		"types/generated"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"macos": {
					"types": "./types/generated/index.macos.d.ts",
					"default": "./dist/macos/index.js"
				},
				"web": {
					"types": "./types/generated/index.web.d.ts",
					"default": "./dist/web/index.js"
				},
				"native": {
					"types": "./types/generated/index.d.ts",
					"default": "./dist/native/index.js"
				},
				"types": "./types/generated/index.d.ts",
				"default": "./dist/native/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "vite build && vite build --mode native && vite build --mode macos && pnpm typegen && node ../../scripts/check-native-dist.mjs",
		"typegen": "tsrx-typegen --target nano-icons",
		"typecheck": "node ../../scripts/typecheck.mjs",
		"test": "pnpm --filter @octane-xplat/icons build && pnpm build && node --test tests/*.test.mjs",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@iconify/types": "2.0.0",
		"@iconify/utils": "3.1.7",
		"@octane-xplat/icons": "workspace:*",
		"@octane-xplat/ui": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.3",
		"@octane-xplat/macos-renderer": "workspace:*",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"octane": "0.11.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	}
}
