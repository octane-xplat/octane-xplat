{
	"name": "@octane-xplat/nano-icons",
	"version": "0.20.0",
	"description": "Build-time icon fonts and layered glyph rendering for Octane Xplat \u2014 SVG directories or Iconify collections compile to a TTF + typed glyph map (pipeline adapted from react-native-nano-icons)",
	"keywords": [
		"cross-platform",
		"icons",
		"nativescript",
		"octane",
		"svg"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/nano-icons",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/nano-icons"
	},
	"bin": {
		"nano-icons": "./bin/nano-icons.mjs"
	},
	"files": [
		"src",
		"dist/build",
		"types/generated",
		"bin",
		"LICENSES.md",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./build": {
			"types": "./types/generated/build/index.d.ts",
			"default": "./dist/build/index.js"
		},
		"./build/cli": {
			"types": "./types/generated/build/cli.d.ts",
			"default": "./dist/build/cli.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target nano-icons",
		"typecheck": "node ../../scripts/typecheck.ts && bun run tsc --runExternalCode --noEmit -p tsconfig.build.json",
		"test": "bun run build && node --test tests/*.test.mts",
		"prepack": "bun run build && bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"build": "vite build"
	},
	"dependencies": {
		"@iconify/types": "2.0.0",
		"@iconify/utils": "3.1.7",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@xmldom/xmldom": "0.9.12",
		"cubic2quad": "1.2.1",
		"fonteditor-core": "2.6.3",
		"pathkit-wasm": "1.0.0",
		"svg2ttf": "6.1.0"
	},
	"devDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"@types/node": "26.6.6",
		"@types/svg2ttf": "5.0.3",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@octane-xplat/nativescript-octane": "workspace:*",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/macos-appkit": "workspace:*",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@octane-xplat/nativescript-octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		},
		"@octane-xplat/macos-appkit": {
			"optional": true
		}
	}
}
