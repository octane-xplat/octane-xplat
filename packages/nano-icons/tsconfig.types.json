{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "octane",
		"customConditions": [
			"web"
		],
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"types": [
			"node"
		]
	},
	"files": [
		"src/index.ts",
		"src/index.web.ts",
		"src/index.macos.ts",
		"src/build/index.ts",
		"src/build/cli.ts",
		"src/build/externals.d.ts"
	]
}
