{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsxImportSource": "@octane-xplat/jsx",
		"isolatedDeclarations": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "types/generated",
		"types": ["node"],
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"allowImportingTsExtensions": true
	},
	"files": [
		"src/index.ts",
		"src/index.web.ts",
		"src/index.macos.ts",
		"src/build/index.ts",
		"src/build/cli.ts",
		"src/build/externals.d.ts"
	]
}
