{
	"targets": {
		"nano-icons": {
			"renderer": "@octane-xplat/jsx",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.ts",
					"runtime": ["./src/index.macos.ts", "./src/index.web.ts", "./src/index.ts"],
					"types": [
						"./types/generated/index.d.ts",
						"./types/generated/index.web.d.ts",
						"./types/generated/index.macos.d.ts"
					]
				},
				"./build": {
					"source": "src/build/index.ts",
					"runtime": ["./dist/build/index.js"],
					"types": ["./types/generated/build/index.d.ts"]
				},
				"./build/cli": {
					"source": "src/build/cli.ts",
					"runtime": ["./dist/build/cli.js"],
					"types": ["./types/generated/build/cli.d.ts"]
				}
			}
		}
	}
}
