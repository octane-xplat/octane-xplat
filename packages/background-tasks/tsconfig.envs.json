{
	"contentMappers": [{ "package": "@tsrx/content-mapper", "extensions": [".tsrx"] }],
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": { "@octane-xplat/background-tasks": ["../src/index.ts"], "@octane-xplat/platform": ["../../platform/types/generated/index.d.ts"] },
		"target": "esnext",
		"jsx": "react-jsx"
	},
	"environments": {
		"native": {
			"files": ["src/index.ts", "../../examples/background-work/refresh.ts"],
			"compilerOptions": { "types": ["@nativescript/types"] }
		},
		"web": { "files": ["src/index.web.ts", "../../examples/background-work/refresh.ts"] },
		"macos": { "files": ["src/index.macos.ts", "../../examples/background-work/refresh.ts"] }
	}
}
