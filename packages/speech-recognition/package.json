{
	"name": "@octane-xplat/speech-recognition",
	"version": "0.20.0",
	"description": "Speech-to-text dictation sessions for Octane xplat",
	"keywords": [
		"android",
		"cross-platform",
		"dictation",
		"ios",
		"nativescript",
		"octane",
		"speech-recognition",
		"speech-to-text",
		"stt",
		"transcription",
		"voice",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/speech-recognition",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/speech-recognition"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"web": "./src/index.web.ts",
			"macos": "./src/index.macos.ts",
			"gtk": "./src/index.gtk.ts",
			"linux": "./src/index.linux.ts",
			"windows": "./src/index.windows.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target speech-recognition",
		"typecheck": "node ../../scripts/typecheck.ts",
		"test": "vitest run",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"test:web-runtime": "node tests/web-chrome-runtime.mts",
		"test:macos-host": "node tests/verify-macos-host.mts",
		"test:macos-app": "node tests/macos-app-runtime.mts",
		"test:ios-simulator": "node tests/ios-simulator-proof.mts",
		"test:android-emulator": "node tests/android-emulator-proof.mts"
	},
	"dependencies": {
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript/types": "catalog:",
		"@tsrx/content-mapper": "catalog:",
		"playwright": "1.63.0",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"AVFoundation",
				"Speech"
			]
		}
	}
}
