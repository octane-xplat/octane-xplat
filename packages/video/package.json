{
	"name": "@octane-xplat/video",
	"version": "0.21.0",
	"description": "Embedded video player for Octane xplat \u2014 web <video> + @nstudio/nativescript-exoplayer (ExoPlayer / AVPlayerViewController) with self-drawn chrome",
	"keywords": [
		"android",
		"avplayer",
		"cross-platform",
		"exoplayer",
		"ios",
		"media",
		"nativescript",
		"octane",
		"video",
		"video-player",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/video",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/video"
	},
	"files": [
		"types/generated",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"web": "./src/index.web.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --target video",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mts",
		"test:macos-runtime": "node tests/packed-consumer.mts --macos-runtime",
		"pack:check": "tsrx-typegen --pack-check",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "node ../../scripts/typecheck.ts"
	},
	"dependencies": {
		"@nstudio/nativescript-exoplayer": "6.2.0",
		"@octane-xplat/jsx": "workspace:*",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octane-xplat/macos-appkit": "workspace:*",
		"@octane-xplat/ui": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@tsrx/content-mapper": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": ">=0.6.0 <1",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"types": "./types/generated/index.d.ts"
}
