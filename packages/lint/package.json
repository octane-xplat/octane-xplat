{
	"name": "@octane-xplat/lint",
	"version": "0.17.0",
	"description": "Oxlint and TSRX lint rules for octane-xplat apps",
	"keywords": [
		"lint",
		"lint-rules",
		"linter",
		"octane",
		"oxlint",
		"static-analysis",
		"tsrx",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/lint",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/lint"
	},
	"bin": {
		"xplat-lint": "./bin/lint.mjs"
	},
	"files": [
		"src",
		"dist",
		"bin",
		"config.json"
	],
	"type": "module",
	"exports": {
		"./bin": "./bin/lint.mjs",
		"./config": "./config.json",
		"./oxlint-plugin": "./dist/oxlint-plugin.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"prepack": "pnpm build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@tsrx/core": "^0.2.4",
		"ignore": "7.0.12",
		"oxlint": "1.74.0",
		"picomatch": "4.0.7"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"vite": "catalog:"
	}
}
