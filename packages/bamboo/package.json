{
	"name": "@octane-xplat/bamboo",
	"version": "0.14.0",
	"description": "Bamboo CSS integration defaults for Octane xplat apps",
	"keywords": [
		"bamboo",
		"css",
		"nativescript",
		"octane",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/bamboo",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/bamboo"
	},
	"files": [
		"src",
		"types"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/config.d.ts",
			"default": "./src/config.ts"
		},
		"./config": {
			"types": "./types/generated/config.d.ts",
			"default": "./src/config.ts"
		},
		"./vite": {
			"types": "./types/generated/vite.d.ts",
			"default": "./src/vite.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build",
		"test:packed": "node tests/packed-consumer.mjs"
	},
	"dependencies": {
		"@bamboocss/preset-base": "1.56.2",
		"@bamboocss/types": "1.56.2",
		"@bamboocss/vite": "1.56.2"
	},
	"peerDependencies": {
		"vite": ">=5"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	}
}
