{
	"compilerOptions": {
		"strict": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"skipLibCheck": true,
		"outDir": "types/generated"
	},
	"include": ["src/config.ts", "src/vite.ts"]
}
