{
	"compilerOptions": {
		"strict": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"skipLibCheck": true,
		"outDir": "types/generated",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/config.ts",
		"src/vite.ts"
	]
}
