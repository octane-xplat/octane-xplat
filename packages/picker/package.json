{
	"name": "@octane-xplat/picker",
	"version": "0.18.0",
	"description": "Platform selection controls for web, SwiftUI, Material and native AppKit",
	"keywords": [
		"android",
		"combobox",
		"cross-platform",
		"dropdown",
		"ios",
		"nativescript",
		"octane",
		"picker",
		"select",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/picker",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/picker"
	},
	"files": [
		"types",
		"src",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"web": "./src/index.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./ios": {
			"types": "./types/ios/index.d.ts",
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"types": "./types/android/index.d.ts",
			"native": "./src/android/index.ts"
		},
		"./web": {
			"types": "./types/web/index.d.ts",
			"web": "./src/web/index.ts"
		},
		"./macos": {
			"types": "./types/macos/index.d.ts",
			"macos": "./src/macos/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/picker-owner.macos.test.mjs",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check",
		"typegen": "tsc -p tsconfig.types.json"
	},
	"dependencies": {
		"@nativescript/jetpack-compose": "1.0.0-beta.0",
		"@nativescript/swift-ui": "4.0.2",
		"@octane-xplat/jsx": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@octanejs/vite-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@octane-xplat/macos-renderer": "workspace:*"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1",
		"@octane-xplat/macos-renderer": ">=0.8.0 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		},
		"@octane-xplat/macos-renderer": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
