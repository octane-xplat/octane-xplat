{
	"name": "@octane-xplat/picker",
	"version": "0.7.3",
	"description": "Select control for Octane xplat — web select + SwiftUI picker (iOS) / Material dropdown (Android)",
	"keywords": [
		"octane",
		"xplat",
		"cross-platform",
		"picker",
		"select",
		"dropdown",
		"combobox",
		"nativescript",
		"ios",
		"android",
		"web"
	],
	"license": "MIT",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/picker",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octane-xplat/octane-xplat.git",
		"directory": "packages/picker"
	},
	"files": [
		"dist",
		"types",
		"src",
		"platforms"
	],
	"type": "module",
	"exports": {
		"./ios": {
			"types": "./types/ios/index.d.ts",
			"native": "./src/ios/index.ts"
		},
		"./android": {
			"types": "./types/android/index.d.ts",
			"native": "./src/android/index.ts"
		},
		"./web": {
			"types": "./types/web/index.d.ts",
			"web": "./src/web/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./ios": {
				"types": "./types/ios/index.d.ts",
				"native": "./dist/native/ios/index.js"
			},
			"./android": {
				"types": "./types/android/index.d.ts",
				"native": "./dist/native/android/index.js"
			},
			"./web": {
				"types": "./types/web/index.d.ts",
				"web": "./dist/web/web/index.js"
			}
		}
	},
	"scripts": {
		"build": "vite build && vite build --mode native && tsc -p tsconfig.types.json && node ../../scripts/check-native-dist.mjs",
		"prepublishOnly": "pnpm build",
		"prepack": "pnpm build && tsrx-typegen --pack-check",
		"test:packed": "node tests/packed-consumer.mjs",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/jetpack-compose": "1.0.0-beta.0",
		"@nativescript/swift-ui": "4.0.2"
	},
	"devDependencies": {
		"@nativescript-community/octane": "0.2.4",
		"@nativescript/core": "9.1.2",
		"@octanejs/vite-plugin": "0.1.61",
		"octane": "0.6.3",
		"tsrx-typegen": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		},
		"octane": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
