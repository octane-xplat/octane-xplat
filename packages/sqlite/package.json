{
	"name": "@octane-xplat/sqlite",
	"version": "0.17.0",
	"description": "Cross-target SQLite persistence — sqlite-wasm worker on web, @nativescript-community/sqlite on iOS/Android",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/sqlite"
	},
	"files": [
		"src",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/generated/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"web": {
				"types": "./types/generated/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/generated/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"test:android-runtime": "node tests/android-runtime.mjs",
		"test:packed": "node tests/packed-consumer.mjs",
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript-community/sqlite": "3.5.9",
		"@sqlite.org/sqlite-wasm": "3.53.4-build1"
	},
	"devDependencies": {
		"@nativescript/types": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript/core": ">=9.1.0 <10"
	},
	"peerDependenciesMeta": {
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	}
}
