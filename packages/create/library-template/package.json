{
	"name": "octane-xplat-library",
	"version": "0.1.0",
	"description": "A cross-platform component library for Octane Xplat",
	"keywords": [
		"android",
		"cross-platform",
		"ios",
		"octane",
		"octane-xplat",
		"ui",
		"web"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/your-org/your-library",
		"directory": "."
	},
	"files": [
		"src",
		"types",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": null,
			"linux": null,
			"windows": null,
			"web": {
				"types": "./types/index.web.d.ts",
				"default": "./src/index.web.ts"
			},
			"native": {
				"types": "./types/index.d.ts",
				"default": "./src/index.ts"
			},
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"typecheck": "xplat typecheck",
		"lint": "xplat-lint",
		"lint:fix": "xplat-lint --fix",
		"test": "vitest run",
		"test:packed": "node tests/packed-consumer.mjs",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "pnpm test:packed"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@octane-xplat/cli": "^0.14.0",
		"@octane-xplat/lint": "^0.14.0",
		"@octane-xplat/ui": "^0.14.0",
		"@octanejs/vite-plugin": "catalog:",
		"@tsrx/oxc": "0.20.0",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"oxlint": "^1.74.0",
		"tsrx-typegen": "^0.2.2",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"@octane-xplat/ui": "^0.14.0",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.24.0"
}
