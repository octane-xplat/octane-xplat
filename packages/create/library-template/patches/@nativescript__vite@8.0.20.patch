+import { rewriteFsAbsoluteToNsM } from './websocket-module-specifiers.js';
+
+// Use the same app/workspace/@fs spelling as static device imports. App
+// virtual IDs remain intact; an unrelated /src/ substring is never a root.
+export function normalizeHmrModuleId(raw, projectRoot) {
+    if (!raw) return raw;
+    let id = raw.split(/[?#]/)[0].replace(/\\/g, '/');
+    if (id.startsWith('/ns/m/')) return id.slice('/ns/m'.length);
+    const fileUrl = id.startsWith('file://');
+    if (fileUrl) id = id.slice('file://'.length);
+    const fsUrl = id.startsWith('/@fs/');
+    if (fsUrl) id = id.slice('/@fs'.length);
+    const root = projectRoot?.replace(/\\/g, '/').replace(/\/$/, '');
+    const within = (base) => base && (id === base || id.startsWith(base + '/'));
+    // Preserve ordinary app IDs, including Windows drive paths, without
+    // passing a drive-letter source through POSIX /@fs parsing.
+    if (within(root)) return id.slice(root.length) || '/';
+    const workspace = root ? getMonorepoWorkspaceRoot(root) : null;
+    if (root && id.startsWith('/../')) id = path.resolve(root, '.' + id).replace(/\\/g, '/');
+    if (root && (fileUrl || fsUrl || within(root) || within(workspace) || (path.isAbsolute(id) && existsSync(id)))) {
+        const url = rewriteFsAbsoluteToNsM('/@fs' + id, root, workspace);
+        // The module route serves explicit /@fs paths for linked sources
+        // outside both roots, matching rewriteImports' existing fallback.
+        return url ? url.slice('/ns/m'.length) : '/@fs' + id;
+    }
+    return id.startsWith('/') ? id : '/' + id;
+}
