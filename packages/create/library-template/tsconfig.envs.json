{
	"contentMappers": [{ "package": "@octane-xplat/cli", "extensions": [".tsrx"] }],
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"jsxImportSource": "@octane-xplat/jsx"
	},
	"environments": {
		"web": {
			"include": ["src/**/*.{ts,tsx,tsrx}"]
		},
		"native": {
			"include": ["src/**/*.{ts,tsx,tsrx}"],
			"compilerOptions": {
				"types": ["@nativescript/types"]
			}
		}
	}
}
