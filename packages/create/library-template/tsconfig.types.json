{
	"contentMappers": [
		{
			"package": "@octane-xplat/cli",
			"extensions": [
				".tsrx"
			]
		}
	],
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"noEmitOnError": true,
		"rootDir": "src",
		"outDir": "types",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"@nativescript/types"
		]
	},
	"exclude": [
		"src/**/*.stories.*",
		"dist",
		"types",
		"node_modules"
	],
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.tsrx"
	]
}
