{
	"contentMappers": [
		{
			"package": "@octane-xplat/cli",
			"extensions": [
				".tsrx"
			]
		}
	],
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "@octane-xplat/jsx",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"lib": [
			"ESNext"
		],
		"types": [],
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [],
	"exclude": [
		"dist",
		"types",
		"node_modules"
	],
	"files": [],
	"references": [
		{
			"path": "./node_modules/.cache/xplat-typecheck/web.json"
		},
		{
			"path": "./node_modules/.cache/xplat-typecheck/ios.json"
		},
		{
			"path": "./node_modules/.cache/xplat-typecheck/android.json"
		}
	]
}
