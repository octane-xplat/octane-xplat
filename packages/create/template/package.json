		"jsdom": "catalog:xplat",
		"nativescript": "catalog:xplat",
		"typescript": "catalog:xplat",
		"vite": "catalog:xplat",
		"vitest": "catalog:xplat"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=22.18.0"
