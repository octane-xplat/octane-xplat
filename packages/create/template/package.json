{
	"name": "octane-xplat-app",
	"private": true,
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"xplat": "xplat",
		"dev": "vite",
		"dev:ios": "ns run ios",
		"dev:android": "ns run android",
		"build": "vite build",
		"build:ios": "ns build ios",
		"build:android": "ns build android",
		"test": "vitest run --config vitest.web.config.mts",
		"test:web": "vitest run --config vitest.web.config.mts",
		"test:ios": "ns test ios",
		"test:android": "ns test android",
		"lint": "xplat lint",
