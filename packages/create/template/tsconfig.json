{
	"contentMappers": [
		{
			"package": "octane-xplat",
			"extensions": [
				".tsrx"
			]
		}
	],
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "@octane-xplat/jsx",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"lib": [
			"ESNext"
		],
		"types": [],
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@nativescript/core": [
				"./node_modules/@nativescript/core"
			],
			"@nativescript/core/*": [
				"./node_modules/@nativescript/core/*"
			]
		}
	},
	"include": [],
	"exclude": [
		"node_modules"
	],
	"files": [],
	"references": [
		{
			"path": "./node_modules/.cache/xplat-typecheck/web.json"
		},
		{
			"path": "./node_modules/.cache/xplat-typecheck/ios.json"
		},
		{
			"path": "./node_modules/.cache/xplat-typecheck/android.json"
		}
	]
}
