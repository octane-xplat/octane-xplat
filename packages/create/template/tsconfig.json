{
	"contentMappers": [
		{
			"package": "octane-xplat",
			"extensions": [
				".tsrx"
			]
		}
	],
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "@octane-xplat/jsx",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"vite/client",
			"@nativescript/types"
		],
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@nativescript/core": [
				"./node_modules/@nativescript/core"
			],
			"@nativescript/core/*": [
				"./node_modules/@nativescript/core/*"
			]
		}
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules"
	],
	"files": [
		"references.d.ts"
	]
}
