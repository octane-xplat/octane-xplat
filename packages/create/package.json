{
	"name": "create-octane-xplat",
	"version": "0.20.0",
	"description": "Scaffold Octane Xplat apps and cross-platform libraries",
	"keywords": [
		"component-library",
		"create",
		"cross-platform",
		"init",
		"octane",
		"project-generator",
		"scaffolding",
		"starter-template",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/create",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/create"
	},
	"bin": {
		"create-octane-xplat": "./dist/index.js"
	},
	"files": [
		"index.ts",
		"scaffold.ts",
		"compatibility.ts",
		"compatibility.json",
		"dist",
		"template",
		"library-template"
	],
	"type": "module",
	"exports": {
		"./scaffold": {
			"types": "./scaffold.ts",
			"bun": "./scaffold.ts",
			"default": "./dist/scaffold.js"
		},
		"./compatibility": {
			"types": "./compatibility.ts",
			"bun": "./compatibility.ts",
			"default": "./dist/compatibility.js"
		},
		"./compatibility.json": "./compatibility.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build",
		"prepack": "bun run build",
		"typecheck": "tsc -p tsconfig.json",
		"test:library": "node test/library-guide.mjs"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"vite": "catalog:"
	}
}
