{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": [
		"//"
	],
	"tasks": {
		"build": {
			"outputs": ["dist/**", "template/patches/**", "library-template/patches/**"]
		},
		"pack:check": {
			"dependsOn": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../scripts/check-packed-patches.mts",
				"../cli/patches/**",
				"compatibility.*",
				"scaffold.ts",
				"template/**",
				"library-template/**"
			]
		},
		"test:packed": {
			"dependsOn": ["pack:check"],
			"cache": false
		},
		"test:library": {
			"dependsOn": [
				"build",
				"@octane-xplat/cli#build",
				"@octane-xplat/ui#typegen",
				"@octane-xplat/jsx#typegen",
				"@octane-xplat/platform#typegen",
				"@octane-xplat/lib#typegen",
				"tsrx-typegen#build",
				"@octane-xplat/lint#build",
				"@octane-xplat/workshop#build",
				"@octane-xplat/workshop#typegen",
				"@octane-xplat/cli#build:go"
			],
			"cache": false
		}
	}
}
