{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "octane",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": "src",
		"moduleSuffixes": [
			"",
			".web",
			".ios",
			".android",
			".mobile",
			".native",
			".macos",
			".linux",
			".windows"
		],
		"allowImportingTsExtensions": true,
		"types": [
			"@nativescript/types"
		]
	},
	"include": [
		"src/types.ts",
		"src/firebase-crashlytics.ts",
		"src/firebase-crashlytics.web.ts",
		"src/firebase-crashlytics.macos.ts",
		"src/firebase-crashlytics.linux.ts",
		"src/firebase-crashlytics.windows.ts",
		"src/index.ts",
		"src/index.web.ts",
		"src/index.macos.ts"
	]
}
