{
	"targets": {
		"package": {
			"renderer": "octane",
			"project": "tsconfig.types.json",
			"outDir": "types/generated",
			"entrypoints": {
				".": {
					"source": "src/index.macos.ts",
					"runtime": ["./src/index.windows.ts", "./src/index.macos.ts", "./src/index.ts"],
					"types": ["./types/index.macos.d.ts", "./types/generated/index.d.ts"]
				},
				"./*": {
					"source": "src/index.ts",
					"runtime": ["./src/*"],
					"types": ["./types/generated/*.d.ts"]
				},
				"./*.ts": {
					"source": "src/index.ts",
					"runtime": ["./src/*.ts"],
					"types": ["./types/generated/*.d.ts"]
				}
			}
		}
	}
}
