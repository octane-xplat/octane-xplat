		"octane",
		"xplat",
		"cross-platform",
		"secure-storage",
		"keychain",
		"keystore",
		"nativescript",
		"ios",
		"android",
		"web"
	],
	"license": "MIT",
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/secure-storage",
	"repository": {
