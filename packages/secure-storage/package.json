{
	"name": "@octane-xplat/secure-storage",
	"version": "0.16.0",
	"description": "Keychain/Keystore-backed secure storage for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"cross-platform",
		"ios",
		"keychain",
		"keystore",
		"nativescript",
		"octane",
		"secure-storage",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/secure-storage",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/secure-storage"
	},
	"files": [
		"src",
		"types",
		"platforms",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"macos": {
				"types": "./types/index.macos.d.ts",
				"default": "./src/index.macos.ts"
			},
			"types": "./types/generated/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:packed": "node tests/macos.test.mjs && node tests/packed-consumer.mjs",
		"test:macos": "node tests/macos.test.mjs",
		"test:macos-runtime": "node tests/macos-runtime.mjs",
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"prepack": "pnpm typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/secure-storage": "4.0.2",
		"@octane-xplat/platform": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"Security"
			]
		}
	}
}
