{
	"name": "@octane-xplat/geolocation",
	"version": "0.18.0",
	"description": "Device geolocation for Octane xplat — matching web + NativeScript implementations",
	"keywords": [
		"android",
		"cross-platform",
		"geolocation",
		"gps",
		"ios",
		"location",
		"nativescript",
		"octane",
		"web",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/octane-xplat/tree/main/packages/geolocation",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/geolocation"
	},
	"files": [
		"src",
		"platforms",
		"types",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/generated/index.d.ts",
			"macos": "./src/index.macos.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*"
		},
		"./*.ts": {
			"types": "./types/generated/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test:packed": "node tests/packed-consumer.mjs",
		"test": "node --experimental-strip-types --test tests/geolocation.macos.test.ts",
		"test:macos": "node tests/verify-macos.mjs && node tests/verify-host.mjs",
		"typegen": "tsrx-typegen --project tsconfig.types.json",
		"prepack": "bun run typegen && tsrx-typegen --pack-check",
		"pack:check": "tsrx-typegen --pack-check"
	},
	"dependencies": {
		"@nativescript/geolocation": "9.0.0",
		"@octane-xplat/lib": "workspace:*"
	},
	"devDependencies": {
		"@nativescript-community/octane": "catalog:",
		"@nativescript/core": "catalog:",
		"@nativescript/types": "catalog:",
		"@tsrx/typescript-plugin": "catalog:",
		"octane": "catalog:",
		"tsrx-typegen": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@nativescript-community/octane": ">=0.2.1 <1",
		"@nativescript/core": ">=9.1.0 <10",
		"octane": ">=0.6.3 <1"
	},
	"peerDependenciesMeta": {
		"@nativescript-community/octane": {
			"optional": true
		},
		"@nativescript/core": {
			"optional": true
		}
	},
	"nativescript": {
		"platforms": {
			"android": "9.1.0",
			"ios": "9.1.0"
		}
	},
	"xplat": {
		"macos": {
			"frameworks": [
				"Foundation",
				"CoreLocation"
			]
		}
	}
}
