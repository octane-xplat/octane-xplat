{
	"name": "octane-xplat",
	"version": "0.20.0",
	"description": "The supported Octane Xplat development toolchain",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/octane-xplat",
		"directory": "packages/toolchain"
	},
	"bin": {
		"xplat": "./bin/xplat.exe"
	},
	"exports": {
		"./vite": {
			"types": "./vite.d.ts",
			"default": "./vite.js"
		}
	},
	"files": [
		"bin",
		"vite.js",
		"vite.d.ts",
		"install-native.mjs"
	],
	"scripts": {
		"typecheck": "tsc --runExternalCode -p tsconfig.json",
		"test:packed": "node test/packed.mjs",
		"postinstall": "node install-native.mjs",
		"prepack": "node install-native.mjs --prepare-package",
		"postpack": "node install-native.mjs"
	},
	"dependencies": {
		"@octane-xplat/cli": "workspace:*",
		"@octane-xplat/fmt": "0.3.0",
		"@octane-xplat/lint": "workspace:*",
		"@octanejs/vite-plugin": "0.5.0",
		"@tsrx/oxc": "0.20.0",
		"typescript": "7.1.0-beta",
		"vite": "8.3.6"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"bin/tsrx-mapper.mjs"
			],
			"dynamicConfig": true
		}
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22.22.2"
	}
}
