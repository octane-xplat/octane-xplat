{
  "name": "@xplat/linux-runtime-eval",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json",
    "typecheck:sdk": "tsc --runExternalCode --ignoreConfig --noEmit --strict --skipLibCheck --module esnext --moduleResolution bundler --jsx preserve --allowImportingTsExtensions port/installed-app.gtk.tsx",
    "test:runtime": "node run.mjs",
    "test:port": "LINUX_RUNTIME_EVAL_SLICE=port node run.mjs",
    "test:renderer-fixture": "node renderer-fixture.mjs",
    "test:renderer-suite": "node renderer-suite.mjs",
    "build:port": "node port/build.mjs",
    "build:installed-app": "node port/build-installed-app.mjs",
    "dev:port": "node port/build.mjs --watch",
    "test:metadata": "node --test test/prepare-webkit-metadata.test.mjs"
  },
  "devDependencies": {
    "@octane-xplat/build": "workspace:*",
    "@octane-xplat/cli": "workspace:*",
    "@octane-xplat/jsx": "workspace:*",
    "@octane-xplat/linux-gtk": "workspace:*",
    "@octane-xplat/ui": "workspace:*",
    "@octanejs/vite-plugin": "catalog:",
    "octane": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
