{
  "extends": ["//"],
  "tasks": {
    "test:runtime": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["LINUX_RUNTIME_EVAL_VM", "LINUX_RUNTIME_EVAL_ENGINE", "LINUX_RUNTIME_EVAL_EXECUTABLE", "LINUX_RUNTIME_EVAL_SLICE", "LINUX_RUNTIME_EVAL_MASON_DIR"]
    },
    "test:port": {
      "dependsOn": ["build:port"],
      "cache": false,
      "passThroughEnv": ["LINUX_RUNTIME_EVAL_VM", "LINUX_RUNTIME_EVAL_ENGINE", "LINUX_RUNTIME_EVAL_EXECUTABLE", "LINUX_RUNTIME_EVAL_SLICE", "LINUX_RUNTIME_EVAL_MASON_DIR"]
    },
    "build:port": {
      "dependsOn": ["^typegen"],
      "outputs": ["dist/port-native/**", "dist/port-gjs/**"],
      "cache": false
    },
    "dev:port": {
      "dependsOn": ["^typegen"],
      "cache": false,
      "persistent": true
    }
  }
}
