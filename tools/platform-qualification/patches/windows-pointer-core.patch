+type Handler = (sender: any, args: any) => void;
+type Subscription = { callback: Handler };
+type EventEntry = { subscribers: Set<Subscription>; detach: () => void };
+const nativeEvents = new WeakMap<object, Map<string, EventEntry>>();
+
+/** Share the bridge's replacement-only event property between independent owners. */
+export function subscribeNativeEvent(native: any, name: string, callback: Handler, routedEvent: any, wrap: (handler: Handler) => any): () => void {
+	let events = nativeEvents.get(native);
+	if (!events) {
+		events = new Map();
+		nativeEvents.set(native, events);
+	}
+	let entry = events.get(name);
+	if (!entry) {
+		const subscribers = new Set<Subscription>();
+		const delegate = wrap((sender, args) => {
+			// Removal during dispatch takes effect immediately; new subscribers wait for the next event.
+			for (const subscription of Array.from(subscribers)) {
+				if (subscribers.has(subscription)) subscription.callback(sender, args);
+			}
+		});
+		let detach: () => void;
+		try {
+			if (!routedEvent) throw new Error('RoutedEvent unavailable');
+			native.AddHandler(routedEvent, delegate, true);
+			detach = () => native.RemoveHandler(routedEvent, delegate);
+		} catch (error) {
+			// A bridge can fail after attaching. Remove that exact delegate before falling back.
+			if (routedEvent) {
+				try { native.RemoveHandler(routedEvent, delegate); } catch (_) { }
+			}
+			native[name] = delegate;
+			detach = () => { native[name] = null; };
+		}
+		entry = { subscribers, detach };
+		events.set(name, entry);
+	}
+	const subscription = { callback };
+	entry.subscribers.add(subscription);
+	let disposed = false;
+	return () => {
+		if (disposed) return;
+		disposed = true;
+		entry.subscribers.delete(subscription);
+		if (!entry.subscribers.size) {
+			try { entry.detach(); } finally {
+				events.delete(name);
+				if (!events.size) nativeEvents.delete(native);
+			}
+		}
+	};
+}
