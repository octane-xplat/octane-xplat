+ let reject = true; const native = { set PointerPressed(value) { if (reject) throw new Error('bad property'); this.handler = value; } };
+ assert.throws(() => subscribe(native, () => {})); reject = false; const dispose = subscribe(native, () => {}); assert.equal(typeof native.handler, 'function'); dispose();
+});
