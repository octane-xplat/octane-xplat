+        const ref = new WeakRef(this);
+        setTimeout(() => {
+            const owner = ref.deref();
+            if (!owner || generation !== owner._percentSizingGeneration)
+                return;
+            owner._percentSizingPending = false;
+            if (owner.isLoaded && owner._percentParent === owner.parent)
+                owner._applyPercentSizing();
