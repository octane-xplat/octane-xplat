{
  "name": "@xplat/platform-qualification",
  "private": true,
  "type": "module",
  "scripts": {
    "build:desktop-components": "node desktop-gestures/build-components.mjs",
    "qualify:macos-components": "node desktop-gestures/macos-host.mts",
    "build:windows-gestures": "node desktop-gestures/build-windows.mjs",
    "verify:windows-gestures": "node desktop-gestures/verify-windows.mts",
    "probe:prerender:build": "node native-prerender/run.mjs build",
    "probe:prerender:ios": "node native-prerender/run.mjs run",
    "probe:prerender:home:check": "node native-prerender/check-home.mjs",
    "probe:prerender:metadata": "node native-prerender/metadata.mjs",
    "typecheck": "tsc --runExternalCode --noEmit -p tsconfig.json && node --check native-prerender/run.mjs && node --check native-prerender/entry.js && node --check native-prerender/metadata.mjs && node --check native-prerender/check-home.mjs"
  },
  "devDependencies": {
    "@octane-xplat/nativescript-octane": "workspace:*",
    "@nativescript/core": "catalog:",
    "@octane-xplat/cli": "workspace:*",
    "@octane-xplat/jsx": "workspace:*",
    "@octane-xplat/linux-gtk": "workspace:*",
    "@octane-xplat/macos-appkit": "workspace:*",
    "@octane-xplat/motion": "workspace:*",
    "@octane-xplat/platform": "workspace:*",
    "@octane-xplat/ui": "workspace:*",
    "@tsrx/content-mapper": "catalog:",
    "@types/node": "26.6.6",
    "octane": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
