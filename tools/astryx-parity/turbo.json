{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		// Launches Chromium and previews both sides — observable side effects,
		// never cached.
		"parity": {
			"dependsOn": ["^typegen", "@octane-xplat/cli#build"],
			"cache": false
		},
		// Nonvisual Markdown comparison — DOM/parse metrics only, no capture.
		"parity:markdown": {
			"dependsOn": ["^typegen", "@octane-xplat/cli#build"],
			"cache": false
		}
	}
}
