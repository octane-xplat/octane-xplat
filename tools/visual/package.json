{
	"name": "@xplat/visual",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"test:mock": "vitest run mock.test",
		"update:mock": "vitest run mock.test --update",
		"verify:mock": "node scripts/verify-mock.ts",
		"test:web": "vitest run web.test",
		"update:web": "vitest run web.test --update",
		"verify:web": "node scripts/verify-web.ts",
		"capture:ios": "node scripts/capture-ios.ts",
		"test:parity": "node scripts/parity.ts",
		"test:comparator": "node --test scripts/parity.test.mjs scripts/geometry.test.mjs",
		"test:ios-regression": "VIS_ROOT=vis/ios vitest run ios-regression.test",
		"update:ios": "VIS_ROOT=vis/ios vitest run ios-regression.test --update",
		"promote:common": "node scripts/parity.ts --promote-common",
		"promote:common:retained": "node scripts/parity.ts --promote-common --retained"
	},
	"dependencies": {
		"@octane-xplat/ui": "workspace:*",
		"octane": "catalog:"
	},
	"devDependencies": {
		"@octane-xplat/jsx": "workspace:*",
		"@octanejs/vite-plugin": "catalog:",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"playwright": "1.63.0",
		"pngjs": "7.0.0",
		"storybook": "10.6.1",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-plugin-vis": "5.1.7"
	}
}
